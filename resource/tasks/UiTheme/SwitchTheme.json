{
    "SwitchTheme@ToggleSettingsMenu": {
        "action": "ClickSelf",
        "template": ["SwitchTheme@ToggleSettingsMenu.png", "SwitchTheme@ToggleSettingsMenu-v2.png"],
        "roi": [227, 327, 159, 152],
        "postDelay": 1000,
        "enabledIf": "auto_switch_theme",
        "next": ["SwitchTheme@ChangeTheme", "SwitchTheme@ToggleSettingsMenu"]
    },
    "SwitchTheme@ChangeTheme": {
        "action": "ClickSelf",
        "roi": [563, 566, 132, 132],
        "next": ["SwitchTheme@SelectLightTheme", "SwitchTheme@SwipeToLightTheme"]
    },
    "SwitchTheme@SelectLightTheme": {
        "action": "ClickSelf",
        "roi": [0, 99, 430, 180],
        "maxTimes": 10,
        "exceededNext": ["SwitchTheme@CancelThemeChange"],
        "next": ["SwitchTheme@AlreadySet", "SwitchTheme@ConfirmThemeChange", "SwitchTheme@SelectLightTheme"]
    },
    "SwitchTheme@AlreadySet": {
        "Doc": "已是日间则取消；须先于确认判定，灰色 ｢已设置｣ 会被确认模板命中",
        "baseTask": "SwitchThemeByNameAlreadySet",
        "next": ["SwitchTheme@CancelThemeChange"]
    },
    "SwitchTheme@SwipeToLightTheme": {
        "algorithm": "JustReturn",
        "action": "Swipe",
        "specificRect": [200, 170, 10, 10],
        "rectMove": [200, 600, 10, 10],
        "specialParams": [150],
        "postDelay": 500,
        "maxTimes": 10,
        "next": ["SwitchTheme@SelectLightTheme", "SwitchTheme@SwipeToLightTheme"]
    },
    "SwitchTheme@ConfirmThemeChange": {
        "action": "ClickSelf",
        "roi": [1070, 620, 200, 90],
        "postDelay": 2000,
        "next": ["SwitchTheme@ReturnTheme"]
    },
    "SwitchTheme@CancelThemeChange": {
        "action": "ClickSelf",
        "roi": [918, 645, 66, 38],
        "next": ["SwitchTheme@ReturnTheme"]
    },
    "SwitchTheme@ReturnTheme": {
        "Doc": "换完主题返回后就结束，不再重新换主题，避免无限循环",
        "baseTask": "ReturnButton",
        "template": ["Return.png", "Return-White.png"],
        "postDelay": 1000,
        "next": ["#self", "#next"],
        "onErrorNext": ["Stop"]
    }
}
