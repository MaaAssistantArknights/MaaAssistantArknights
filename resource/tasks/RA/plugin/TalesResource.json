            "Tales@RA@RIS-Navigation-AllThemes",
            "Tales@RA@RIS-Navigation-LongTermExploration",
            "Tales@RA@RIS-Navigation-FromMainInterface",
            "Tales@RA@RIS-Navigation@ReturnButtons#next",
            "Tales@RA@RIS-Navigation@StartUpThemes#next"
