    "Tales@RA@RIS-EventNames": {
        "algorithm": "OcrDetect",
        "text": ["狩闻匣", "信使邮筒", "别塔卜-阿帕卡里之疑", "乌胡米什的低语", "漫过布卢塔巴图", "向那穆图巴辛眺望"],
