    "DrowningSeekers@RoguelikeRoutingNodeNameOcr": {
        "doc": "识别节点铭牌文字，供 RoguelikeMapConfig::text2type 映射到节点类型",
        "algorithm": "OcrDetect",
        "text": [],
        "roi": [0, 90, 1280, 540],
        "ocrReplace": [
            ["未矢[口]?的", "未知的"],
            ["诡[祕秘]", "诡秘"],
            ["[凶兇][戾唳]", "凶戾"],
