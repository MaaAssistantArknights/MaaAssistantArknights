            ["羽[瞰瞅]点", "羽瞰点"],
            ["险路[小尐]径", "险路小径"]
        ]
    },
    "DrowningSeekers@RoguelikeRoutingConfig": {
        "algorithm": "JustReturn",
        "doc": [
            "RoguelikeDrowningSeekersRoutingTaskPlugin/Analyzer 用参数（1280x720，scale=1.0）",
            "边/节点/玩家判定由 ONNX 模型完成，无需阈值。",
            "| specialParams[0]: 网格步长（BASE_GRID_STEP，101）",
            "| specialParams[1]: 铭牌相对节点中心的纵向偏移（下方，约16）",
            "| specialParams[2]: 行动力放弃阈值（<= 此值直接放弃，默认1）",
            "| specialParams[3]: dry_run（1=仅识别并安全退出，用于人工核对识别；0=正常导航）"
        ],
        "specialParams": [101, 16, 1, 0]
    },
