{
    "MiniGame@AutoRaisePotential@Begin": {
        "doc": "自动提升潜能入口。用户须已进入干员列表界面；复用 OperBox 的现有模板确认页面，然后 OCR 读取筛选结果数量。",
        "algorithm": "JustReturn",
        "next": [
            "MiniGame@AutoRaisePotential@OperatorCountZero",
            "MiniGame@AutoRaisePotential@OperatorCountOcr",
            "MiniGame@AutoRaisePotential@FinishNoTarget"
        ]
    },
    "MiniGame@AutoRaisePotential@OperatorCountZero": {
        "doc": "识别顶部潜能标记数量为 0 时直接结束，保持在干员列表。",
        "baseTask": "NumberOcrReplace",
        "action": "Stop",
        "roi": [643, 28, 37, 27],
        "fullMatch": true,
        "useRaw": false,
        "binThreshold": [180, 255],
        "withoutDet": true,
        "text": ["0"]
    },
    "MiniGame@AutoRaisePotential@OperatorCountOcr": {
        "doc": "识别干员列表顶部橙色潜能标记中的数量。Core 插件读取 OCR 结果并设置横向切换次数。",
        "baseTask": "NumberOcrReplace",
        "action": "DoNothing",
        "roi": [643, 28, 37, 27],
        "binThreshold": [180, 255],
        "useRaw": false,
        "withoutDet": true,
        "next": ["MiniGame@AutoRaisePotential@FilterAvailable"]
    },
    "MiniGame@AutoRaisePotential@FinishNoTarget": {
        "doc": "未识别到顶部潜能数量，视为没有可提升目标并停留在干员列表。",
        "algorithm": "JustReturn",
        "action": "Stop"
    },
    "MiniGame@AutoRaisePotential@FilterAvailable": {
        "template": "OperBoxBadgeTop.png",
        "action": "ClickSelf",
        "roi": [542, 12, 195, 58],
        "postDelay": 1000,
        "next": ["MiniGame@AutoRaisePotential@FirstOperator"]
    },
    "MiniGame@AutoRaisePotential@FirstOperator": {
        "template": "OperBoxFirstOperatorBadge.png",
        "action": "ClickRect",
        "maskRange": [1, 255],
        "specificRect": [52, 145, 87, 177],
        "roi": [108, 68, 113, 43],
        "postDelay": 1000,
        "next": ["MiniGame@AutoRaisePotential@OperatorProfile"]
    },
    "MiniGame@AutoRaisePotential@PotentialAvailable": {
        "doc": "识别并点击干员档案中的潜能提升标记",
        "template": "OperInfoPotentialAvailable.png",
        "action": "ClickRect",
        "roi": [1125, 180, 155, 180],
        "maskRange": [1, 255],
        "specificRect": [1100, 257, 126, 38],
        "postDelay": 1000,
        "next": ["MiniGame@AutoRaisePotential@PotentialScreen"]
    },    
    "MiniGame@AutoRaisePotential@PotentialScreen": {
        "doc": "等待潜能提升确认弹窗出现。",
        "template": "RaisePotentialConfirm.png",
        "roi": [987, 584, 243, 133],
        "action": "DoNothing",
        "next": ["MiniGame@AutoRaisePotential@ConfirmRaise"]
    },
    "MiniGame@AutoRaisePotential@ConfirmRaise": {
        "doc": "点击确定完成本次潜能提升，回到干员档案后继续检查。",
        "template": "RaisePotentialConfirm.png",
        "action": "ClickSelf",
        "roi": [987, 584, 243, 133],
        "postDelay": 1000,
        "next": ["MiniGame@AutoRaisePotential@OperatorProfile"]
    },
    "MiniGame@AutoRaisePotential@OperatorProfile": {
        "doc": "识别已经回到干员档案；优先检查当前干员的潜能标记，未发现时横向切换下一名。",
        "baseTask": "OperOpenInformationMenu",
        "template": "OperInformationMenu.png",
        "action": "DoNothing",
        "next": [
            "MiniGame@AutoRaisePotential@PotentialAvailable",
            "MiniGame@AutoRaisePotential@SwipeToNextOperator"
        ]
    },
    "MiniGame@AutoRaisePotential@SwipeToNextOperator": {
        "doc": "在干员档案中横向切换下一名干员，回到档案检查后继续提升或切换。滑动次数由顶部 OCR 数量动态设置；这是流程中唯一的固定点位动作。",
        "algorithm": "JustReturn",
        "action": "Swipe",
        "specificRect": [735, 580, 1, 1],
        "rectMove": [545, 580, 1, 1],
        "specialParams": [300, 0, 1, 0],
        "postDelay": 1600,
        "next": ["MiniGame@AutoRaisePotential@OperatorProfile"]
    }
}
