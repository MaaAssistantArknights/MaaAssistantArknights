{
    "OperatorDevelopment@TemplateChecklist": {
        "doc": [
            "以下识别任务仅为 1280x720 国服截图占位，截图补齐并实机验证前不得视为可运行流程。",
            "待采集：干员列表与职业筛选、干员姓名、末页、档案页、精英阶段、等级、技能等级、专精徽记。",
            "待采集：升级/晋升按钮、红色材料槽、材料详情跳转、训练室状态/选择、导师技能与心情。",
            "待采集：双芯片制造、芯片组、芯片助剂库存、采购数量、原产线产品及生产数量恢复状态。"
        ],
        "algorithm": "JustReturn",
        "action": "DoNothing"
    },
    "OperatorDevelopment@ManualRecognition": {
        "doc": "人工截图占位。特殊文本保证截图缺失时识别失败，不以固定坐标绕过。",
        "algorithm": "OcrDetect",
        "text": ["__OPERATOR_DEVELOPMENT_TEMPLATE_REQUIRED__"],
        "roi": [0, 0, 1280, 720],
        "action": "DoNothing"
    },
