{
    "tabWidth": 4,
    "printWidth": 120,
    "useTabs": false,
    "bracketSameLine": true,
    "bracketSpacing": true,
    "endOfLine": "auto",
    "overrides": [
        {
            "files": [".clang-format", "**/*.yml", "**/*.yaml"],
            "options": {
                "parser": "yaml",
                "tabWidth": 2
            }
        },
        {
            "files": ["**/*.{md,markdown,mdown,mkdn,mkd}"],
            "options": {
                "printWidth": 120,
                "tabWidth": 2,
                "useTabs": false,
                "proseWrap": "preserve",
                "endOfLine": "auto",
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
