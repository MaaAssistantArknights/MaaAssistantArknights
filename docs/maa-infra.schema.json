{
    "$schema": "http://json-schema.org/draft-07/schema",
    "title": "Maa Copilot Infrastructure",
    "type": "object",
    "properties": {
        "title": {
            "type": "string",
            "description": "The title of the Maa Copilot Infrastructure Plan"
        },
        "description": {
            "type": "string",
            "description": "The description of the Maa Copilot Infrastructure Plan"
        },
        "plans": {
            "type": "array",
            "description": "Plans list.",
            "items": {
                "$ref": "#/definitions/plans"
            }
        }
    },
    "required": ["plans"],
    "definitions": {
        "operator": {
            "type": "string",
            "description": "Operator name in corresponding languages since MAA uses OCR to detect operator."
        },
        "plans": {
            "type": "object",
            "description": "Plans for the infrastructure.",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the plan."
                },
                "description": {
                    "type": "string",
                    "description": "Description of the plan."
                },
                "period": {
                    "type": "array",
                    "description": "Period list.",
                    "items": {
                        "$ref": "#/definitions/planPeriod"
                    }
                },
                "duration": {
                    "type": "number",
                    "description": "Duration of the plan. Reserved."
                },
                "Fiammetta": {
                    "type": "object",
                    "$ref": "#/definitions/Fiammetta"
                },
                "drones": {
                    "type": "object",
                    "$ref": "#/definitions/drones"
                },
                "rooms": {
                    "type": "object",
                    "$ref": "#/definitions/rooms"
                }
            },
            "required": ["rooms"]
        },
        "planPeriod": {
            "type": "array",
            "description": "Period of the plan.",
            "items": {
                "$ref": "#/definitions/planPeriodTimeFormat"
            },
            "minItems": 2,
            "maxItems": 2
        },
        "planPeriodTimeFormat": {
            "type": "string",
            "description": "Time notation in HH:MM format (24 hours format). For the next day, see MAA docs.",
            "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "Fiammetta": {
            "type": "object",
            "description": "Fiammetta configuration.",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "description": "Enable Fiammetta."
                },
                "target": {
                    "$ref": "#/definitions/operator"
                },
                "order": {
                    "type": "string",
                    "description": "Order of the Fiammetta.",
                    "anyOf": [
                        {
                            "const": "pre",
                            "description": "Before executing infrastructure plan."
                        },
                        {
                            "const": "post",
                            "description": "After executing infrastructure plan."
                        }
                    ]
                }
            },
            "required": ["enable", "target", "order"]
        },
        "drones": {
            "type": "object",
            "description": "Drones configuration.",
            "properties": {
                "enable": {
                    "type": "boolean",
                    "description": "Enable drones."
                },
                "room": {
                    "type": "string",
                    "description": "Target drons's usage.",
                    "anyOf": [
                        {
                            "const": "trading",
                            "description": "Use drones in trading"
                        },
                        {
                            "const": "manufacture",
                            "description": "Use drones in manufacture"
                        }
                    ]
                },
                "index": {
                    "type": "integer",
                    "description": "Index of the infrastructure room.",
                    "minimum": 0,
                    "maximum": 9
                },
                "rule": {
                    "type": "string",
                    "description": "The usage of drones."
                },
                "order": {
                    "type": "string",
                    "description": "Order of the Drones.",
                    "anyOf": [
                        {
                            "const": "pre",
                            "description": "Before executing infrastructure plan."
                        },
                        {
                            "const": "post",
                            "description": "After executing infrastructure plan."
                        }
                    ]
                }
            }
        },
        "rooms": {
            "type": "object",
            "description": "All arknights infrastructure rooms. Missing facility keys use the default algorithm for shift change; if a facility array holds fewer room entries than actual rooms, shift change stops from the first unconfigured room onward for that facility; a room entry written without any staffing intent (operators/candidates empty or missing, no autofill or operator groups) keeps that room unchanged; the skip field likewise only skips operator replacement for that room, while facility-level actions such as the meeting room's clue flow and the training room's continue training are unaffected.",
            "properties": {
                "control": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 1
                },
                "meeting": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 1
                },
                "hire": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 1
                },
                "training": {
                    "type": "array",
                    "description": "Training rooms. operatorsA are trainee-slot candidates: the first one present in the in-game selection list is staffed, subject to the trainee slot's eligibility restriction (elite 2 with at least one skill below max mastery; all-maxed operators never appear in the list, so configuring them is effectively a skip), and while training is in progress the trainee slot stays locked so only the assistant is changed. operatorsB are assistant candidates with no such restriction, so any operator can be staffed there. Among the generic roomConfig fields only skip takes effect; staffing is configured solely via operatorsA/operatorsB. Continue training is a standalone GUI option outside the schedule file and is unaffected by the three room states (empty array / skip / empty staffing intent); it still runs in all of them and only operator replacement is skipped. When continue training is enabled, the shift-change flow first tries to continue the current operator's mastery training; on success the trainee slot stays unchanged and only the assistant is replaced per configuration, otherwise (materials insufficient or mastery already maxed) it falls back to replacing the trainee slot operator per configuration.",
                    "items": {
                        "$ref": "#/definitions/abRoomConfig"
                    },
                    "maxItems": 1
                },
                "recycle": {
                    "type": "array",
                    "description": "Recycle station rooms with two undifferentiated staffing slots, configured like manufacture via the operators array; the product field has no effect here.",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 1
                },
                "manufacture": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 9
                },
                "trading": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 9
                },
                "power": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 9
                },
                "dormitory": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/roomConfig"
                    },
                    "maxItems": 4
                }
            }
        },
        "abRoomConfig": {
            "type": "object",
            "description": "Room with A/B operator groups, used by the training facility: operatorsA are trainee-slot candidates and operatorsB are assistant candidates. Among the inherited roomConfig fields only skip takes effect.",
            "allOf": [
                {
                    "$ref": "#/definitions/roomConfig"
                }
            ],
            "properties": {
                "operatorsA": {
                    "type": "array",
                    "description": "Trainee-slot candidates for the training facility; the first one present in the in-game selection list is staffed. Staffing is subject to the trainee slot's eligibility restriction: the operator must be promoted to elite 2 with at least one skill below max mastery; operators with all masteries maxed never appear in the list, so configuring them is effectively a skip. While training is in progress the trainee slot is locked and cannot be changed. Staffing alone does not start a new training session; starting mastery training still requires a manual tap. Optional; omitted means the trainee slot operator is not changed.",
                    "items": {
                        "$ref": "#/definitions/operator"
                    }
                },
                "operatorsB": {
                    "type": "array",
                    "description": "Assistant-slot candidates for the training facility; the assistant slot has no eligibility restriction like the trainee slot, so any operator can be staffed there. This also covers skills of operators working in other facilities that need an operator of the same faction staffed in the base for higher efficiency (put one matching-faction operator in operatorsB). Optional; omitted means no assistant is selected.",
                    "items": {
                        "$ref": "#/definitions/operator"
                    }
                }
            }
        },
        "roomConfig": {
            "type": "object",
            "description": "Room configuration.",
            "properties": {
                "operators": {
                    "type": "array",
                    "description": "Operators list.",
                    "items": {
                        "$ref": "#/definitions/operator"
                    },
                    "maxItems": 5
                },
                "use_operator_groups": {
                    "type": "boolean",
                    "description": "Interpret names in operators as operator group names. Optional."
                },
                "sort": {
                    "type": "boolean",
                    "description": "Sort operators in the same order as listed in operators."
                },
                "skip": {
                    "type": "boolean",
                    "description": "Skip operator replacement for this room or not; facility-level actions such as the meeting room's clue flow are unaffected."
                },
                "autofill": {
                    "type": "boolean",
                    "description": "Autofill with default algorithm this room or not."
                },
                "product": {
                    "type": "string",
                    "description": "Product name of this manufacture station",
                    "anyOf": [
                        {
                            "const": "Battle Record",
                            "description": "Battle Record"
                        },
                        {
                            "const": "Pure Gold",
                            "description": "Pure Gold"
                        },
                        {
                            "const": "Dualchip",
                            "description": "Dualchip"
                        },
                        {
                            "const": "Originium Shard",
                            "description": "Originium Shard"
                        },
                        {
                            "const": "LMD",
                            "description": "Lungmen dollar"
                        },
                        {
                            "const": "Orundum",
                            "description": "Orundum"
                        }
                    ]
                },
                "candidates": {
                    "type": "array",
                    "description": "Backup operator candidates; operators currently working in other facilities are never selected (excluded at selection time).",
                    "items": {
                        "$ref": "#/definitions/operator"
                    }
                }
            }
        }
    }
}
