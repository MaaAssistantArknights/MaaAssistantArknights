{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MaaCore resource/version.json",
    "description": "Current activity and gacha information. Not read by MaaCore; used by clients and tools.",
    "type": "object",
    "additionalProperties": false,
    "required": ["activity", "gacha", "last_updated"],
    "properties": {
        "activity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "time"],
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Activity name."
                },
                "time": {
                    "type": "integer",
                    "description": "Activity end time as a Unix timestamp."
                }
            }
        },
        "gacha": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pool", "time"],
            "properties": {
                "pool": {
                    "type": "string",
                    "description": "Gacha pool name."
                },
                "time": {
                    "type": "integer",
                    "description": "Gacha pool end time as a Unix timestamp."
                }
            }
        },
        "last_updated": {
            "type": "string",
            "description": "Update time, formatted as `%Y-%m-%d %H:%M:%S.000` in UTC+8.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
        }
    }
}
