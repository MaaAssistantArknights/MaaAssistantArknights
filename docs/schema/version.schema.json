{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MaaCore resource/version.json",
    "description": "Current activity and gacha information. Not read by MaaCore; used by clients and tools.",
    "type": "object",
    "additionalProperties": false,
    "required": ["activity", "gacha", "last_updated"],
    "properties": {
        "activity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "time"],
            "properties": {
                "name": { "type": "string", "description": "Activity name." },
                "time": {
                    "type": "integer",
                    "description": "Activity start time as a Unix timestamp (the newest activity whose `startTime` has passed)."
                }
            }
        },
        "gacha": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pool", "time"],
            "properties": {
                "pool": { "type": "string", "description": "Gacha pool name." },
                "time": {
                    "type": "integer",
                    "description": "Gacha pool open time as a Unix timestamp (the newest pool whose `openTime` has passed)."
                }
            }
        },
        "last_updated": {
            "type": "string",
            "description": "Update time in UTC, formatted as `%Y-%m-%d %H:%M:%S.000` (no timezone suffix; parsers assume universal time).",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"
        }
    }
}
