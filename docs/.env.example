# MAA 文档 AI 翻译配置
# 复制此文件为 .env 并填入你的 API 密钥

# OpenAI 兼容 API 配置
# 支持：OpenAI、Azure OpenAI、Moonshot、DeepSeek、SiliconFlow、智谱等
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：自定义模型参数
# OPENAI_TEMPERATURE=0.3
# OPENAI_MAX_TOKENS=4096

# 源语言（默认中文）
SOURCE_LANG=zh-cn

# 目标语言（逗号分隔，可选：en-us, zh-tw, ja-jp, ko-kr）
TARGET_LANGS=en-us,zh-tw,ja-jp,ko-kr

# 翻译并发数（避免 API 限流）
CONCURRENCY=3

# 是否启用术语表
USE_GLOSSARY=true