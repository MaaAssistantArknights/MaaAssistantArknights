<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MaaAssemblyPath Condition="'$(MaaAssemblyPath)' == ''">../../build/bin/Debug/MAA.dll</MaaAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MAA">
      <HintPath>$(MaaAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../build/bin/Debug/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
