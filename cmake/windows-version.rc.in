#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @maa_file_version@
PRODUCTVERSION @maa_file_version@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE @file_type@
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MAA Team"
            VALUE "FileDescription", "@maa_file_description@"
            VALUE "FileVersion", "@maa_file_version_string@"
            VALUE "InternalName", "@original_filename@"
            VALUE "LegalCopyright", "Copyright (c) 2021-@maa_copyright_year@ MAA Team"
            VALUE "OriginalFilename", "@original_filename@"
            VALUE "ProductName", "MAA"
            VALUE "ProductVersion", "@maa_product_version@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
