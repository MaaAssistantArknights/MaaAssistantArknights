<UserControl
    x:Class="MaaWpfGui.Styles.Controls.NailongMascot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    Width="144"
    Height="140"
    Focusable="False"
    IsTabStop="False"
    ToolTip="{DynamicResource Skin.Nailong.Credit}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="CaptionVisibilityConverter" />
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid
            Width="160"
            Height="156"
            Background="Transparent">
            <Ellipse
                Width="116"
                Height="104"
                Margin="0,31,0,0"
                VerticalAlignment="Top"
                Fill="{DynamicResource Skin.HighlightBrush}"
                Opacity="0.6" />
            <Ellipse
                Width="92"
                Height="12"
                Margin="0,0,0,13"
                VerticalAlignment="Bottom"
                Fill="{DynamicResource Skin.BorderBrush}"
                Opacity="0.4" />
            <Grid
                Width="112"
                Height="122"
                Margin="0,18,0,0"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image
                    x:Name="StillImage"
                    Source="/MAA;component/Res/Skins/Assets/NaiwaLaugh.gif"
                    Stretch="Uniform" />
                <Border x:Name="AnimationHost" />
            </Grid>
            <Border
                Margin="1,7,0,0"
                Padding="8,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource Skin.AccentBrush}"
                BorderBrush="{DynamicResource Skin.InkBrush}"
                BorderThickness="1.5"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                Visibility="{Binding ShowCaptions, RelativeSource={RelativeSource AncestorType=controls:NailongMascot}, Converter={StaticResource CaptionVisibilityConverter}}">
                <Border.RenderTransform>
                    <RotateTransform Angle="-12" />
                </Border.RenderTransform>
                <controls:TextBlock
                    FontSize="15"
                    FontWeight="Black"
                    Foreground="{DynamicResource Skin.CardBrush}"
                    Text="{DynamicResource Skin.Nailong.Laugh}" />
            </Border>
            <Border
                Margin="0,0,0,2"
                Padding="7,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource Skin.CardBrush}"
                BorderBrush="{DynamicResource Skin.BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                RenderTransformOrigin="0.5,0.5"
                Visibility="{Binding ShowCaptions, RelativeSource={RelativeSource AncestorType=controls:NailongMascot}, Converter={StaticResource CaptionVisibilityConverter}}">
                <Border.RenderTransform>
                    <RotateTransform Angle="7" />
                </Border.RenderTransform>
                <controls:TextBlock
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Skin.InkBrush}"
                    Text="{DynamicResource Skin.Nailong.Sanity}" />
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
