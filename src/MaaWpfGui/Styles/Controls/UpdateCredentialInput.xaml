<UserControl
    x:Class="MaaWpfGui.Styles.Controls.UpdateCredentialInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:enums="clr-namespace:MaaWpfGui.Constants.Enums"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:uiBehaviors="clr-namespace:MaaWpfGui.Extensions.UIBehaviors"
    s:View.ActionTarget="{Binding}">
    <StackPanel>
        <controls:TextBlock Margin="8,0,0,5" HorizontalAlignment="Left">
            <controls:TextBlock.Style>
                <Style BasedOn="{StaticResource MaaTextBlockDefaultStyle}" TargetType="{x:Type controls:TextBlock}">
                    <Setter Property="Text" Value="{DynamicResource Settings.Update.GitHub.Token}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UpdateSource}" Value="{x:Static enums:UpdateSource.MirrorChyan}">
                            <Setter Property="Text" Value="{DynamicResource Settings.Update.MirrorChyan.Cdk}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:TextBlock.Style>
        </controls:TextBlock>
        <StackPanel s:View.ActionTarget="{Binding}" DataContext="{Binding CurrentUpdateCredential}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:PasswordBox
                    hc:BorderElement.CornerRadius="4,0,0,4"
                    InputMethod.IsInputMethodEnabled="False"
                    IsSafeEnabled="False"
                    ShowEyeButton="True"
                    UnsafePassword="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    hc:BorderElement.CornerRadius="0,4,4,0"
                    BorderThickness="0,1,1,1"
                    Command="{s:Action Copy}"
                    Content="{DynamicResource Common.Copy}" />
            </Grid>
            <controls:TextBlock
                Margin="0,5,0,0"
                uiBehaviors:ResourceReferenceHelper.ForegroundResourceKey="{Binding StatusBrush}"
                Text="{Binding StatusText}"
                TextWrapping="Wrap"
                ToolTip="{Binding ExpiresLocalTime}"
                Visibility="{c:Binding 'StatusText != &quot;&quot;'}" />
        </StackPanel>
        <controls:TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
            <Hyperlink Cursor="Hand" TextDecorations="None">
                <Hyperlink.Style>
                    <Style BasedOn="{StaticResource {x:Type Hyperlink}}" TargetType="{x:Type Hyperlink}">
                        <Setter Property="NavigateUri" Value="{Binding Source={x:Static constants:MaaUrls.GitHubTokenSettings}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateSource}" Value="{x:Static enums:UpdateSource.MirrorChyan}">
                                <Setter Property="NavigateUri" Value="{Binding Source={x:Static constants:MaaUrls.MirrorChyanWebsite}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Hyperlink.Style>
                <TextBlock>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource HyperlinkTextBlockStyle}" TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="{DynamicResource Settings.Update.GitHub.Token.Generate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateSource}" Value="{x:Static enums:UpdateSource.MirrorChyan}">
                                    <Setter Property="Text" Value="{DynamicResource Settings.Update.Source.MirrorChyan}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Hyperlink>
        </controls:TextBlock>
    </StackPanel>
</UserControl>
