    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7A6748" />
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="#9949371F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DFCA8E" />
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#DFCA8E" />
    <SolidColorBrush x:Key="MouseOverRegionBrush" Color="#FFF0BA" />
    <SolidColorBrush x:Key="HyperlinkBrush" Color="#486825" />
