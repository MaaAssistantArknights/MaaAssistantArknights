<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls">

    <!--
        日志条目模板（信息流 / 自动战斗共用）。
        DataContext 为 MaaWpfGui.ViewModels.Items.LogItemViewModel。
        视图中引用时需在容器上绑定 ToolTip 与 ToolTipService.InitialShowDelay，
        与 TaskQueueView / CopilotView 原有写法一致。
        LogToolTip 用 DynamicResource：模板定义在共享资源字典里，跨字典取 Geometries.xaml
        的 StaticResource 在模板实例化时解析不到（视图内定义的模板不受影响）。
    -->
    <DataTemplate x:Key="PlainLogItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  时间  -->
            <controls:TextBlock
                Grid.Column="0"
                Margin="0,5,10,5"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TraceLogBrush}"
                Text="{Binding Time}"
                Visibility="{c:Binding ShowTime}" />

            <!--  内容  -->
            <Grid
                Grid.Column="1"
                Margin="0,5"
                HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:TextBlock
                    FontWeight="{Binding Weight}"
                    ForegroundKey="{Binding Color}"
                    Text="{Binding DisplayContent}"
                    TextWrapping="Wrap" />
                <controls:TooltipBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    PathDate="{DynamicResource LogToolTip}"
                    PathStrokeThickness="1.5"
                    TextBlockText=""
                    Visibility="{c:Binding ShowToolTip}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!--
        卡片样式日志（信息流 / 自动战斗共用）。
        DataContext 为 MaaWpfGui.ViewModels.Items.LogCardItemViewModel。
        LogSectionDivider 需在窗口隐藏（最小化托盘）期间动态添加，
        故不用 hc:Divider，详见 LogSectionDivider 头注释。
    -->
    <DataTemplate x:Key="LogCardItemTemplate">
        <Grid>
            <controls:LogSectionDivider
                MaxWidth="420"
                Margin="0,0,0,2.5"
                Header="{Binding Header}"
                HeaderHorizontalAlignment="Center"
                Visibility="{c:Binding IsDivider}" />
            <Border
                MaxWidth="420"
                Margin="0,0,0,2.5"
                Padding="2.5,0,1,5"
                Background="{DynamicResource MouseOverRegionBrushOpacity10}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{c:Binding '!IsDivider and Items.Count > 0'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="60"
                        Margin="0,5,0,0"
                        VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TraceLogBrush}"
                            Text="{Binding StartTime}"
                            TextWrapping="Wrap" />
                        <Image
                            Grid.Row="1"
                            Width="60"
                            Source="{Binding Thumbnail}"
                            Stretch="UniformToFill"
                            ToolTipService.InitialShowDelay="200"
                            Visibility="{c:Binding ShowThumbnail}">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Image Source="{Binding Thumbnail}" />
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                        <TextBlock
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource TraceLogBrush}"
                            Text="{Binding EndTime}"
                            TextWrapping="Wrap"
                            Visibility="{c:Binding 'StartTime != EndTime or Items.Count > 1'}" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Left"
                                        ToolTip="{Binding ToolTip}"
                                        ToolTipService.InitialShowDelay="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:TextBlock
                                            FontWeight="{Binding Weight}"
                                            ForegroundKey="{Binding Color}"
                                            Text="{Binding DisplayContent}"
                                            TextWrapping="Wrap" />
                                        <controls:TooltipBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            PathDate="{DynamicResource LogToolTip}"
                                            PathStrokeThickness="1.5"
                                            TextBlockText=""
                                            Visibility="{c:Binding ShowToolTip}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
