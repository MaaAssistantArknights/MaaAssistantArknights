<UserControl
    x:Class="MaaWpfGui.Views.UserControl.GuideUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:enums="clr-namespace:MaaWpfGui.Constants.Enums"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:uiBehaviors="clr-namespace:MaaWpfGui.Extensions.UIBehaviors"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance ui_vms:SettingsViewModel}"
    mc:Ignorable="d">
    <Grid>
        <GroupBox
            Margin="10"
            Background="{DynamicResource RegionBrush}"
            Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <hc:RelativePanel Height="20">
                    <Button
                        Margin="5,0"
                        hc:RelativePanel.AlignVerticalCenterWithPanel="True"
                        Command="{s:Action DoneGuide}"
                        Content="{DynamicResource Guide.Skip}"
                        Style="{StaticResource ButtonDashedWarning.Small}"
                        Visibility="{c:Binding GuideSkipVisible}" />
                    <TextBlock
                        hc:RelativePanel.AlignHorizontalCenterWithPanel="True"
                        hc:RelativePanel.AlignVerticalCenterWithPanel="True"
                        FontSize="14"
                        Text="{DynamicResource Guide.Settings}" />
                </hc:RelativePanel>
            </GroupBox.Header>
            <DockPanel>
                <Grid VerticalAlignment="Stretch" DockPanel.Dock="Right">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        x:Name="GuideButtonPanel"
                        Grid.Row="1"
                        Margin="10,0"
                        VerticalAlignment="Center">
                        <Button
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource UpGeometry}"
                            hc:IconElement.Width="18"
                            Command="{s:Action PrevGuide}"
                            CommandParameter="{Binding ElementName=GuideStepBar}"
                            Content="{DynamicResource Guide.Prev}"
                            Style="{StaticResource ButtonDashedPrimary}" />
                        <hc:StepBar
                            Name="GuideStepBar"
                            Margin="10,0"
                            d:StepIndex="7"
                            Dock="Right"
                            StepIndex="{Binding GuideStepIndex}">
                            <hc:StepBarItem Content="{DynamicResource Settings.Ui.Title}" />
                            <hc:StepBarItem Content="{DynamicResource Guide.User}" />
                            <hc:StepBarItem Content="{DynamicResource Settings.Game.Title}" />
                            <hc:StepBarItem Content="{DynamicResource Settings.Connection.Title}" />
                            <hc:StepBarItem Content="{DynamicResource TaskQueue.TaskSettings}" />
                            <hc:StepBarItem Content="{DynamicResource Settings.Performance.Title}" />
                            <hc:StepBarItem Content="{DynamicResource Settings.Update.Title}" />
                        </hc:StepBar>
                        <Button
                            MinWidth="100"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource DownGeometry}"
                            hc:IconElement.Width="18"
                            Command="{s:Action NextGuide}"
                            CommandParameter="{Binding ElementName=GuideStepBar}"
                            Content="{DynamicResource Guide.Next}"
                            IsEnabled="{c:Binding 'GuideNextGateTip == null'}"
                            Style="{StaticResource ButtonDashedPrimary}"
                            Visibility="{c:Binding 'GuideStepIndex less GuideMaxStep - 1'}" />
                        <Button
                            MinWidth="100"
                            hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                            hc:IconElement.Width="18"
                            Command="{s:Action DoneGuide}"
                            Content="{DynamicResource Guide.Done}"
                            Style="{StaticResource ButtonDashedPrimary}"
                            Visibility="{c:Binding 'GuideStepIndex >= GuideMaxStep - 1'}" />
                    </StackPanel>
                    <controls:TextBlock
                        Grid.Row="2"
                        MaxWidth="{Binding ElementName=GuideButtonPanel, Path=ActualWidth}"
                        d:Text="Next gate tip"
                        FontSize="12"
                        Text="{Binding GuideNextGateTip}"
                        TextWrapping="Wrap"
                        Visibility="{c:Binding 'GuideNextGateTip != null'}" />
                </Grid>
                <ScrollViewer Margin="10,20,10,20" VerticalScrollBarVisibility="Auto">
                    <hc:SimplePanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:TransitioningContentControl
                            Width="200"
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex less= 0'}">
                            <hc:UniformSpacingPanel
                                DataContext="{Binding GuiSettings}"
                                Orientation="Vertical"
                                Spacing="20">
                                <ComboBox
                                    hc:InfoElement.Title="{Binding LanguageInfo}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding LanguageList}"
                                    SelectedValue="{Binding Language}"
                                    SelectedValuePath="Value" />
                                <ComboBox
                                    hc:InfoElement.Title="{DynamicResource Settings.Theme}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding DarkModeList}"
                                    SelectedValue="{Binding DarkMode}"
                                    SelectedValuePath="Value" />
                            </hc:UniformSpacingPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 2'}">
                            <StackPanel DataContext="{Binding GameSettings}">
                                <ComboBox
                                    Width="200"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:InfoElement.Title="{DynamicResource Settings.Game.ClientType}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding ClientTypeList}"
                                    SelectedValue="{Binding ClientType}"
                                    SelectedValuePath="Value" />
                                <!--<CheckBox
                                    Margin="10"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding DeploymentWithPause}">
                                    <controls:TextBlock
                                        Block.TextAlignment="Center"
                                        Text="{DynamicResource Settings.Game.DeploymentWithPause}"
                                        TextWrapping="Wrap" />
                                </CheckBox>-->
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 3'}">
                            <StackPanel s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}" DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                                <controls:TextBlock
                                    MaxWidth="400"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Block.TextAlignment="Left"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="{DynamicResource Guide.Clarification}"
                                    TextWrapping="Wrap"
                                    Visibility="{c:Binding !IsPCConnectConfig}" />

                                <settings:ConnectSettingsUserControl ShowAdvancedConnectSettings="False" />
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            Width="480"
                            Height="430"
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 4'}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="210"
                                    Margin="0,0,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <controls:TextBlock
                                        FontSize="14"
                                        Text="{DynamicResource Guide.HoverActionButtons}"
                                        TextWrapping="Wrap" />
                                    <controls:TextBlock
                                        Grid.Row="1"
                                        FontSize="14"
                                        Text="{DynamicResource Guide.GearContextMenu.Tip}"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!--  演示任务面板：列表与互动操作均为演示数据，与真实任务队列无关  -->
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="210"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl
                                            Grid.Row="0"
                                            Width="190"
                                            MinHeight="140"
                                            Margin="0,10,0,8"
                                            HorizontalAlignment="Center"
                                            dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                                            dd:DragDrop.IsDragSource="True"
                                            dd:DragDrop.IsDropTarget="True"
                                            ItemsSource="{Binding GuideDemoTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        x:Name="GuideDemoItemBorder"
                                                        MinHeight="24.5"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  Column 0: CheckBox 拉伸填充可点击区域，名称与引导红点由叠加层展示（照真实任务项结构）  -->
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                MaxWidth="140"
                                                                Margin="4.5,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                IsChecked="{Binding IsChecked}">
                                                                <controls:TextBlock Text="{Binding Name}" Visibility="Hidden" />
                                                            </CheckBox>
                                                            <StackPanel
                                                                Grid.Column="0"
                                                                Margin="26,0,4,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                IsHitTestVisible="False"
                                                                Orientation="Horizontal">
                                                                <controls:TextBlock Text="{Binding Name}" />
                                                                <Ellipse
                                                                    Width="7"
                                                                    Height="7"
                                                                    Margin="4,-3,0,0"
                                                                    VerticalAlignment="Top"
                                                                    Fill="{DynamicResource NewBadgeBrush}"
                                                                    Visibility="{c:Binding IsGateBadgeVisible}" />
                                                            </StackPanel>

                                                            <!--  Column 1: 悬浮显示的 复制/重命名/删除 与常驻齿轮（右键菜单），交互均落在演示列表  -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GuideDemoItemBorder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource CopyTaskGeometry}"
                                                                        Command="{s:Action CopyGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="False"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Common.Copy}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource RenameTaskGeometry}"
                                                                        Command="{s:Action RenameGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding GuideRenameTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource TaskQueue.Rename}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                                        Command="{s:Action RemoveGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="False"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Common.Delete}" />
                                                                </StackPanel>
                                                                <hc:ButtonGroup>
                                                                    <RadioButton
                                                                        Width="22"
                                                                        Margin="0,0,4,0"
                                                                        Padding="0"
                                                                        hc:VisualElement.HighlightBackground="Transparent"
                                                                        hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        GroupName="TaskSettings"
                                                                        IsChecked="{Binding EnableSetting}"
                                                                        Style="{DynamicResource RadioGroupItemSingle}">
                                                                        <Grid Width="16" Height="16">
                                                                            <Path
                                                                                Data="{StaticResource ConfigGeometry}"
                                                                                Stretch="Uniform"
                                                                                Visibility="{c:Binding !EnableSetting}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                            <Path
                                                                                Data="{StaticResource ConfigGeometry2}"
                                                                                Fill="{DynamicResource PrimaryBrush}"
                                                                                Stretch="Uniform"
                                                                                Visibility="{c:Binding EnableSetting}" />
                                                                        </Grid>
                                                                        <RadioButton.ToolTip>
                                                                            <ToolTip>
                                                                                <StackPanel>
                                                                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.LeftClick}" />
                                                                                    <TextBlock Text="{DynamicResource TaskQueue.TaskSettings}" />

                                                                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.RightClick}" />
                                                                                    <TextBlock>
                                                                                        <Run Text="{DynamicResource TaskQueue.RunOnce}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.RunFromHere}" /><Run Text="/" /><Run Text="{DynamicResource Common.Copy}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.Rename}" /><Run Text="/" /><Run Text="{DynamicResource Common.Delete}" />
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </ToolTip>
                                                                        </RadioButton.ToolTip>
                                                                        <RadioButton.ContextMenu>
                                                                            <ContextMenu Width="150">
                                                                                <MenuItem Command="{s:Action StartGuideDemo, Target={x:Static helper:Instances.SettingsViewModel}}" Header="{DynamicResource TaskQueue.RunOnce}" />
                                                                                <MenuItem Command="{s:Action StartGuideDemo, Target={x:Static helper:Instances.SettingsViewModel}}" Header="{DynamicResource TaskQueue.RunFromHere}" />
                                                                                <MenuItem
                                                                                    Command="{s:Action CopyGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource Common.Copy}"
                                                                                    IsEnabled="False" />
                                                                                <MenuItem
                                                                                    Command="{s:Action RenameGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource TaskQueue.Rename}"
                                                                                    IsEnabled="{Binding GuideRenameTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}" />
                                                                                <MenuItem
                                                                                    Command="{s:Action RemoveGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource Common.Delete}"
                                                                                    IsEnabled="False" />
                                                                            </ContextMenu>
                                                                        </RadioButton.ContextMenu>
                                                                    </RadioButton>
                                                                </hc:ButtonGroup>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Grid.Row="1" Margin="-1,0,-1,-1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                VerticalAlignment="Top">
                                                <controls:MenuButton
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    hc:BorderElement.CornerRadius="4,0,0,4"
                                                    hc:IconElement.Geometry="{StaticResource TaskQueueAddTaskIcon}"
                                                    AutomationProperties.Name="{DynamicResource TaskQueue.AddTask}"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    IsEnabled="{Binding GuideAddTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                    Style="{StaticResource MaaButtonDefaultStyle}"
                                                    ToolTip="{DynamicResource TaskQueue.AddTask}">
                                                    <controls:MenuButton.PopupContent>
                                                        <Border
                                                            Width="190"
                                                            Margin="8"
                                                            Padding="2,2,2,0"
                                                            Background="{DynamicResource RegionBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Effect="{DynamicResource EffectShadow2}">
                                                            <!--
                                                                本版 HandyControls 移除了原版 MenuAttach.ItemMinHeight（原 ContextMenu
                                                                隐式样式靠它把项撑到标准控件高度），Menu 的顶级项模板默认无最小高度，
                                                                需在容器样式显式补 MinHeight
                                                            -->
                                                            <Menu Padding="0" ItemsSource="{Binding TaskTypeList, Source={x:Static helper:Instances.TaskQueueViewModel}}">
                                                                <Menu.ItemContainerStyle>
                                                                    <Style BasedOn="{StaticResource MaaMenuItemDefaultStyle}" TargetType="MenuItem">
                                                                        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}" />
                                                                        <Setter Property="Command" Value="{Binding AddGuideDemoTaskCommand, Source={x:Static helper:Instances.SettingsViewModel}}" />
                                                                        <Setter Property="CommandParameter" Value="{Binding Value}" />
                                                                        <!--  Header 默认绑定整个条目，经 HeaderTemplate 渲染名称与引导红点  -->
                                                                        <Setter Property="HeaderTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                                                                                        <Ellipse
                                                                                            x:Name="MenuGateBadge"
                                                                                            Width="7"
                                                                                            Height="7"
                                                                                            Margin="4,-3,0,0"
                                                                                            VerticalAlignment="Top"
                                                                                            Fill="{DynamicResource NewBadgeBrush}"
                                                                                            Visibility="Collapsed" />
                                                                                    </StackPanel>
                                                                                    <DataTemplate.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding Value.Name}" Value="FightTask" />
                                                                                                <Condition Binding="{Binding GuideFightMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter TargetName="MenuGateBadge" Property="Visibility" Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding Value.Name}" Value="SwitchThemeTask" />
                                                                                                <Condition Binding="{Binding GuideSwitchThemeMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter TargetName="MenuGateBadge" Property="Visibility" Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </Menu.ItemContainerStyle>
                                                                <Menu.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Vertical" />
                                                                    </ItemsPanelTemplate>
                                                                </Menu.ItemsPanel>
                                                            </Menu>
                                                        </Border>
                                                    </controls:MenuButton.PopupContent>
                                                </controls:MenuButton>
                                                <!--  教程要求先添加任务才能进入下一步，未添加时红点引导（与任务队列按钮同视觉）  -->
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    Margin="0,1,1,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Fill="{DynamicResource NewBadgeBrush}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{c:Binding GuideAddTaskBadgeVisible}" />
                                            </Grid>
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="-1,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0"
                                                Command="{s:Action SelectAllGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource TaskQueue.SelectAll}" />
                                            <Button
                                                Grid.Column="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                Command="{s:Action ClearGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource Common.Clear}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <controls:TextBlock
                                    Grid.Row="2"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    FontSize="14"><Run Text="↑ " /><Run Text="{DynamicResource TaskQueue.AddTask}" /></controls:TextBlock>
                                <StackPanel
                                    Grid.Row="3"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="50"
                                        Margin="5"
                                        Command="{s:Action StartGuideDemo,
                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                        Content="{DynamicResource TaskQueue.LinkStart}" />
                                    <controls:TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{DynamicResource Guide.LinkStart}" />
                                </StackPanel>

                                <!--  右：设置面板随齿轮选中的任务切换（选项随常规/高级切换），顶部与任务面板同行对齐  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{c:Binding !GuideDemoAdvancedSettings}">
                                    <controls:TextBlock
                                        Margin="0,20,0,0"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Text="{DynamicResource Guide.Demo.SettingsPlaceholder}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{c:Binding 'SelectedGuideDemoTask == null'}" />
                                    <!--  开始唤醒：是否启动客户端（演示）  -->
                                    <StackPanel
                                        Margin="0,20,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{c:Binding SelectedGuideDemoTask.IsStartUpTask}">
                                        <CheckBox Content="{DynamicResource Connection.LaunchClient}" IsChecked="{Binding SelectedGuideDemoTask.DemoStartGame}" />
                                        <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource TaskQueue.CheckBoxesNotSaved}" />
                                        <controls:TextBlock Text="←" TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            MaxWidth="80"
                                            Margin="0,-10"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Guide.Tip}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!--  理智作战：关卡选择（演示）  -->
                                    <StackPanel Margin="0,20,0,0" Visibility="{c:Binding SelectedGuideDemoTask.IsFightTask}">
                                        <Grid>
                                            <ComboBox
                                                Height="30"
                                                DisplayMemberPath="Display"
                                                IsEnabled="{c:Binding GuideStageEditingAllowed}"
                                                ItemsSource="{Binding GuideDemoStageList}"
                                                SelectedValue="{Binding SelectedGuideDemoTask.DemoStage}"
                                                SelectedValuePath="Value" />
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Margin="0,-3,-4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="{DynamicResource NewBadgeBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="{c:Binding GuideStageBadgeVisible}" />
                                        </Grid>
                                    </StackPanel>
                                    <!--  更换主题：主题名列表（演示）  -->
                                    <StackPanel
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="{c:Binding SelectedGuideDemoTask.IsSwitchThemeTask}">
                                        <ItemsControl ItemsSource="{Binding SelectedGuideDemoTask.DemoThemes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            Width="150"
                                                            Height="30"
                                                            hc:InfoElement.Placeholder="{DynamicResource TaskQueue.SwitchTheme.Placeholder}"
                                                            IsEnabled="{Binding GuideThemeEditingAllowed, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="25"
                                                            Height="25"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                            hc:IconElement.Height="15"
                                                            hc:IconElement.Width="15"
                                                            Command="{s:Action RemoveGuideDemoTheme,
                                                                               Target={x:Static helper:Instances.SettingsViewModel}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding GuideThemeEditingAllowed, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                            ToolTip="{DynamicResource Common.Delete}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid HorizontalAlignment="Center">
                                            <Button
                                                MinWidth="50"
                                                Command="{s:Action AddGuideDemoTheme,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                CommandParameter="{Binding SelectedGuideDemoTask}"
                                                Content="{DynamicResource TaskQueue.SwitchTheme.Add}"
                                                IsEnabled="{c:Binding GuideThemeEditingAllowed}" />
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Margin="0,1,1,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="{DynamicResource NewBadgeBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="{c:Binding GuideThemeAddBadgeVisible}" />
                                        </Grid>
                                    </StackPanel>
                                    <!--  其他任务类型：跟随指引提示  -->
                                    <controls:TextBlock
                                        Margin="0,20,0,0"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Text="{DynamicResource Guide.Demo.SettingsPlaceholder}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{c:Binding 'SelectedGuideDemoTask != null and !SelectedGuideDemoTask.IsStartUpTask and !SelectedGuideDemoTask.IsFightTask and !SelectedGuideDemoTask.IsSwitchThemeTask'}" />
                                </StackPanel>
                                <!--  高级页：仅理智作战有演示内容（周计划），其余跟随指引提示  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{c:Binding GuideDemoAdvancedSettings}">
                                    <StackPanel Visibility="{c:Binding SelectedGuideDemoTask.IsFightTask}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox
                                                    Content="{DynamicResource TaskQueue.UseWeeklySchedule}"
                                                    IsChecked="{Binding SelectedGuideDemoTask.DemoUseWeeklySchedule}"
                                                    IsEnabled="{c:Binding GuideWeeklyEditingAllowed}" />
                                                <Ellipse
                                                    Width="7"
                                                    Height="7"
                                                    Margin="4,-3,0,0"
                                                    VerticalAlignment="Top"
                                                    Fill="{DynamicResource NewBadgeBrush}"
                                                    IsHitTestVisible="False"
                                                    Visibility="{c:Binding GuideWeeklyBadgeVisible}" />
                                                <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource TaskQueue.UseWeeklySchedule.Tip}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0" Visibility="{c:Binding SelectedGuideDemoTask.DemoUseWeeklySchedule}">
                                            <ListBox
                                                Height="150"
                                                HorizontalContentAlignment="Stretch"
                                                d:ItemsSource="{d:SampleData ItemCount=3}"
                                                IsEnabled="{c:Binding GuideWeeklyEditingAllowed}"
                                                ItemsSource="{Binding SelectedGuideDemoTask.DemoWeeklySchedule}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                Style="{DynamicResource NoSelectedHighlightListBoxStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding Display}"
                                                            IsChecked="{Binding Value}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                Margin="0,-3,-4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="{DynamicResource NewBadgeBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="{c:Binding GuideWeekDaysBadgeVisible}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center">
                                    <hc:ButtonGroup
                                        Width="220"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <RadioButton
                                            hc:BorderElement.CornerRadius="4,0,0,4"
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource TaskQueue.GeneralSettings}"
                                            IsChecked="{c:Binding !GuideDemoAdvancedSettings}" />
                                        <RadioButton
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource TaskQueue.AdvancedSettings}"
                                            IsChecked="{c:Binding GuideDemoAdvancedSettings}"
                                            IsEnabled="{c:Binding SelectedGuideDemoTask.IsFightTask}" />
                                    </hc:ButtonGroup>
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Margin="0,-3,-4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Fill="{DynamicResource NewBadgeBrush}"
                                        IsHitTestVisible="False"
                                        Visibility="{c:Binding GuideAdvancedBadgeVisible}" />
                                </Grid>
                            </Grid>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 5'}">
                            <StackPanel s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}" DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.PerformanceSettings}}">
                                <controls:TextBlock
                                    MaxWidth="400"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="{DynamicResource Settings.Performance.UseGpuForInference.Tip}"
                                    TextWrapping="Wrap" />
                                <hc:ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="300"
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    hc:InfoElement.Title="{DynamicResource Settings.Performance.UseGpuForInference}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding GpuOptions}"
                                    PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                                                 Target={x:Type helper:MouseWheelHelper}}"
                                    SelectedItem="{Binding ActiveGpuOption}">
                                    <hc:ComboBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="{x:Type ComboBoxItem}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeprecated}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.AllowDeprecatedGpu, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:ComboBox.ItemContainerStyle>
                                </hc:ComboBox>
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 6'}">
                            <hc:UniformSpacingPanel
                                s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}"
                                DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}"
                                Orientation="Vertical"
                                Spacing="10">
                                <StackPanel>
                                    <StackPanel
                                        Margin="8,0,0,5"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <controls:TextBlock Text="{DynamicResource Settings.Update.Channel}" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource Settings.Update.Channel.Tip}" />
                                    </StackPanel>
                                    <hc:ComboBox
                                        Width="200"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Display"
                                        ItemsSource="{Binding VersionTypeList}"
                                        SelectedValue="{Binding VersionType}"
                                        SelectedValuePath="Value" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel
                                        Margin="8,0,0,5"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <controls:TextBlock Text="{DynamicResource Settings.Update.Source}" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource Settings.Update.Source.Tip}" />
                                    </StackPanel>
                                    <hc:ComboBox
                                        Width="200"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Display"
                                        ItemsSource="{Binding UpdateSourceList}"
                                        SelectedValue="{Binding UpdateSource}"
                                        SelectedValuePath="Value" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Visibility="{c:Binding 'UpdateSource == enums:UpdateSource.MirrorChyan'}">
                                        <controls:TextBlock Margin="8,0,0,5" HorizontalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} CDK">
                                                    <Binding Source="{StaticResource Settings.Update.Source.MirrorChyan}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </controls:TextBlock>
                                        <Grid Width="200">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <hc:PasswordBox
                                                hc:BorderElement.CornerRadius="4,0,0,4"
                                                IsSafeEnabled="False"
                                                ShowEyeButton="True"
                                                UnsafePassword="{Binding MirrorChyanCdk}" />
                                            <Button
                                                Grid.Column="1"
                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                BorderThickness="0,1,1,1"
                                                Command="{s:Action MirrorChyanCdkCopy}"
                                                Content="{DynamicResource Common.Copy}" />
                                        </Grid>
                                        <controls:TextBlock
                                            MaxWidth="300"
                                            Margin="0,5,0,0"
                                            Foreground="{DynamicResource ErrorLogBrush}"
                                            Text="{DynamicResource Settings.Update.MirrorChyan.CdkFetchFailed}"
                                            TextWrapping="Wrap"
                                            Visibility="{c:Binding MirrorChyanCdkFetchFailed}" />
                                        <controls:TextBlock
                                            MaxWidth="300"
                                            Margin="0,5,0,0"
                                            d:Foreground="{DynamicResource SuccessLogBrush}"
                                            d:Text="{DynamicResource Settings.Update.MirrorChyan.CdkRemainingDays}"
                                            uiBehaviors:ResourceReferenceHelper.ForegroundResourceKey="{Binding MirrorChyanCdkRemainingBrush}"
                                            Text="{Binding MirrorChyanCdkRemainingText}"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding MirrorChyanCdkExpiredLocalTime}" />
                                    </StackPanel>
                                    <controls:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Hyperlink
                                            Cursor="Hand"
                                            NavigateUri="{Binding Source={x:Static constants:MaaUrls.MirrorChyanWebsite}}"
                                            TextDecorations="None">
                                            <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Settings.Update.Source.MirrorChyan}" />
                                        </Hyperlink>
                                    </controls:TextBlock>
                                </StackPanel>
                            </hc:UniformSpacingPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 1'}">
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <hc:UniformSpacingPanel
                                    MaxWidth="550"
                                    Margin="10"
                                    Orientation="Vertical"
                                    Spacing="12">
                                    <!--  官网/文档位置  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Guide.Documentation.Title}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Text="{DynamicResource Guide.Documentation.Path}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  问题反馈  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Guide.IssueReport.Subtitle}"
                                            TextWrapping="Wrap" />

                                        <!--  查看日志  -->
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Text="{DynamicResource Guide.ViewLog}"
                                            TextWrapping="Wrap" />

                                        <!--  生成报告  -->
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Text="{DynamicResource Guide.GenerateReport}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  GitHub 反馈规范  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Guide.GitHubIssue.Title}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Text="{DynamicResource Guide.GitHubIssue.Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  开源项目参与  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource Guide.OpenSource.Title}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Text="{DynamicResource Guide.OpenSource.Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--
                                        UniformSpacingPanel 会把直接子项拉伸至整行宽导致内容左对齐，
                                        须经 StackPanel 包装后子元素的 HorizontalAlignment=Center 才能生效
                                    -->
                                    <StackPanel>
                                        <Grid HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:TextBlock Text="{DynamicResource Guide.Agreement.Prefix}" />
                                                <Grid>
                                                    <controls:TextBlock>
                                                        <Hyperlink
                                                            Click="{s:Action OnGuideUserAgreementClick}"
                                                            Cursor="Hand"
                                                            NavigateUri="{Binding Source={x:Static constants:MaaUrls.UserAgreement}}"
                                                            TextDecorations="None">
                                                            <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Guide.Agreement.Link}" />
                                                        </Hyperlink>
                                                    </controls:TextBlock>
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Margin="0,1,-10,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Fill="{DynamicResource NewBadgeBrush}"
                                                        IsHitTestVisible="False"
                                                        Visibility="{c:Binding 'GuideStepIndex == 1 and !GuideUserAgreementOpened'}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </hc:UniformSpacingPanel>
                            </ScrollViewer>
                        </hc:TransitioningContentControl>
                    </hc:SimplePanel>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
