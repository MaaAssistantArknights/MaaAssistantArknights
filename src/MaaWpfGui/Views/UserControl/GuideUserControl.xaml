<UserControl
    x:Class="MaaWpfGui.Views.UserControl.GuideUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:DataContext="{d:DesignInstance ui_vms:SettingsViewModel}"
    mc:Ignorable="d">
    <GroupBox
        Margin="10"
        Background="{DynamicResource RegionBrush}"
        Header="{DynamicResource Guide.Settings}"
        Style="{StaticResource GroupBoxTab}">
        <DockPanel Margin="16">
            <DockPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Command="{s:Action DoneGuide}"
                        Content="{DynamicResource Guide.Skip}" />
                    <Button
                        MinWidth="100"
                        Command="{s:Action DoneGuide}"
                        Content="{DynamicResource Guide.Done}"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
                <controls:TextBlock VerticalAlignment="Center">
                    <Hyperlink
                        Cursor="Hand"
                        NavigateUri="{Binding Source={x:Static constants:MaaUrls.UserAgreement}}"
                        TextDecorations="None">
                        <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Guide.Agreement.Link}" />
                    </Hyperlink>
                </controls:TextBlock>
            </DockPanel>

            <hc:ScrollViewer IsInertiaEnabled="True" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="560" VerticalAlignment="Center">
                    <hc:UniformSpacingPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="16">
                        <ComboBox
                            Width="200"
                            hc:InfoElement.Title="{Binding LanguageInfo}"
                            hc:TitleElement.HorizontalAlignment="Center"
                            DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.GuiSettings}}"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding LanguageList}"
                            SelectedValue="{Binding Language}"
                            SelectedValuePath="Value" />
                        <ComboBox
                            Width="200"
                            hc:InfoElement.Title="{DynamicResource Settings.Game.ClientType}"
                            hc:TitleElement.HorizontalAlignment="Center"
                            DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.GameSettings}}"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding ClientTypeList}"
                            SelectedValue="{Binding ClientType}"
                            SelectedValuePath="Value" />
                    </hc:UniformSpacingPanel>

                    <hc:Divider Margin="0,14,0,6" Content="{DynamicResource Settings.Connection.Title}" />
                    <StackPanel DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                        <controls:TextBlock
                            Margin="0,0,0,6"
                            Text="{DynamicResource Guide.Connection.Tip}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{c:Binding !IsPCConnectConfig}" />
                        <settings:ConnectSettingsUserControl ShowAdvancedConnectSettings="False" />
                    </StackPanel>

                    <controls:TextBlock
                        Margin="0,12,0,0"
                        Text="{DynamicResource Guide.TaskSettings.Tip}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </hc:ScrollViewer>
        </DockPanel>
    </GroupBox>
</UserControl>
