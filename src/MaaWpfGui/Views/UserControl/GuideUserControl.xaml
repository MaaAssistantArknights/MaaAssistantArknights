<UserControl
    x:Class="MaaWpfGui.Views.UserControl.GuideUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MaaWpfGui.Constants.Enums"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:uiBehaviors="clr-namespace:MaaWpfGui.Extensions.UIBehaviors"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance ui_vms:SettingsViewModel}"
    mc:Ignorable="d">
    <Grid>
        <GroupBox
            Margin="10"
            Background="{DynamicResource RegionBrush}"
            Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <hc:RelativePanel Height="20">
                    <TextBlock
                        hc:RelativePanel.AlignHorizontalCenterWithPanel="True"
                        hc:RelativePanel.AlignVerticalCenterWithPanel="True"
                        FontSize="14"
                        Text="{DynamicResource SettingsGuide}" />
                    <!--<Button
                        Margin="5,0"
                        Command="{s:Action DoneGuide}"
                        Content="Skip"
                        Style="{StaticResource ButtonDashedWarning.Small}" />-->
                </hc:RelativePanel>
            </GroupBox.Header>
            <DockPanel>
                <StackPanel
                    Margin="10"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right">
                    <Button
                        MinWidth="100"
                        hc:IconElement.Geometry="{StaticResource UpGeometry}"
                        hc:IconElement.Width="18"
                        Command="{s:Action PrevGuide}"
                        CommandParameter="{Binding ElementName=GuideStepBar}"
                        Content="{DynamicResource PrevGuide}"
                        Style="{StaticResource ButtonDashedPrimary}" />
                    <hc:StepBar
                        Name="GuideStepBar"
                        Margin="10"
                        d:StepIndex="7"
                        Dock="Right"
                        StepIndex="{Binding GuideStepIndex}">
                        <hc:StepBarItem Content="{DynamicResource UiSettings}" />
                        <hc:StepBarItem Content="{DynamicResource GameSettings}" />
                        <hc:StepBarItem Content="{DynamicResource ConnectionSettings}" />
                        <hc:StepBarItem Content="{DynamicResource TaskSettings}" />
                        <hc:StepBarItem Content="{DynamicResource PerformanceSettings}" />
                        <hc:StepBarItem Content="{DynamicResource UpdateSettings}" />
                        <hc:StepBarItem Content="{DynamicResource UserGuide}" />
                    </hc:StepBar>
                    <Button
                        MinWidth="100"
                        hc:IconElement.Geometry="{StaticResource DownGeometry}"
                        hc:IconElement.Width="18"
                        Command="{s:Action NextGuide}"
                        CommandParameter="{Binding ElementName=GuideStepBar}"
                        Content="{DynamicResource NextGuide}"
                        Style="{StaticResource ButtonDashedPrimary}"
                        Visibility="{c:Binding 'GuideStepIndex less GuideMaxStep - 1'}" />
                    <Button
                        MinWidth="100"
                        hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                        hc:IconElement.Width="18"
                        Command="{s:Action DoneGuide}"
                        Content="{DynamicResource DoneGuide}"
                        IsEnabled="{Binding GuideConfirmEnabled}"
                        Style="{StaticResource ButtonDashedPrimary}"
                        Visibility="{c:Binding 'GuideStepIndex >= GuideMaxStep - 1'}" />
                    <controls:TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        Visibility="{c:Binding '!GuideConfirmEnabled',
                                               FalseToVisibility=Hidden}">
                        <Run Text="{DynamicResource GuideConfirmCountdownPrefix}" /><Run Text="{Binding GuideConfirmCountdown}" /><Run Text="{DynamicResource GuideConfirmCountdownSuffix}" />
                    </controls:TextBlock>
                </StackPanel>

                <ScrollViewer Margin="10,20,10,20" VerticalScrollBarVisibility="Auto">
                    <hc:SimplePanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <hc:TransitioningContentControl
                            Width="200"
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex less= 0'}">
                            <hc:UniformSpacingPanel
                                DataContext="{Binding GuiSettings}"
                                Orientation="Vertical"
                                Spacing="20">
                                <ComboBox
                                    hc:InfoElement.Title="{Binding LanguageInfo}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding LanguageList}"
                                    SelectedValue="{Binding Language}"
                                    SelectedValuePath="Value" />
                                <ComboBox
                                    hc:InfoElement.Title="{DynamicResource UiTheme}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding DarkModeList}"
                                    SelectedValue="{Binding DarkMode}"
                                    SelectedValuePath="Value" />
                            </hc:UniformSpacingPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 1'}">
                            <StackPanel DataContext="{Binding GameSettings}">
                                <ComboBox
                                    Width="200"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    hc:InfoElement.Title="{DynamicResource ClientType}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding ClientTypeList}"
                                    SelectedValue="{Binding ClientType}"
                                    SelectedValuePath="Value" />
                                <!--<CheckBox
                                    Margin="10"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding DeploymentWithPause}">
                                    <controls:TextBlock
                                        Block.TextAlignment="Center"
                                        Text="{DynamicResource DeploymentWithPause}"
                                        TextWrapping="Wrap" />
                                </CheckBox>-->
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 2'}">
                            <StackPanel s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}" DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                                <controls:TextBlock
                                    MaxWidth="400"
                                    Margin="0,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Block.TextAlignment="Left"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="{DynamicResource GuideStepClarification}"
                                    TextWrapping="Wrap"
                                    Visibility="{c:Binding !IsPCConnectConfig}" />

                                <settings:ConnectSettingsUserControl ShowAdvancedConnectSettings="False" />
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            Width="480"
                            Height="430"
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 3'}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="210"
                                    Margin="0,0,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <controls:TextBlock
                                        FontSize="14"
                                        Text="{DynamicResource HoverActionButtons}"
                                        TextWrapping="Wrap" />
                                    <controls:TextBlock
                                        Grid.Row="1"
                                        FontSize="14"
                                        Text="{DynamicResource GearContextMenuTip}"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!--  演示任务面板：列表与互动操作均为演示数据，与真实任务队列无关  -->
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="210"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl
                                            Grid.Row="0"
                                            Width="190"
                                            MinHeight="140"
                                            Margin="0,10,0,8"
                                            HorizontalAlignment="Center"
                                            ItemsSource="{Binding GuideDemoTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        x:Name="GuideDemoItemBorder"
                                                        MinHeight="24.5"
                                                        Background="Transparent"
                                                        CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  Column 0: CheckBox 拉伸填充可点击区域，名称由叠加 TextBlock 展示（照真实任务项结构）  -->
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                MaxWidth="140"
                                                                Margin="4.5,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                IsChecked="{Binding IsChecked}">
                                                                <controls:TextBlock Text="{Binding Name}" Visibility="Hidden" />
                                                            </CheckBox>
                                                            <controls:TextBlock
                                                                Grid.Column="0"
                                                                Margin="26,0,4,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                IsHitTestVisible="False"
                                                                Text="{Binding Name}" />

                                                            <!--  Column 1: 悬浮显示的 复制/重命名/删除 与常驻齿轮（右键菜单），交互均落在演示列表  -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GuideDemoItemBorder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource CopyTaskGeometry}"
                                                                        Command="{s:Action CopyGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Copy}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource RenameTaskGeometry}"
                                                                        Command="{s:Action RenameGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Rename}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                                        Command="{s:Action RemoveGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Delete}" />
                                                                </StackPanel>
                                                                <hc:ButtonGroup>
                                                                    <RadioButton
                                                                        Width="22"
                                                                        Margin="0,0,4,0"
                                                                        Padding="0"
                                                                        hc:VisualElement.HighlightBackground="Transparent"
                                                                        hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        GroupName="TaskSettings"
                                                                        IsChecked="{Binding EnableSetting}"
                                                                        Style="{DynamicResource RadioGroupItemSingle}">
                                                                        <Grid Width="16" Height="16">
                                                                            <Path
                                                                                Data="{StaticResource ConfigGeometry}"
                                                                                Stretch="Uniform"
                                                                                Visibility="{c:Binding !EnableSetting}">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                                                <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                            <Path
                                                                                Data="{StaticResource ConfigGeometry2}"
                                                                                Fill="{DynamicResource PrimaryBrush}"
                                                                                Stretch="Uniform"
                                                                                Visibility="{c:Binding EnableSetting}" />
                                                                        </Grid>
                                                                        <RadioButton.ToolTip>
                                                                            <ToolTip>
                                                                                <StackPanel>
                                                                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource LeftClick}" />
                                                                                    <TextBlock Text="{DynamicResource TaskSettings}" />

                                                                                    <TextBlock FontWeight="SemiBold" Text="{DynamicResource RightClick}" />
                                                                                    <TextBlock>
                                                                                        <Run Text="{DynamicResource RunTaskOnce}" /><Run Text="/" /><Run Text="{DynamicResource Copy}" /><Run Text="/" /><Run Text="{DynamicResource Rename}" /><Run Text="/" /><Run Text="{DynamicResource Delete}" />
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </ToolTip>
                                                                        </RadioButton.ToolTip>
                                                                        <RadioButton.ContextMenu>
                                                                            <ContextMenu Width="150">
                                                                                <MenuItem Command="{s:Action StartGuideDemo, Target={x:Static helper:Instances.SettingsViewModel}}" Header="{DynamicResource RunTaskOnce}" />
                                                                                <MenuItem
                                                                                    Command="{s:Action CopyGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource Copy}" />
                                                                                <MenuItem
                                                                                    Command="{s:Action RenameGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource Rename}" />
                                                                                <MenuItem
                                                                                    Command="{s:Action RemoveGuideDemoTask,
                                                                                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                    Header="{DynamicResource Delete}" />
                                                                            </ContextMenu>
                                                                        </RadioButton.ContextMenu>
                                                                    </RadioButton>
                                                                </hc:ButtonGroup>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:MenuButton
                                                Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="4,0,0,4"
                                                hc:IconElement.Geometry="{StaticResource TaskQueueAddTaskIcon}"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Style="{StaticResource MaaButtonDefaultStyle}"
                                                ToolTip="{DynamicResource AddTaskQueueTask}">
                                                <controls:MenuButton.PopupContent>
                                                    <Border
                                                        Width="190"
                                                        Margin="8"
                                                        Padding="2,2,2,0"
                                                        Background="{DynamicResource RegionBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Effect="{DynamicResource EffectShadow2}">
                                                        <!--
                                                            本版 HandyControls 移除了原版 MenuAttach.ItemMinHeight（原 ContextMenu
                                                            隐式样式靠它把项撑到标准控件高度），Menu 的顶级项模板默认无最小高度，
                                                            需在容器样式显式补 MinHeight
                                                        -->
                                                        <Menu Padding="0">
                                                            <Menu.ItemContainerStyle>
                                                                <Style BasedOn="{StaticResource MaaMenuItemDefaultStyle}" TargetType="MenuItem">
                                                                    <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}" />
                                                                </Style>
                                                            </Menu.ItemContainerStyle>
                                                            <Menu.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Vertical" />
                                                                </ItemsPanelTemplate>
                                                            </Menu.ItemsPanel>
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[0].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[0].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[1].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[1].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[2].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[2].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[3].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[3].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[4].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[4].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[5].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[5].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[6].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[6].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[7].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[7].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[8].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[8].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[9].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[9].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                            <MenuItem
                                                                Command="{s:Action AddGuideDemoTask,
                                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                CommandParameter="{Binding TaskTypeList[10].Value, Source={x:Static helper:Instances.TaskQueueViewModel}}"
                                                                Header="{Binding TaskTypeList[10].Display, Source={x:Static helper:Instances.TaskQueueViewModel}}" />
                                                        </Menu>
                                                    </Border>
                                                </controls:MenuButton.PopupContent>
                                            </controls:MenuButton>
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="-1,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0"
                                                Command="{s:Action SelectAllGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource SelectAll}" />
                                            <Button
                                                Grid.Column="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                Command="{s:Action ClearGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource Clear}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="50"
                                        Margin="5"
                                        Command="{s:Action StartGuideDemo,
                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                        Content="{DynamicResource LinkStart}" />
                                    <controls:TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{DynamicResource LinkStartGuide}" />
                                </StackPanel>

                                <!--  右：假设置列（选项随常规/高级切换）与按钮组，顶部与任务面板同行对齐  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{c:Binding !GuideDemoAdvancedSettings}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="True">
                                            <controls:TextBlock>
                                                <Run Text="{DynamicResource GeneralSettings}" /><Run xml:space="preserve" Text=" 1" />
                                            </controls:TextBlock>
                                        </CheckBox>
                                        <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource CheckBoxesNotSaved}" />
                                        <controls:TextBlock Text="←" TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            MaxWidth="80"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource ToolTipGuide}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Margin="0,10,0,0">
                                        <controls:TextBlock>
                                            <Run Text="{DynamicResource GeneralSettings}" /><Run xml:space="preserve" Text=" 2" />
                                        </controls:TextBlock>
                                    </CheckBox>
                                    <CheckBox Margin="0,10,0,0">
                                        <controls:TextBlock>
                                            <Run Text="{DynamicResource GeneralSettings}" /><Run xml:space="preserve" Text=" 3" />
                                        </controls:TextBlock>
                                    </CheckBox>
                                </StackPanel>
                                <hc:UniformSpacingPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    Orientation="Vertical"
                                    Spacing="10"
                                    Visibility="{c:Binding GuideDemoAdvancedSettings}">
                                    <CheckBox IsChecked="True">
                                        <controls:TextBlock>
                                            <Run Text="{DynamicResource AdvancedSettings}" /><Run xml:space="preserve" Text=" 1" />
                                        </controls:TextBlock>
                                    </CheckBox>
                                    <CheckBox>
                                        <controls:TextBlock>
                                            <Run Text="{DynamicResource AdvancedSettings}" /><Run xml:space="preserve" Text=" 2" />
                                        </controls:TextBlock>
                                    </CheckBox>
                                    <CheckBox>
                                        <controls:TextBlock>
                                            <Run Text="{DynamicResource AdvancedSettings}" /><Run xml:space="preserve" Text=" 3" />
                                        </controls:TextBlock>
                                    </CheckBox>
                                </hc:UniformSpacingPanel>
                                <StackPanel
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,10,0,0">
                                    <hc:ButtonGroup
                                        Width="220"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <RadioButton
                                            hc:BorderElement.CornerRadius="4,0,0,4"
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource GeneralSettings}"
                                            IsChecked="{c:Binding !GuideDemoAdvancedSettings}" />
                                        <RadioButton
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource AdvancedSettings}"
                                            IsChecked="{c:Binding GuideDemoAdvancedSettings}" />
                                    </hc:ButtonGroup>
                                    <Grid Width="220" Margin="0,2,0,0">
                                        <controls:TextBlock
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Left"
                                            FontSize="14"
                                            Text="{DynamicResource OftenUsedGuide}" />
                                        <controls:TextBlock
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right"
                                            FontSize="14"
                                            Text="{DynamicResource SometimesUsedGuide}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 4'}">
                            <StackPanel s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}" DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.PerformanceSettings}}">
                                <controls:TextBlock
                                    MaxWidth="400"
                                    Foreground="{DynamicResource InfoBrush}"
                                    Text="{DynamicResource UseGpuForInferenceTip}"
                                    TextWrapping="Wrap" />
                                <hc:ComboBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="300"
                                    Margin="5"
                                    HorizontalAlignment="Stretch"
                                    hc:InfoElement.Title="{DynamicResource UseGpuForInference}"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    DisplayMemberPath="Display"
                                    ItemsSource="{Binding GpuOptions}"
                                    PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                                                 Target={x:Type helper:MouseWheelHelper}}"
                                    SelectedItem="{Binding ActiveGpuOption}">
                                    <hc:ComboBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="{x:Type ComboBoxItem}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsDeprecated}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.AllowDeprecatedGpu, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:ComboBox.ItemContainerStyle>
                                </hc:ComboBox>
                            </StackPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 5'}">
                            <hc:UniformSpacingPanel
                                s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}"
                                DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}"
                                Orientation="Vertical"
                                Spacing="10">
                                <StackPanel>
                                    <StackPanel
                                        Margin="8,0,0,5"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <controls:TextBlock Text="{DynamicResource UpdateCheck}" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource UpdateCheckTip}" />
                                    </StackPanel>
                                    <hc:ComboBox
                                        Width="200"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Display"
                                        ItemsSource="{Binding VersionTypeList}"
                                        SelectedValue="{Binding VersionType}"
                                        SelectedValuePath="Value" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel
                                        Margin="8,0,0,5"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <controls:TextBlock Text="{DynamicResource UpdateSource}" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource UpdateSourceTip}" />
                                    </StackPanel>
                                    <hc:ComboBox
                                        Width="200"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="Display"
                                        ItemsSource="{Binding UpdateSourceList}"
                                        SelectedValue="{Binding UpdateSource}"
                                        SelectedValuePath="Value" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Visibility="{c:Binding 'UpdateSource == enums:UpdateSource.MirrorChyan'}">
                                        <controls:TextBlock Margin="8,0,0,5" HorizontalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} CDK">
                                                    <Binding Source="{StaticResource MirrorChyan}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </controls:TextBlock>
                                        <Grid Width="200">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <hc:PasswordBox
                                                hc:BorderElement.CornerRadius="4,0,0,4"
                                                IsSafeEnabled="False"
                                                ShowEyeButton="True"
                                                UnsafePassword="{Binding MirrorChyanCdk}" />
                                            <Button
                                                Grid.Column="1"
                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                BorderThickness="0,1,1,1"
                                                Command="{s:Action MirrorChyanCdkCopy}"
                                                Content="{DynamicResource Copy}" />
                                        </Grid>
                                        <controls:TextBlock
                                            MaxWidth="300"
                                            Margin="0,5,0,0"
                                            Foreground="{DynamicResource ErrorLogBrush}"
                                            Text="{DynamicResource MirrorChyanCdkFetchFailed}"
                                            TextWrapping="Wrap"
                                            Visibility="{c:Binding MirrorChyanCdkFetchFailed}" />
                                        <controls:TextBlock
                                            MaxWidth="300"
                                            Margin="0,5,0,0"
                                            d:Foreground="{DynamicResource SuccessLogBrush}"
                                            d:Text="{DynamicResource MirrorChyanCdkRemainingDays}"
                                            uiBehaviors:ResourceReferenceHelper.ForegroundResourceKey="{Binding MirrorChyanCdkRemainingBrush}"
                                            Text="{Binding MirrorChyanCdkRemainingText}"
                                            TextWrapping="Wrap"
                                            ToolTip="{Binding MirrorChyanCdkExpiredLocalTime}" />
                                    </StackPanel>
                                    <controls:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Hyperlink
                                            Cursor="Hand"
                                            NavigateUri="{Binding Source={x:Static constants:MaaUrls.MirrorChyanWebsite}}"
                                            TextDecorations="None">
                                            <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource MirrorChyan}" />
                                        </Hyperlink>
                                    </controls:TextBlock>
                                </StackPanel>
                            </hc:UniformSpacingPanel>
                        </hc:TransitioningContentControl>

                        <hc:TransitioningContentControl
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 6'}">
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <hc:UniformSpacingPanel
                                    MaxWidth="550"
                                    Margin="10"
                                    Orientation="Vertical"
                                    Spacing="12">
                                    <!--  官网/文档位置  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource GuideDocumentationTitle}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideDocumentationPath}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  问题反馈  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource GuideIssueReportSubtitle}"
                                            TextWrapping="Wrap" />

                                        <!--  查看日志  -->
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideViewLog}"
                                            TextWrapping="Wrap" />

                                        <!--  生成报告  -->
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideGenerateReport}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  GitHub 反馈规范  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource GuideGitHubIssueTitle}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideGitHubIssueDescription}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <!--  开源项目参与  -->
                                    <StackPanel>
                                        <controls:TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{DynamicResource GuideOpenSourceTitle}"
                                            TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            Margin="0,2.5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideOpenSourceDescription}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Separator />

                                    <StackPanel>
                                        <controls:TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                            Text="{DynamicResource GuideUserAgreement}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </hc:UniformSpacingPanel>
                            </ScrollViewer>
                        </hc:TransitioningContentControl>
                    </hc:SimplePanel>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
