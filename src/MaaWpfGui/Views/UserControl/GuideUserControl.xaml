<UserControl
    x:Class="MaaWpfGui.Views.UserControl.GuideUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance ui_vms:SettingsViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  引导强调色：门槛提示与菜单目标标记共用，避免在样式里散落硬编码色值  -->
        <SolidColorBrush x:Key="GuideAccentBrush" Color="#F3631B" />
        <SolidColorBrush x:Key="GuideBadgeBackgroundBrush" Color="#33FFB300" />
        <SolidColorBrush x:Key="GuideBadgeForegroundBrush" Color="#B36B00" />

        <!--  现代化向导图标资源  -->
        <Geometry x:Key="GlobeGeometry">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,4.07C7.45,4.57 4.64,7.4 4.1,11H7.81C8.25,8.19 9.47,5.74 11,4.07M13,4.07C14.53,5.74 15.75,8.19 16.19,11H19.9C19.36,7.4 16.55,4.57 13,4.07M4.09,13C4.63,16.6 7.44,19.43 11,19.93C9.47,18.26 8.25,15.81 7.81,13H4.09M9.83,13H14.17C14.61,15.44 15.6,17.5 16.88,19C15.42,19.64 13.76,20 12,20C10.24,20 8.58,19.64 7.12,19C8.4,17.5 9.39,15.44 9.83,13M9.83,11C9.39,8.56 8.4,6.5 7.12,5C8.58,4.36 10.24,4 12,4C13.76,4 15.42,4.36 16.88,5C15.6,6.5 14.61,8.56 14.17,11H9.83M16.19,13C15.75,15.81 14.53,18.26 13,19.93C16.55,19.43 19.36,16.6 19.91,13H16.19Z</Geometry>
        <Geometry x:Key="PaletteGeometry">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A3.5,3.5 0 0,0 15.5,18.5C15.5,17.8 15.2,17.2 14.8,16.7C14.4,16.2 14.2,15.6 14.2,15A1.8,1.8 0 0,1 16,13.2H18A4,4 0 0,0 22,9.2C22,5.2 17.5,2 12,2M6.5,11A1.5,1.5 0 0,1 5,9.5A1.5,1.5 0 0,1 6.5,8A1.5,1.5 0 0,1 8,9.5A1.5,1.5 0 0,1 6.5,11M9.5,7A1.5,1.5 0 0,1 8,5.5A1.5,1.5 0 0,1 9.5,4A1.5,1.5 0 0,1 11,5.5A1.5,1.5 0 0,1 9.5,7M14.5,7A1.5,1.5 0 0,1 13,5.5A1.5,1.5 0 0,1 14.5,4A1.5,1.5 0 0,1 16,5.5A1.5,1.5 0 0,1 14.5,7M17.5,11A1.5,1.5 0 0,1 16,9.5A1.5,1.5 0 0,1 17.5,8A1.5,1.5 0 0,1 19,9.5A1.5,1.5 0 0,1 17.5,11Z</Geometry>
        <Geometry x:Key="SparkleGeometry">M12,2L14.4,7.6L20,10L14.4,12.4L12,18L9.6,12.4L4,10L9.6,7.6L12,2M19,15L20.2,17.8L23,19L20.2,20.2L19,23L17.8,20.2L15,19L17.8,17.8L19,15M6,16L7.2,18.8L10,20L7.2,21.2L6,24L4.8,21.2L2,20L4.8,18.8L6,16Z</Geometry>
    </UserControl.Resources>
    <Grid>
        <GroupBox
            Margin="10"
            Background="{DynamicResource RegionBrush}"
            Style="{StaticResource GroupBoxTab}">
            <GroupBox.Header>
                <hc:RelativePanel Height="24">
                    <!--  标题与徽标  -->
                    <StackPanel
                        Orientation="Horizontal"
                        hc:RelativePanel.AlignHorizontalCenterWithPanel="True"
                        hc:RelativePanel.AlignVerticalCenterWithPanel="True">
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Data="{StaticResource ConfigGeometry}"
                            Fill="{DynamicResource PrimaryBrush}"
                            Stretch="Uniform"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Guide.Settings}" />
                    </StackPanel>
                    <!--  跳过按钮：靠右对齐，幽灵风格更克制不喧宾夺主  -->
                    <Button
                        Margin="8,0"
                        Padding="10,2"
                        Height="22"
                        FontSize="12"
                        hc:BorderElement.CornerRadius="3"
                        hc:RelativePanel.AlignRightWithPanel="True"
                        hc:RelativePanel.AlignVerticalCenterWithPanel="True"
                        Command="{s:Action SkipGuide}"
                        Content="{DynamicResource Guide.Skip}"
                        Style="{StaticResource ButtonDefault}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Visibility="{c:Binding GuideSkipVisible}" />
                </hc:RelativePanel>
            </GroupBox.Header>
            <DockPanel>
                <!--  顶部导航区：横排步骤条，其下导航按钮与胶囊指引提示  -->
                <Grid Margin="12,12,12,6" DockPanel.Dock="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <hc:StepBar
                        Name="GuideStepBar"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10"
                        d:StepIndex="5"
                        PreviewMouseLeftButtonUp="{s:Action NavigateGuideToStepFromBar}"
                        StepIndex="{Binding GuideStepIndex, Mode=OneWay}"
                        ToolTip="{DynamicResource Guide.StepBar.Tip}"
                        ToolTipService.InitialShowDelay="400">
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Settings.Ui.Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Guide.User}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Settings.Game.Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Settings.Connection.Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Settings.Performance.Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource TaskQueue.TaskSettings}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                        <hc:StepBarItem>
                            <TextBlock
                                Background="Transparent"
                                Cursor="Hand"
                                Text="{DynamicResource Settings.Update.Title}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </hc:StepBarItem>
                    </hc:StepBar>

                    <!--  上一步按钮  -->
                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        MinWidth="96"
                        Height="32"
                        VerticalAlignment="Center"
                        hc:BorderElement.CornerRadius="6"
                        hc:IconElement.Geometry="{StaticResource UpGeometry}"
                        hc:IconElement.Width="14"
                        Command="{s:Action PrevGuide}"
                        Content="{DynamicResource Guide.Prev}"
                        IsEnabled="{Binding GuidePrevEnabled}"
                        Style="{StaticResource ButtonDefault}" />

                    <!--  中心门槛提示胶囊 / 步骤指示器  -->
                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <!--  门槛提示：醒目圆润的引导提示胶囊  -->
                        <Border
                            Padding="14,5"
                            Background="{DynamicResource GuideBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource GuideAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="{c:Binding 'GuideNextGateTip != null'}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,6,0"
                                    Data="{StaticResource InfoGeometry}"
                                    Fill="{DynamicResource GuideAccentBrush}"
                                    Stretch="Uniform"
                                    VerticalAlignment="Center" />
                                <controls:TextBlock
                                    d:Text="Next gate tip"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource GuideAccentBrush}"
                                    Text="{Binding GuideNextGateTip}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  下一步 / 完成按钮  -->
                    <Grid
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center">
                        <Button
                            MinWidth="100"
                            Height="32"
                            hc:BorderElement.CornerRadius="6"
                            hc:IconElement.Geometry="{StaticResource DownGeometry}"
                            hc:IconElement.Width="14"
                            Command="{s:Action NextGuide}"
                            Content="{DynamicResource Guide.Next}"
                            IsEnabled="{c:Binding 'GuideNextGateTip == null'}"
                            Style="{StaticResource ButtonPrimary}"
                            ToolTip="{Binding GuideNextGateTip}"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{c:Binding 'GuideStepIndex less GuideMaxStep - 1'}" />
                        <Button
                            MinWidth="100"
                            Height="32"
                            hc:BorderElement.CornerRadius="6"
                            hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                            hc:IconElement.Width="14"
                            Command="{s:Action DoneGuide}"
                            Content="{DynamicResource Guide.Done}"
                            Style="{StaticResource ButtonPrimary}"
                            Visibility="{c:Binding 'GuideStepIndex >= GuideMaxStep - 1'}" />
                    </Grid>

                    <!--  数字进度：始终常驻，让用户对指引全局有清晰预期  -->
                    <controls:TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,6,0,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource ThirdlyTextBrush}"
                        TextAlignment="Center">
                        <Run Text="{DynamicResource Guide.Progress}" /><Run Text=" " /><Run Text="{Binding GuideProgressText, Mode=OneWay}" />
                    </controls:TextBlock>
                </Grid>

                <!--  清晰 1px 分割线，形成干净利落的硬过渡分界  -->
                <Rectangle
                    Height="1"
                    DockPanel.Dock="Top"
                    Fill="{DynamicResource BorderBrush}" />

                <!--  主内容展示区与聚光灯遮罩（完全贴合内容区，下边缘圆角匹配外框）  -->
                <Grid>
                    <ScrollViewer
                        Name="GuideContentScrollViewer"
                        Padding="10,8,10,10"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid MinHeight="{Binding ViewportHeight, ElementName=GuideContentScrollViewer}">
                            <hc:SimplePanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <!--  步骤 0：欢迎开场与个性化偏好（语言 / 主题）  -->
                            <hc:TransitioningContentControl
                                Width="740"
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex less= 0'}">
                                <StackPanel MaxWidth="740">
                                    <!--  顶部欢迎横幅卡片  -->
                                    <Border
                                        Margin="0,0,0,16"
                                        Padding="20,16"
                                        Background="{DynamicResource RegionBrushOpacity25}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image
                                                Width="52"
                                                Height="52"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="pack://application:,,,/Res/Img/Pallas.png" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <controls:TextBlock
                                                    HorizontalAlignment="Left"
                                                    TextAlignment="Left"
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    Text="{DynamicResource Guide.Welcome.Title}" />
                                                <controls:TextBlock
                                                    HorizontalAlignment="Left"
                                                    TextAlignment="Left"
                                                    Margin="0,4,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.Welcome.Tip}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!--  下方左右两列设置卡片（语言设置 + 界面主题）  -->
                                    <Grid DataContext="{Binding GuiSettings}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  卡片 1：语言偏好设置  -->
                                        <Border
                                            Grid.Column="0"
                                            Padding="20,16"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Path
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"
                                                        Data="{StaticResource GlobeGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{Binding LanguageInfo}" />
                                                </StackPanel>
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding LanguageList}"
                                                    SelectedValue="{Binding Language}"
                                                    SelectedValuePath="Value" />
                                            </StackPanel>
                                        </Border>

                                        <!--  卡片 2：界面主题模式  -->
                                        <Border
                                            Grid.Column="2"
                                            Padding="20,16"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Path
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,8,0"
                                                        Data="{StaticResource PaletteGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{DynamicResource Settings.Theme}" />
                                                </StackPanel>
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding DarkModeList}"
                                                    SelectedValue="{Binding DarkMode}"
                                                    SelectedValuePath="Value" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </hc:TransitioningContentControl>

                            <!--  步骤 1：使用指引与用户协议  -->
                            <hc:TransitioningContentControl
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex == 1'}">
                                <StackPanel MaxWidth="720" Margin="10,0">
                                    <!--  2x2 信息卡片网格  -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  卡片 1：官网与文档  -->
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,0,12"
                                            Padding="14,12"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        Data="{StaticResource InfoGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{DynamicResource Guide.Documentation.Title}" />
                                                </StackPanel>
                                                <controls:TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.Documentation.Path}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  卡片 2：问题反馈与日志  -->
                                        <Border
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="0,0,0,12"
                                            Padding="14,12"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        Data="{StaticResource ConfigGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{DynamicResource Guide.IssueReport.Subtitle}" />
                                                </StackPanel>
                                                <controls:TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.ViewLog}"
                                                    TextWrapping="Wrap" />
                                                <controls:TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.GenerateReport}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  卡片 3：GitHub 反馈规范  -->
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Padding="14,12"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        Data="{StaticResource InfoGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{DynamicResource Guide.GitHubIssue.Title}" />
                                                </StackPanel>
                                                <controls:TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.GitHubIssue.Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!--  卡片 4：开源项目参与  -->
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Padding="14,12"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                                    <Path
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        Data="{StaticResource SuccessGeometry}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        VerticalAlignment="Center" />
                                                    <controls:TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                        Text="{DynamicResource Guide.OpenSource.Title}" />
                                                </StackPanel>
                                                <controls:TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                    Text="{DynamicResource Guide.OpenSource.Description}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!--  底部协议确认卡片  -->
                                    <Border
                                        Margin="0,16,0,0"
                                        Padding="16,12"
                                        Background="{DynamicResource RegionBrushOpacity25}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <controls:TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="{DynamicResource Guide.Agreement.Prefix}" />
                                            <Grid
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                helper:GuideHighlight.IsActive="{c:Binding 'GuideStepIndex == 1 and !GuideUserAgreementOpened'}"
                                                helper:GuideHighlight.Mode="Frame">
                                                <controls:TextBlock>
                                                    <Hyperlink
                                                        Click="{s:Action OnGuideUserAgreementClick}"
                                                        Cursor="Hand"
                                                        NavigateUri="{Binding Source={x:Static constants:MaaUrls.UserAgreement}}"
                                                        TextDecorations="None">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Style="{StaticResource HyperlinkTextBlockStyle}"
                                                            Text="{DynamicResource Guide.Agreement.Link}" />
                                                    </Hyperlink>
                                                </controls:TextBlock>
                                            </Grid>
                                            <Button
                                                Margin="12,0,0,0"
                                                Padding="12,4"
                                                VerticalAlignment="Center"
                                                Command="{s:Action OnGuideUserAgreementClick}"
                                                Content="{DynamicResource Guide.Agreement.Confirm}"
                                                Visibility="{c:Binding '!GuideUserAgreementOpened'}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </hc:TransitioningContentControl>

                            <!--  步骤 2：游戏设置（客户端类型）  -->
                            <hc:TransitioningContentControl
                                Width="420"
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex == 2'}">
                                <Border
                                    Padding="28,24"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel HorizontalAlignment="Center" DataContext="{Binding GameSettings}">
                                        <controls:TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{DynamicResource Settings.Game.Title}"
                                            TextAlignment="Center" />
                                        <controls:TextBlock
                                            MaxWidth="360"
                                            Margin="0,8,0,18"
                                            FontSize="12"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{DynamicResource Guide.Game.ClientType.Tip}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <ComboBox
                                            Width="260"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            hc:InfoElement.Title="{DynamicResource Settings.Game.ClientType}"
                                            hc:TitleElement.HorizontalAlignment="Center"
                                            DisplayMemberPath="Display"
                                            ItemsSource="{Binding ClientTypeList}"
                                            SelectedValue="{Binding ClientType}"
                                            SelectedValuePath="Value" />
                                    </StackPanel>
                                </Border>
                            </hc:TransitioningContentControl>

                            <!--  步骤 3：连接设置  -->
                            <hc:TransitioningContentControl
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex == 3'}">
                                <StackPanel
                                    s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}"
                                    DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                                    <Border
                                        MaxWidth="{Binding ActualWidth, ElementName=GuideConnectSettings}"
                                        Margin="0,0,0,10"
                                        Padding="12,8"
                                        Background="{DynamicResource RegionBrushOpacity25}"
                                        BorderBrush="{DynamicResource InfoBrush}"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="0,4,4,0"
                                        Visibility="{c:Binding !IsPCConnectConfig}">
                                        <controls:TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{DynamicResource Guide.Clarification}"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <settings:ConnectSettingsUserControl x:Name="GuideConnectSettings" ShowAdvancedConnectSettings="False" />
                                </StackPanel>
                            </hc:TransitioningContentControl>

                            <!--  步骤 4：性能与推理设置  -->
                            <hc:TransitioningContentControl
                                Width="460"
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex == 4'}">
                                <Border
                                    Padding="28,24"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel
                                        s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}"
                                        DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.PerformanceSettings}}">
                                        <controls:TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{DynamicResource Settings.Performance.Title}"
                                            TextAlignment="Center" />
                                        <Border
                                            Margin="0,10,0,18"
                                            Padding="12,8"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            BorderBrush="{DynamicResource InfoBrush}"
                                            BorderThickness="2,0,0,0"
                                            CornerRadius="0,4,4,0">
                                            <controls:TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource SecondaryTextBrush}"
                                                Text="{DynamicResource Settings.Performance.UseGpuForInference.Tip}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <hc:ComboBox
                                            Width="320"
                                            HorizontalAlignment="Center"
                                            hc:InfoElement.Title="{DynamicResource Settings.Performance.UseGpuForInference}"
                                            hc:TitleElement.HorizontalAlignment="Center"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            DisplayMemberPath="Display"
                                            ItemsSource="{Binding GpuOptions}"
                                            PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                                                         Target={x:Type helper:MouseWheelHelper}}"
                                            SelectedItem="{Binding ActiveGpuOption}">
                                            <hc:ComboBox.ItemContainerStyle>
                                                <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="{x:Type ComboBoxItem}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDeprecated}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.AllowDeprecatedGpu, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </hc:ComboBox.ItemContainerStyle>
                                        </hc:ComboBox>
                                    </StackPanel>
                                </Border>
                            </hc:TransitioningContentControl>

                            <!--  步骤 5：任务设置与交互演示  -->
                        <hc:TransitioningContentControl
                            MinWidth="480"
                            d:Visibility="Collapsed"
                            TransitionMode="{Binding GuideTransitionMode}"
                            Visibility="{c:Binding 'GuideStepIndex == 5'}">
                            <!--  本步概览：先说明这一屏在教什么、练习数据不会落盘，再让用户动手  -->
                            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:TextBlock
                                    DockPanel.Dock="Top"
                                    MaxWidth="520"
                                    Margin="0,0,0,10"
                                    FontSize="12"
                                    Foreground="{DynamicResource ThirdlyTextBrush}"
                                    Text="{DynamicResource Guide.Demo.Overview}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="210"
                                    Margin="0,0,0,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <controls:TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        Text="{DynamicResource Guide.HoverActionButtons}"
                                        TextAlignment="Left"
                                        TextWrapping="Wrap" />
                                    <controls:TextBlock
                                        Grid.Row="1"
                                        FontSize="14"
                                        Text="{DynamicResource Guide.GearContextMenu.Tip}"
                                        TextAlignment="Right"
                                        TextWrapping="Wrap" />
                                    <!--  复制/删除在指引里恒灰，先用一行说明原因，避免新用户反复点  -->
                                    <controls:TextBlock
                                        Grid.Row="2"
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Text="{DynamicResource Guide.Demo.LockedOperations}"
                                        TextAlignment="Left"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!--  演示任务面板：列表与互动操作均为演示数据，与真实任务队列无关  -->
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="210"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl
                                            Grid.Row="0"
                                            MinHeight="140"
                                            Margin="0,10,0,8"
                                            HorizontalAlignment="Stretch"
                                            Background="Transparent"
                                            dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                                            dd:DragDrop.IsDragSource="{Binding GuideDemoDragAllowed}"
                                            dd:DragDrop.IsDropTarget="{Binding GuideDemoDragAllowed}"
                                            ItemsSource="{Binding GuideDemoTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        x:Name="GuideDemoItemBorder"
                                                        MinHeight="24.5"
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        helper:GuideHighlight.IsActive="{c:Binding 'IsMoveUpBadgeVisible or IsMoveDownBadgeVisible'}"
                                                        helper:GuideHighlight.Placement="Left"
                                                        helper:GuideHighlight.Text="{Binding GuideNextGateTip, Source={x:Static helper:Instances.SettingsViewModel}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!--  Column 0: CheckBox 拉伸填充可点击区域，名称与引导红点由叠加层展示（照真实任务项结构）  -->
                                                            <CheckBox
                                                                Grid.Column="0"
                                                                MaxWidth="140"
                                                                Margin="4.5,0,0,0"
                                                                HorizontalAlignment="Left"
                                                                IsChecked="{Binding IsChecked}">
                                                                <controls:TextBlock Text="{Binding Name}" Visibility="Hidden" />
                                                            </CheckBox>
                                                            <StackPanel
                                                                Grid.Column="0"
                                                                Margin="26,0,4,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                IsHitTestVisible="False"
                                                                Orientation="Horizontal">
                                                                <controls:TextBlock Text="{Binding Name}" />
                                                            </StackPanel>

                                                            <!--  Column 1: 悬浮显示的 复制/重命名/删除 与常驻齿轮（右键菜单），交互均落在演示列表  -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=GuideDemoItemBorder}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                                <!--  重命名步骤无需悬停，直接显示操作按钮以指明图标位置  -->
                                                                                <DataTrigger Binding="{Binding IsNameBadgeVisible}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource CopyTaskGeometry}"
                                                                        Command="{s:Action CopyGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="False"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Common.Copy}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource RenameTaskGeometry}"
                                                                        Command="{s:Action RenameGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        helper:GuideHighlight.IsActive="{Binding IsNameBadgeVisible}"
                                                                        helper:GuideHighlight.Placement="Right"
                                                                        helper:GuideHighlight.Text="{Binding GuideNextGateTip, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                                        IsEnabled="{Binding GuideRenameTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource TaskQueue.Rename}" />
                                                                    <Button
                                                                        hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                                        Command="{s:Action RemoveGuideDemoTask,
                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="False"
                                                                        Style="{StaticResource TaskActionButtonStyle}"
                                                                        ToolTip="{DynamicResource Common.Delete}" />
                                                                </StackPanel>
                                                                <Grid>
                                                                    <hc:ButtonGroup>
                                                                        <RadioButton
                                                                            Width="22"
                                                                            Margin="0,0,4,0"
                                                                            Padding="0"
                                                                            hc:VisualElement.HighlightBackground="Transparent"
                                                                            hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            GroupName="TaskSettings"
                                                                            helper:GuideHighlight.IsActive="{Binding IsGearBadgeVisible}"
                                                                            helper:GuideHighlight.Placement="Right"
                                                                            helper:GuideHighlight.Text="{Binding GuideNextGateTip, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                                            IsChecked="{Binding EnableSetting}"
                                                                            Style="{DynamicResource RadioGroupItemSingle}">
                                                                            <Grid Width="16" Height="16">
                                                                                <Path
                                                                                    Data="{StaticResource ConfigGeometry}"
                                                                                    Stretch="Uniform"
                                                                                    Visibility="{c:Binding !EnableSetting}">
                                                                                    <Path.Style>
                                                                                        <Style TargetType="Path">
                                                                                            <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Path.Style>
                                                                                </Path>
                                                                                <Path
                                                                                    Data="{StaticResource ConfigGeometry2}"
                                                                                    Fill="{DynamicResource PrimaryBrush}"
                                                                                    Stretch="Uniform"
                                                                                    Visibility="{c:Binding EnableSetting}" />
                                                                            </Grid>
                                                                            <RadioButton.ToolTip>
                                                                                <ToolTip>
                                                                                    <StackPanel>
                                                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.LeftClick}" />
                                                                                        <TextBlock Text="{DynamicResource TaskQueue.TaskSettings}" />

                                                                                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.RightClick}" />
                                                                                        <TextBlock>
                                                                                            <Run Text="{DynamicResource TaskQueue.RunOnce}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.RunFromHere}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.MoveUp}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.MoveDown}" /><Run Text="/" /><Run Text="{DynamicResource Common.Copy}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.Rename}" /><Run Text="/" /><Run Text="{DynamicResource Common.Delete}" />
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </ToolTip>
                                                                            </RadioButton.ToolTip>
                                                                            <RadioButton.ContextMenu>
                                                                                <ContextMenu Width="150">
                                                                                    <MenuItem Command="{s:Action StartGuideDemo, Target={x:Static helper:Instances.SettingsViewModel}}" Header="{DynamicResource TaskQueue.RunOnce}" />
                                                                                    <MenuItem Command="{s:Action StartGuideDemo, Target={x:Static helper:Instances.SettingsViewModel}}" Header="{DynamicResource TaskQueue.RunFromHere}" />
                                                                                    <MenuItem
                                                                                        Command="{s:Action MoveGuideDemoTaskUp,
                                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                        Header="{DynamicResource TaskQueue.MoveUp}"
                                                                                        IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                    <MenuItem
                                                                                        Command="{s:Action MoveGuideDemoTaskDown,
                                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                        Header="{DynamicResource TaskQueue.MoveDown}"
                                                                                        IsEnabled="{Binding PlacementTarget.DataContext.CanMoveDown, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                                    <MenuItem
                                                                                        Command="{s:Action CopyGuideDemoTask,
                                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                        Header="{DynamicResource Common.Copy}"
                                                                                        IsEnabled="False" />
                                                                                    <MenuItem
                                                                                        Command="{s:Action RenameGuideDemoTask,
                                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                        Header="{DynamicResource TaskQueue.Rename}"
                                                                                        IsEnabled="{Binding GuideRenameTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}" />
                                                                                    <MenuItem
                                                                                        Command="{s:Action RemoveGuideDemoTask,
                                                                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                                                                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                                        Header="{DynamicResource Common.Delete}"
                                                                                        IsEnabled="False" />
                                                                                </ContextMenu>
                                                                            </RadioButton.ContextMenu>
                                                                        </RadioButton>
                                                                    </hc:ButtonGroup>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Grid.Row="1" Margin="-1,0,-1,-1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                VerticalAlignment="Top">
                                                <controls:MenuButton
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    hc:BorderElement.CornerRadius="4,0,0,4"
                                                    hc:IconElement.Geometry="{StaticResource TaskQueueAddTaskIcon}"
                                                    AutomationProperties.Name="{DynamicResource TaskQueue.AddTask}"
                                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                                    helper:GuideHighlight.IsActive="{Binding GuideAddTaskBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                    helper:GuideHighlight.Placement="Left"
                                                    helper:GuideHighlight.Text="{Binding GuideNextGateTip, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                    IsEnabled="{Binding GuideAddTaskEnabled, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                    Style="{StaticResource MaaButtonDefaultStyle}"
                                                    ToolTip="{DynamicResource TaskQueue.AddTask}">
                                                    <controls:MenuButton.PopupContent>
                                                        <Border
                                                            Width="190"
                                                            Margin="8"
                                                            Padding="2,2,2,0"
                                                            Background="{DynamicResource RegionBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Effect="{DynamicResource EffectShadow2}">
                                                            <!--
                                                                本版 HandyControls 移除了原版 MenuAttach.ItemMinHeight（原 ContextMenu
                                                                隐式样式靠它把项撑到标准控件高度），Menu 的顶级项模板默认无最小高度，
                                                                需在容器样式显式补 MinHeight
                                                            -->
                                                            <Menu Padding="0" ItemsSource="{Binding TaskTypeList, Source={x:Static helper:Instances.TaskQueueViewModel}}">
                                                                <Menu.ItemContainerStyle>
                                                                    <Style BasedOn="{StaticResource MaaMenuItemDefaultStyle}" TargetType="MenuItem">
                                                                        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}" />
                                                                        <Setter Property="Command" Value="{Binding AddGuideDemoTaskCommand, Source={x:Static helper:Instances.SettingsViewModel}}" />
                                                                        <Setter Property="CommandParameter" Value="{Binding Value}" />
                                                                        <!--  Header 默认绑定整个条目，经 HeaderTemplate 渲染名称与引导红点  -->
                                                                        <Setter Property="HeaderTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                                                                                        <Border
                                                                                            x:Name="MenuGateHint"
                                                                                            Margin="8,0,0,0"
                                                                                            Padding="5,1"
                                                                                            VerticalAlignment="Center"
                                                                                            Background="{DynamicResource GuideBadgeBackgroundBrush}"
                                                                                            CornerRadius="3"
                                                                                            Visibility="Collapsed">
                                                                                            <TextBlock
                                                                                                FontSize="11"
                                                                                                Foreground="{DynamicResource GuideBadgeForegroundBrush}"
                                                                                                Text="{DynamicResource Guide.ClickHere}" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                    <DataTemplate.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding Value.Name}" Value="FightTask" />
                                                                                                <Condition Binding="{Binding GuideFightMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter TargetName="MenuGateHint" Property="Visibility" Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition Binding="{Binding Value.Name}" Value="SwitchThemeTask" />
                                                                                                <Condition Binding="{Binding GuideSwitchThemeMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter TargetName="MenuGateHint" Property="Visibility" Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                    </DataTemplate.Triggers>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Value.Name}" Value="FightTask" />
                                                                                    <Condition Binding="{Binding GuideFightMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="{DynamicResource GuideBadgeBackgroundBrush}" />
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Value.Name}" Value="SwitchThemeTask" />
                                                                                    <Condition Binding="{Binding GuideSwitchThemeMenuBadgeVisible, Source={x:Static helper:Instances.SettingsViewModel}}" Value="True" />
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Background" Value="{DynamicResource GuideBadgeBackgroundBrush}" />
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Menu.ItemContainerStyle>
                                                                <Menu.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Vertical" />
                                                                    </ItemsPanelTemplate>
                                                                </Menu.ItemsPanel>
                                                            </Menu>
                                                        </Border>
                                                    </controls:MenuButton.PopupContent>
                                                </controls:MenuButton>
                                            </Grid>
                                            <Button
                                                Grid.Column="1"
                                                Height="30"
                                                Margin="-1,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0"
                                                Command="{s:Action SelectAllGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource TaskQueue.SelectAll}" />
                                            <Button
                                                Grid.Column="2"
                                                Height="30"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                hc:BorderElement.CornerRadius="0,4,4,0"
                                                Command="{s:Action ClearGuideDemoTasks,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                Content="{DynamicResource Common.Clear}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <controls:TextBlock
                                    Grid.Row="2"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    FontSize="14"><Run Text="↑ " /><Run Text="{DynamicResource TaskQueue.AddTask}" /></controls:TextBlock>
                                <StackPanel
                                    Grid.Row="3"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="50"
                                        Margin="5"
                                        Command="{s:Action StartGuideDemo,
                                                           Target={x:Static helper:Instances.SettingsViewModel}}"
                                        Content="{DynamicResource TaskQueue.LinkStart}" />
                                    <controls:TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{DynamicResource Guide.LinkStart}" />
                                </StackPanel>

                                <!--  右：设置面板随齿轮选中的任务切换（选项随常规/高级切换），顶部与任务面板同行对齐  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{c:Binding !GuideDemoAdvancedSettings}">
                                    <controls:TextBlock
                                        Margin="0,20,0,0"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Text="{DynamicResource Guide.Demo.SettingsPlaceholder}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{c:Binding 'SelectedGuideDemoTask == null'}" />
                                    <!--  开始唤醒：是否启动客户端（演示）  -->
                                    <StackPanel
                                        Margin="0,20,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{c:Binding SelectedGuideDemoTask.IsStartUpTask}">
                                        <CheckBox Content="{DynamicResource Connection.LaunchClient}" IsChecked="{Binding SelectedGuideDemoTask.DemoStartGame}" />
                                        <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource TaskQueue.CheckBoxesNotSaved}" />
                                        <controls:TextBlock Text="←" TextWrapping="Wrap" />
                                        <controls:TextBlock
                                            MaxWidth="80"
                                            Margin="0,-10"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Guide.Tip}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!--  理智作战：关卡选择（演示）  -->
                                    <StackPanel Margin="0,20,0,0" Visibility="{c:Binding SelectedGuideDemoTask.IsFightTask}">
                                        <Grid>
                                            <ComboBox
                                                Height="30"
                                                DisplayMemberPath="Display"
                                                helper:GuideHighlight.IsActive="{c:Binding GuideStageBadgeVisible}"
                                                helper:GuideHighlight.Placement="Right"
                                                helper:GuideHighlight.Text="{Binding GuideNextGateTip}"
                                                IsEnabled="{c:Binding GuideStageEditingAllowed}"
                                                ItemsSource="{Binding GuideDemoStageList}"
                                                SelectedValue="{Binding SelectedGuideDemoTask.DemoStage}"
                                                SelectedValuePath="Value" />
                                        </Grid>
                                    </StackPanel>
                                    <!--  更换主题：主题名列表（演示）  -->
                                    <StackPanel
                                        Margin="0,20,0,0"
                                        HorizontalAlignment="Center"
                                        Visibility="{c:Binding SelectedGuideDemoTask.IsSwitchThemeTask}">
                                        <ItemsControl ItemsSource="{Binding SelectedGuideDemoTask.DemoThemes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            Width="150"
                                                            Height="30"
                                                            hc:InfoElement.Placeholder="{DynamicResource TaskQueue.SwitchTheme.Placeholder}"
                                                            IsEnabled="{Binding GuideThemeEditingAllowed, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Width="25"
                                                            Height="25"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                            hc:IconElement.Height="15"
                                                            hc:IconElement.Width="15"
                                                            Command="{s:Action RemoveGuideDemoTheme,
                                                                               Target={x:Static helper:Instances.SettingsViewModel}}"
                                                            CommandParameter="{Binding}"
                                                            IsEnabled="{Binding GuideThemeEditingAllowed, Source={x:Static helper:Instances.SettingsViewModel}}"
                                                            ToolTip="{DynamicResource Common.Delete}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid HorizontalAlignment="Center">
                                            <Button
                                                MinWidth="50"
                                                Command="{s:Action AddGuideDemoTheme,
                                                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                                                CommandParameter="{Binding SelectedGuideDemoTask}"
                                                Content="{DynamicResource TaskQueue.SwitchTheme.Add}"
                                                helper:GuideHighlight.IsActive="{c:Binding GuideThemeAddBadgeVisible}"
                                                helper:GuideHighlight.Placement="Right"
                                                helper:GuideHighlight.Text="{Binding GuideNextGateTip}"
                                                IsEnabled="{c:Binding GuideThemeEditingAllowed}" />
                                        </Grid>
                                    </StackPanel>
                                    <!--  其他任务类型：跟随指引提示  -->
                                    <controls:TextBlock
                                        Margin="0,20,0,0"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Text="{DynamicResource Guide.Demo.SettingsPlaceholder}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="{c:Binding 'SelectedGuideDemoTask != null and !SelectedGuideDemoTask.IsStartUpTask and !SelectedGuideDemoTask.IsFightTask and !SelectedGuideDemoTask.IsSwitchThemeTask'}" />
                                </StackPanel>
                                <!--  高级页：仅理智作战有演示内容（周计划），其余跟随指引提示  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="8,10,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{c:Binding GuideDemoAdvancedSettings}">
                                    <StackPanel Visibility="{c:Binding SelectedGuideDemoTask.IsFightTask}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox
                                                    Content="{DynamicResource TaskQueue.UseWeeklySchedule}"
                                                    helper:GuideHighlight.IsActive="{c:Binding GuideWeeklyBadgeVisible}"
                                                    helper:GuideHighlight.Placement="Right"
                                                    helper:GuideHighlight.Text="{Binding GuideNextGateTip}"
                                                    IsChecked="{Binding SelectedGuideDemoTask.DemoUseWeeklySchedule}"
                                                    IsEnabled="{c:Binding GuideWeeklyEditingAllowed}" />
                                                <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource TaskQueue.UseWeeklySchedule.Tip}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0" Visibility="{c:Binding SelectedGuideDemoTask.DemoUseWeeklySchedule}">
                                            <ListBox
                                                Height="150"
                                                HorizontalContentAlignment="Stretch"
                                                d:ItemsSource="{d:SampleData ItemCount=3}"
                                                IsEnabled="{c:Binding GuideWeeklyEditingAllowed}"
                                                ItemsSource="{Binding SelectedGuideDemoTask.DemoWeeklySchedule}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                Style="{DynamicResource NoSelectedHighlightListBoxStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                Content="{Binding Display}"
                                                                IsChecked="{Binding Value}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <!--  周计划步骤一次性框住前两项（周日、周一），避开右侧滚动条并贴合内容，气泡置于左侧开阔区  -->
                                            <Border
                                                Height="56"
                                                Margin="2,2,18,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                IsHitTestVisible="False"
                                                helper:GuideHighlight.IsActive="{c:Binding GuideWeekDaysBadgeVisible}"
                                                helper:GuideHighlight.Placement="Left"
                                                helper:GuideHighlight.Text="{Binding GuideNextGateTip}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center">
                                    <hc:ButtonGroup
                                        Width="220"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <RadioButton
                                            hc:BorderElement.CornerRadius="4,0,0,4"
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource TaskQueue.GeneralSettings}"
                                            IsChecked="{c:Binding !GuideDemoAdvancedSettings}" />
                                        <RadioButton
                                            hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                            Background="{DynamicResource RegionBrushOpacity25}"
                                            Content="{DynamicResource TaskQueue.AdvancedSettings}"
                                            helper:GuideHighlight.IsActive="{c:Binding GuideAdvancedBadgeVisible}"
                                            helper:GuideHighlight.Placement="Right"
                                            helper:GuideHighlight.Text="{Binding GuideNextGateTip}"
                                            IsChecked="{c:Binding GuideDemoAdvancedSettings}"
                                            IsEnabled="{c:Binding SelectedGuideDemoTask.IsFightTask}" />
                                    </hc:ButtonGroup>
                                </Grid>
                            </Grid>
                            </DockPanel>
                        </hc:TransitioningContentControl>

                            <hc:TransitioningContentControl
                                Width="440"
                                d:Visibility="Collapsed"
                                TransitionMode="{Binding GuideTransitionMode}"
                                Visibility="{c:Binding 'GuideStepIndex == 6'}">
                                <Border
                                    Padding="28,24"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel
                                        s:View.ActionTarget="{Binding DataContext, RelativeSource={RelativeSource Self}}"
                                        DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.VersionUpdateSettings}}">
                                        <controls:TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            Text="{DynamicResource Settings.Update.Title}"
                                            TextAlignment="Center" />
                                        <controls:TextBlock
                                            MaxWidth="360"
                                            Margin="0,8,0,18"
                                            FontSize="12"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{DynamicResource Guide.Update.Tip}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />

                                        <hc:UniformSpacingPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical"
                                            Spacing="14">
                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel
                                                    Margin="0,0,0,4"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <controls:TextBlock Text="{DynamicResource Settings.Update.Channel}" />
                                                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Update.Channel.Tip}" />
                                                </StackPanel>
                                                <hc:ComboBox
                                                    Width="240"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding VersionTypeList}"
                                                    SelectedValue="{Binding VersionType}"
                                                    SelectedValuePath="Value" />
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <StackPanel
                                                    Margin="0,0,0,4"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <controls:TextBlock Text="{DynamicResource Settings.Update.Source}" />
                                                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Update.Source.Tip}" />
                                                </StackPanel>
                                                <hc:ComboBox
                                                    Width="240"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding UpdateSourceList}"
                                                    SelectedValue="{Binding UpdateSource}"
                                                    SelectedValuePath="Value" />
                                            </StackPanel>

                                            <controls:UpdateCredentialInput Width="240" HorizontalAlignment="Center" />
                                        </hc:UniformSpacingPanel>
                                    </StackPanel>
                                </Border>
                            </hc:TransitioningContentControl>

                        </hc:SimplePanel>
                    </Grid>
                </ScrollViewer>
                <!--  聚光灯遮罩层：置于内容区，配合顶部 1px 分割线硬过渡，底部圆角与 GroupBox 框线对齐  -->
                <helper:GuideSpotlightOverlay />
            </Grid>
        </DockPanel>
    </GroupBox>

    <!--  跳过确认浮层：避免依赖系统弹窗，保证各主题下都有明确的确认/取消按钮  -->
    <Border Background="#99000000" Visibility="{c:Binding GuideSkipConfirmVisible}">
        <Border
            Width="440"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel>
                <controls:TextBlock
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{DynamicResource Guide.SkipPrompt}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="14,4"
                        Command="{s:Action CancelSkipGuide}"
                        Content="{DynamicResource Common.Cancel}" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="14,4"
                        Command="{s:Action ConfirmSkipGuide}"
                        Content="{DynamicResource Common.Confirm}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Grid>
</UserControl>