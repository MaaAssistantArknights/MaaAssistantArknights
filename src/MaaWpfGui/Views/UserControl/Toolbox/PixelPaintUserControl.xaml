<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Toolbox.PixelPaintUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    d:Background="White"
    d:DesignHeight="600"
    d:DesignWidth="800"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <!--  DataContext 继承宿主 ToolboxViewModel  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            IsEnabled="{c:Binding Run.Idle}">
            <Grid HorizontalAlignment="Stretch">
                <Border
                    Width="218"
                    Height="218"
                    AllowDrop="True"
                    Background="{DynamicResource RegionBrushOpacity25}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Cursor="SizeAll"
                    DragOver="{s:Action PixelPaintDragOver}"
                    Drop="{s:Action PixelPaintDrop}"
                    MouseLeftButtonDown="{s:Action PixelPaintPreviewMouseLeftButtonDown}"
                    MouseLeftButtonUp="{s:Action PixelPaintPreviewMouseLeftButtonUp}"
                    MouseMove="{s:Action PixelPaintPreviewMouseMove}"
                    PreviewMouseWheel="{s:Action PixelPaintPreviewMouseWheel}">
                    <Grid>
                        <Image
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            Source="{Binding PixelPaintPreview}"
                            Stretch="None" />
                        <controls:TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.65"
                            Text="{DynamicResource MiniGame@PixelPaint@DropHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{c:Binding 'PixelPaintPreview == null'}" />
                    </Grid>
                </Border>
            </Grid>
            <controls:TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Text="{Binding PixelPaintStatusText}"
                TextWrapping="Wrap"
                Visibility="{c:Binding 'PixelPaintStatusText.Length > 0'}" />
        </StackPanel>

        <hc:ScrollViewer
            Grid.Row="1"
            Margin="0,8,0,0"
            HorizontalScrollBarVisibility="Disabled"
            IsInertiaEnabled="True"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,0" IsEnabled="{c:Binding Run.Idle}">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Height="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        BorderThickness="1,1,0,1"
                        Command="{s:Action PixelPaintPickImage}">
                        <TextBlock
                            MaxWidth="50"
                            Text="{DynamicResource MiniGame@PixelPaint@PickImage}"
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Height="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="0,0,0,0"
                        BorderThickness="1,1,0,1"
                        Command="{s:Action PixelPaintResetView}">
                        <TextBlock
                            MaxWidth="50"
                            Text="{DynamicResource MiniGame@PixelPaint@ResetView}"
                            TextWrapping="Wrap" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Height="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        Command="{s:Action PixelPaintResetParameters}">
                        <TextBlock
                            MaxWidth="50"
                            Text="{DynamicResource MiniGame@PixelPaint@ResetParams}"
                            TextWrapping="Wrap" />
                    </Button>
                </Grid>

                <ComboBox
                    Margin="0,10,0,0"
                    hc:TitleElement.Title="{DynamicResource MiniGame@PixelPaint@Fit}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding PixelPaintFitModeList}"
                    SelectedValue="{Binding PixelPaintFitMode}"
                    SelectedValuePath="Value" />
                <ComboBox
                    Margin="0,10,0,0"
                    hc:TitleElement.Title="{DynamicResource MiniGame@PixelPaint@Dither}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding PixelPaintDitherModeList}"
                    SelectedValue="{Binding PixelPaintDitherMode}"
                    SelectedValuePath="Value" />
                <StackPanel Margin="0,10,0,0">
                    <controls:TextBlock
                        Margin="8,0,0,5"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource MiniGame@PixelPaint@Contrast}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="200"
                        Minimum="50"
                        TickFrequency="1"
                        Value="{Binding PixelPaintContrast}" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                    <controls:TextBlock
                        Margin="8,0,0,5"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource MiniGame@PixelPaint@Brightness}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="200"
                        Minimum="50"
                        TickFrequency="1"
                        Value="{Binding PixelPaintBrightness}" />
                </StackPanel>
                <StackPanel Margin="0,6,0,0">
                    <controls:TextBlock
                        Margin="8,0,0,5"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource MiniGame@PixelPaint@Saturation}" />
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="200"
                        Minimum="0"
                        TickFrequency="1"
                        Value="{Binding PixelPaintSaturation}" />
                </StackPanel>
                <CheckBox
                    Margin="0,10,0,0"
                    Content="{DynamicResource MiniGame@PixelPaint@PaintWhite}"
                    IsChecked="{Binding PixelPaintPaintWhite}" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource MiniGame@PixelPaint@Swipe}" IsChecked="{Binding PixelPaintSwipeEnabled}" />
                    <controls:TooltipBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        TooltipText="{DynamicResource MiniGame@PixelPaint@SwipeTip}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <controls:TextBlock VerticalAlignment="Center" Text="{DynamicResource MiniGame@PixelPaint@GridDelay}" />
                    <hc:NumericUpDown
                        Width="60"
                        Margin="6,0,0,0"
                        Increment="50"
                        Maximum="500"
                        Minimum="0"
                        Value="{Binding PixelPaintGridDelay}" />
                    <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource MiniGame@PixelPaint@GridDelayTip}" />
                </StackPanel>
                <controls:TextBlock
                    Margin="0,12,0,0"
                    Opacity="0.85"
                    Text="{Binding MiniGameTip}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
