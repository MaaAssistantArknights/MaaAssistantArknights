<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Toolbox.TutorialChallengeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:toolbox_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Toolbox"
    d:DataContext="{x:Static toolbox_vms:TutorialChallengeUserControlModel.Instance}"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <hc:ScrollViewer IsInertiaEnabled="True" PanningMode="Both">
        <StackPanel Margin="10">
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource TutorialChallenge.Introduction}" TextWrapping="Wrap" />
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Padding="8,2"
                        Background="{DynamicResource RegionBrushOpacity75}"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <!--  牛牛币图标暂用成就默认奖章刷占位，后续换专属资源  -->
                            <Ellipse
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource PrimaryBrush}" />
                            <controls:TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding CoinCount, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="8,0,0,0"
                        Padding="8,2"
                        Background="{DynamicResource RegionBrushOpacity75}"
                        CornerRadius="4">
                        <controls:TextBlock Text="{Binding ProgressText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding LevelItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type toolbox_vms:TutorialChallengeLevelItem}">
                        <Border
                            Margin="0,4"
                            Padding="10,8"
                            Background="{DynamicResource RegionBrushOpacity25}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <controls:TextBlock
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextBlockDefaultBold}"
                                        Text="{Binding Title}" />
                                    <controls:TextBlock
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{Binding Goal}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  完成徽章恒占位（Hidden 而非 Collapsed），避免达成时布局跳变；条件显隐用 DataTrigger，不走 Setter 内 c:Binding（CalcBinding 在 Setter 上下文拿不到目标属性类型会静默失效）  -->
                                    <Border
                                        MinWidth="58"
                                        Padding="8,2"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <controls:TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource RegionBrush}"
                                            Text="{DynamicResource TutorialChallenge.Completed}" />
                                    </Border>
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{s:Action StartLevel}"
                                        CommandParameter="{Binding}"
                                        Content="{DynamicResource TutorialChallenge.Enter}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
