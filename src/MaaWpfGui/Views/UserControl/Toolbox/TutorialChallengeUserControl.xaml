<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Toolbox.TutorialChallengeUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:toolbox_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Toolbox"
    d:DataContext="{x:Static toolbox_vms:TutorialChallengeUserControlModel.Instance}"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <hc:ScrollViewer IsInertiaEnabled="True" PanningMode="Both">
        <StackPanel Margin="10">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:TextBlock
                    VerticalAlignment="Center"
                    Text="{DynamicResource TutorialChallenge.Introduction}"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Padding="8,2"
                        Background="{DynamicResource RegionBrushOpacity75}"
                        CornerRadius="4">
                        <controls:TextBlock Text="{Binding ProgressText, Mode=OneWay}" />
                    </Border>
                    <StackPanel
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Orientation="Horizontal"
                        ToolTip="{DynamicResource TutorialChallenge.Coin}">
                        <!--  牛牛币图标暂用成就牛牛奖章，后续换专属资源  -->
                        <Path
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Data="{DynamicResource HangoverGeometry}"
                            Fill="{DynamicResource AchievementBrush.FeatureExploration}"
                            Stretch="Uniform" />
                        <controls:TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding CoinCount, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Margin="8,0,0,0"
                        Command="{s:Action OpenShop}"
                        Content="{DynamicResource TutorialChallenge.Shop.Title}" />
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                <hc:ButtonGroup VerticalAlignment="Center">
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Filter.All}"
                        IsChecked="{Binding IsStatusAll}" />
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Filter.Uncompleted}"
                        IsChecked="{Binding IsStatusUncompleted}" />
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Filter.Completed}"
                        IsChecked="{Binding IsStatusCompleted}" />
                </hc:ButtonGroup>
                <hc:ButtonGroup Margin="12,0,0,0" VerticalAlignment="Center">
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Filter.All}"
                        IsChecked="{Binding IsDifficultyAll}" />
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Difficulty.Low}"
                        IsChecked="{Binding IsDifficultyLow}" />
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Difficulty.Medium}"
                        IsChecked="{Binding IsDifficultyMedium}" />
                    <RadioButton
                        MinWidth="44"
                        Content="{DynamicResource TutorialChallenge.Difficulty.High}"
                        IsChecked="{Binding IsDifficultyHigh}" />
                </hc:ButtonGroup>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding LevelItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type toolbox_vms:TutorialChallengeLevelItem}">
                        <Border
                            Margin="0,4"
                            Padding="10,8"
                            Background="{DynamicResource RegionBrushOpacity25}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{c:Binding IsVisibleInFilter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource TextBlockDefaultBold}"
                                            Text="{Binding Title}" />
                                        <ItemsControl
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding CoinRewardIcons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path
                                                        Width="12"
                                                        Height="12"
                                                        Margin="1,0"
                                                        Data="{DynamicResource HangoverGeometry}"
                                                        Fill="{DynamicResource AchievementBrush.FeatureExploration}"
                                                        Stretch="Uniform" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <controls:TextBlock
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{Binding Goal}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  完成徽章恒占位（Hidden 而非 Collapsed），避免达成时布局跳变  -->
                                    <Border
                                        MinWidth="58"
                                        Padding="8,2"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <controls:TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TextIconBrush}"
                                            Text="{DynamicResource TutorialChallenge.Completed}" />
                                    </Border>
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{s:Action StartLevel}"
                                        CommandParameter="{Binding}"
                                        Content="{DynamicResource TutorialChallenge.Enter}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
