<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.RoguelikeTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:converters="clr-namespace:MaaWpfGui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:local="clr-namespace:MaaWpfGui.Views.UserControl.TaskQueue"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:task="clr-namespace:MaaWpfGui.Configuration.Single.MaaTask"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:RoguelikeTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:OperAvatarConverter x:Key="OperAvatarConverter" />
        <converters:OperNameBadgeConverter x:Key="OperNameBadgeConverter" />
    </UserControl.Resources>
    <StackPanel>
        <StackPanel
            d:Visibility="Visible"
            IsEnabled="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
            Visibility="{c:Binding !EnableAdvancedSettings,
                                   Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <hc:ComboBox
                Margin="0,3"
                hc:InfoElement.Title="{DynamicResource Roguelike.Theme}"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                ItemsSource="{Binding RoguelikeThemeList}"
                SelectedValue="{Binding RoguelikeTheme}"
                SelectedValuePath="Value" />
            <StackPanel Margin="0,3">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.Difficulty}" />
                    <controls:TooltipBlock
                        d:Visibility="Visible"
                        TooltipText="{DynamicResource Roguelike.JieGarden.Difficulty.Tip}"
                        Visibility="{c:Binding '(RoguelikeMode == task:RoguelikeMode.Investment) and (RoguelikeTheme == task:RoguelikeTheme.JieGarden)',
                                               Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
                </StackPanel>
                <hc:ComboBox
                    DisplayMemberPath="Display"
                    IsHitTestVisible="{Binding Path=Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding RoguelikeDifficultyList}"
                    ScrollViewer.CanContentScroll="False"
                    SelectedValue="{Binding RoguelikeDifficulty}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <hc:ComboBox
                Margin="0,3"
                hc:InfoElement.Title="{DynamicResource Roguelike.Strategy}"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Path=Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding RoguelikeModeList}"
                SelectedValue="{Binding RoguelikeMode}"
                SelectedValuePath="Value" />
            <hc:ComboBox
                Margin="0,3"
                d:Visibility="Visible"
                hc:InfoElement.Title="{DynamicResource Roguelike.CollectibleMode.Squad}"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding RoguelikeSquadList}"
                MaxDropDownHeight="800"
                SelectedValue="{Binding RoguelikeCollectibleModeSquad}"
                SelectedValuePath="Value"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Collectible',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel Margin="0,3" Visibility="{c:Binding 'RoguelikeMode != task:RoguelikeMode.Squad', Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.StartingSquad}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.FastFlight.Lock.Tip}" Visibility="{c:Binding RoguelikeBlackFlowExpFlightActive}" />
                </StackPanel>
                <hc:ComboBox
                    DisplayMemberPath="Display"
                    IsEnabled="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding RoguelikeSquadList}"
                    MaxDropDownHeight="800"
                    SelectedValue="{Binding RoguelikeSquad}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Margin="0,3">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.StartingRoles}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.FastFlight.Lock.Tip}" Visibility="{c:Binding RoguelikeBlackFlowExpFlightActive}" />
                </StackPanel>
                <hc:ComboBox
                    DisplayMemberPath="Display"
                    IsEnabled="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding RoguelikeRolesList}"
                    SelectedValue="{Binding RoguelikeRoles}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <hc:ComboBox
                Margin="0,3"
                d:Visibility="Visible"
                hc:InfoElement.Title="{DynamicResource Roguelike.FindPlaytimeTarget}"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                ItemsSource="{Binding RoguelikeFindPlaytimeTargetList}"
                SelectedValue="{Binding RoguelikeFindPlaytimeTarget}"
                SelectedValuePath="Value"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.FindPlaytime and RoguelikeTheme == task:RoguelikeTheme.JieGarden',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel Margin="0,3" IsEnabled="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.StartingCoreChar}" />
                    <controls:TooltipBlock TooltipText="{Binding StartingCoreCharTip}" Visibility="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.FastFlight.Lock.Tip}" Visibility="{c:Binding RoguelikeBlackFlowExpFlightActive}" />
                    <controls:TextBlock
                        MaxWidth="100"
                        Margin="4,0,0,0"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{DynamicResource Roguelike.Theme.Recommended.Tip}"
                        TextWrapping="Wrap"
                        Visibility="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}" />
                </StackPanel>
                <Grid>
                    <hc:ComboBox
                        Name="StartingCoreCharComboBox"
                        Margin="0,3"
                        Padding="28,5,10,5"
                        DropDownClosed="CoreCharComboBox_DropDownClosed"
                        IsEditable="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding RoguelikeCoreCharList}"
                        Loaded="{s:Action MakeComboBoxSearchable,
                                          Target={x:Type ui_vms:SettingsViewModel}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Converter={StaticResource OperNameBadgeConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <hc:ComboBox.Text>
                            <Binding Path="RoguelikeCoreChar" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:StartingCoreCharRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:ComboBox.Text>
                    </hc:ComboBox>
                    <!--  选中干员头像：IsEditable ComboBox 收起态显示区是纯文本 TextBox 无法内嵌图片，以不命中浮层贴在框内左侧，ComboBox 用 Padding 为其让出文本起点  -->
                    <Image
                        Width="16"
                        Height="16"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Source="{Binding RoguelikeCoreChar, Converter={StaticResource OperAvatarConverter}}" />
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,3" Visibility="{c:Binding RoguelikeEnableAdditionalCoreChars}">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.StartingCoreChar2}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.FastFlight.Lock.Tip}" Visibility="{c:Binding RoguelikeBlackFlowExpFlightActive}" />
                </StackPanel>
                <Grid IsEnabled="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}">
                    <hc:ComboBox
                        Name="StartingCoreChar2ComboBox"
                        Padding="28,5,10,5"
                        DropDownClosed="CoreCharComboBox_DropDownClosed"
                        IsEditable="True"
                        IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot;'}"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding RoguelikeCoreCharList}"
                        Loaded="{s:Action MakeComboBoxSearchable,
                                          Target={x:Type ui_vms:SettingsViewModel}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Converter={StaticResource OperNameBadgeConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <hc:ComboBox.Text>
                            <Binding Path="RoguelikeCoreChar2" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:StartingCoreCharRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:ComboBox.Text>
                    </hc:ComboBox>
                    <!--  选中干员头像：IsEditable ComboBox 收起态显示区是纯文本 TextBox 无法内嵌图片，以不命中浮层贴在框内左侧，ComboBox 用 Padding 为其让出文本起点  -->
                    <Image
                        Width="16"
                        Height="16"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Source="{Binding RoguelikeCoreChar2, Converter={StaticResource OperAvatarConverter}}" />
                </Grid>
            </StackPanel>
            <StackPanel Margin="0,3" Visibility="{c:Binding RoguelikeEnableAdditionalCoreChars}">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.StartingCoreChar3}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.FastFlight.Lock.Tip}" Visibility="{c:Binding RoguelikeBlackFlowExpFlightActive}" />
                </StackPanel>
                <Grid IsEnabled="{c:Binding '!RoguelikeBlackFlowExpFlightActive'}">
                    <hc:ComboBox
                        Name="StartingCoreChar3ComboBox"
                        Padding="28,5,10,5"
                        DropDownClosed="CoreCharComboBox_DropDownClosed"
                        IsEditable="True"
                        IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot; and RoguelikeCoreChar2 != &quot;&quot;'}"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding RoguelikeCoreCharList}"
                        Loaded="{s:Action MakeComboBoxSearchable,
                                          Target={x:Type ui_vms:SettingsViewModel}}">
                        <hc:ComboBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding Converter={StaticResource OperNameBadgeConverter}}" />
                            </DataTemplate>
                        </hc:ComboBox.ItemTemplate>
                        <hc:ComboBox.Text>
                            <Binding Path="RoguelikeCoreChar3" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <local:StartingCoreCharRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:ComboBox.Text>
                    </hc:ComboBox>
                    <!--  选中干员头像：IsEditable ComboBox 收起态显示区是纯文本 TextBox 无法内嵌图片，以不命中浮层贴在框内左侧，ComboBox 用 Padding 为其让出文本起点  -->
                    <Image
                        Width="16"
                        Height="16"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Source="{Binding RoguelikeCoreChar3, Converter={StaticResource OperAvatarConverter}}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel
            d:Visibility="Visible"
            IsEnabled="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
            Visibility="{c:Binding EnableAdvancedSettings,
                                   Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <hc:NumericUpDown
                Margin="0,5"
                hc:InfoElement.Title="{DynamicResource Roguelike.StartTimesLimit}"
                Maximum="99999"
                Minimum="0"
                Value="{Binding RoguelikeStartsCount}" />
            <CheckBox
                Margin="0,5"
                d:IsEnabled="True"
                Content="{DynamicResource Roguelike.InvestmentEnabled}"
                IsChecked="{Binding RoguelikeInvestmentEnabled}"
                IsEnabled="{c:Binding 'RoguelikeMode != task:RoguelikeMode.Investment',
                                      Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel
                Margin="0,5"
                d:Visibility="Visible"
                Orientation="Horizontal"
                Visibility="{c:Binding 'RoguelikeTheme == task:RoguelikeTheme.BlackFlow and RoguelikeMode == task:RoguelikeMode.BlackFlowStartRun',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <CheckBox IsChecked="{Binding RoguelikeBlackFlowStartRunFastFlight}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.BlackFlow.FastFlight}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.PrepFlight.Tip}" />
                <controls:TextBlock
                    Margin="4,0,0,0"
                    Foreground="{DynamicResource InfoBrush}"
                    Text="{DynamicResource Roguelike.BlackFlow.FlightRequirement}" />
            </StackPanel>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeStopWhenInvestmentFull}"
                Visibility="{c:Binding 'RoguelikeInvestmentEnabled and RoguelikeMode == task:RoguelikeMode.Investment',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.StopOnGoldLimit}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeInvestmentWithMoreScoreRaw}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Investment and RoguelikeTheme != task:RoguelikeTheme.BlackFlow',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.InvestmentWithMoreScore}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeCollectibleModeShopping}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Collectible',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.CollectibleMode.Shopping}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <hc:NumericUpDown
                Margin="0,5"
                d:Visibility="Visible"
                hc:InfoElement.Title="{DynamicResource Roguelike.GoldTimesLimit}"
                Maximum="999"
                Minimum="0"
                Visibility="{c:Binding 'RoguelikeInvestmentEnabled and RoguelikeMode == task:RoguelikeMode.Investment',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}"
                Value="{Binding RoguelikeInvestsCount}" />
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                Content="{DynamicResource Roguelike.RefreshTraderWithDice}"
                IsChecked="{Binding RoguelikeRefreshTraderWithDiceRaw}"
                Visibility="{c:Binding 'RoguelikeTheme == task:RoguelikeTheme.Mizuki',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel>
                <CheckBox
                    Margin="0,5"
                    d:Visibility="Visible"
                    IsChecked="{Binding RoguelikeStartWithEliteTwo}"
                    Visibility="{c:Binding '(RoguelikeSquadIsProfessional) and ((RoguelikeTheme == task:RoguelikeTheme.Mizuki) or (RoguelikeTheme == task:RoguelikeTheme.Sami))',
                                           Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.StartWithEliteTwo}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox
                    Margin="0,5"
                    d:Visibility="Visible"
                    IsChecked="{Binding RoguelikeOnlyStartWithEliteTwoRaw}"
                    Visibility="{c:Binding '(RoguelikeStartWithEliteTwo) and (RoguelikeMode == task:RoguelikeMode.Collectible) and ((RoguelikeTheme == task:RoguelikeTheme.Mizuki) or (RoguelikeTheme == task:RoguelikeTheme.Sami))',
                                           Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.OnlyStartWithEliteTwo}"
                        TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>

            <hc:CheckComboBox
                Margin="0,5"
                d:Visibility="Visible"
                hc:ListBoxAttach.SelectedItems="{Binding RoguelikeStartWithSelectList}"
                hc:TitleElement.Title="{DynamicResource Roguelike.StartWithSelectList}"
                DisplayMemberPath="Display"
                ItemsSource="{Binding RoguelikeStartAwards}"
                SelectedValuePath="Value"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Collectible and !RoguelikeOnlyStartWithEliteTwo',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel
                Margin="0,5"
                d:Visibility="Visible"
                Orientation="Horizontal"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Collectible and RoguelikeTheme == task:RoguelikeTheme.Sami',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=Roguelike3FirstFloorFoldartalTipTooltipBlock}" IsChecked="{Binding Roguelike3FirstFloorFoldartal}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.Sami.FirstFloorFoldartal}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="Roguelike3FirstFloorFoldartalTipTooltipBlock" TooltipText="{DynamicResource Roguelike.Sami.FirstFloorFoldartal.Tip}" />
            </StackPanel>
            <hc:TextBox
                d:Visibility="Visible"
                IsReadOnly="{c:Binding !Run.Idle,
                                       Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Roguelike3FirstFloorFoldartals}"
                Visibility="{c:Binding 'Roguelike3FirstFloorFoldartal and RoguelikeMode == task:RoguelikeMode.Collectible and RoguelikeTheme == task:RoguelikeTheme.Sami',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}" />
            <StackPanel
                Margin="0,5"
                Orientation="Horizontal"
                Visibility="{c:Binding RoguelikeSquadIsFoldartal}">
                <CheckBox Grid.Column="0" IsChecked="{Binding Roguelike3NewSquad2StartingFoldartal}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.Sami.NewSquad2Foldartal}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock Grid.Column="1" TooltipText="{DynamicResource Roguelike.Sami.NewSquad2Foldartal.Tip}" />
            </StackPanel>

            <TextBox
                IsReadOnly="{c:Binding !Run.Idle,
                                       Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                Text="{Binding Roguelike3NewSquad2StartingFoldartals}"
                Visibility="{c:Binding 'Roguelike3NewSquad2StartingFoldartal and RoguelikeSquadIsFoldartal'}" />

            <Grid d:Visibility="Visible" Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.CLP_PDS', Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <controls:TextBlock
                        MaxWidth="{c:Binding '220 - 8 - ActualWidth',
                                             ElementName=RoguelikeCollapseListTipTooltipBlock}"
                        Margin="8,0,0,0"
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.CollapseList}"
                        TextWrapping="Wrap" />
                    <controls:TooltipBlock x:Name="RoguelikeCollapseListTipTooltipBlock" TooltipText="{DynamicResource Roguelike.CollapseList.Tip}" />
                </StackPanel>
                <hc:TextBox
                    Grid.Row="1"
                    IsReadOnly="{c:Binding !Run.Idle,
                                           Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    Text="{Binding RoguelikeExpectedCollapsalParadigms}" />
            </Grid>

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=RoguelikeEnableAdditionalCoreCharTooltipBlock}" IsChecked="{Binding RoguelikeEnableAdditionalCoreChars}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.EnableAdditionalStartingCoreChar}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="RoguelikeEnableAdditionalCoreCharTooltipBlock" TooltipText="{DynamicResource Roguelike.EnableAdditionalStartingCoreChar.Tip}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox
                    MaxWidth="{c:Binding '220 - ActualWidth',
                                         ElementName=RoguelikeRequireStartingCoreCharTooltipBlock}"
                    Margin="0,5"
                    Content="{Binding RoguelikeUseSupportUnitText}"
                    IsChecked="{Binding RoguelikeUseSupportUnit}"
                    IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot;'}" />
                <controls:TooltipBlock
                    x:Name="RoguelikeRequireStartingCoreCharTooltipBlock"
                    TooltipText="{DynamicResource Roguelike.RequireStartingCoreChar}"
                    Visibility="{c:Binding 'RoguelikeCoreChar == &quot;&quot;'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{c:Binding RoguelikeEnableAdditionalCoreChars}">
                <CheckBox
                    MaxWidth="{c:Binding '220 - ActualWidth',
                                         ElementName=RoguelikeRequireStartingCoreChar2TooltipBlock}"
                    Margin="0,5"
                    Content="{Binding RoguelikeCoreChar2UseSupportText}"
                    IsChecked="{Binding RoguelikeCoreChar2UseSupport}"
                    IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot; and RoguelikeCoreChar2 != &quot;&quot;'}" />
                <controls:TooltipBlock
                    x:Name="RoguelikeRequireStartingCoreChar2TooltipBlock"
                    TooltipText="{DynamicResource Roguelike.RequireStartingCoreChar}"
                    Visibility="{c:Binding 'RoguelikeCoreChar == &quot;&quot; or RoguelikeCoreChar2 == &quot;&quot;'}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{c:Binding RoguelikeEnableAdditionalCoreChars}">
                <CheckBox
                    MaxWidth="{c:Binding '220 - ActualWidth',
                                         ElementName=RoguelikeRequireStartingCoreChar3TooltipBlock}"
                    Margin="0,5"
                    Content="{Binding RoguelikeCoreChar3UseSupportText}"
                    IsChecked="{Binding RoguelikeCoreChar3UseSupport}"
                    IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot; and RoguelikeCoreChar2 != &quot;&quot; and RoguelikeCoreChar3 != &quot;&quot;'}" />
                <controls:TooltipBlock
                    x:Name="RoguelikeRequireStartingCoreChar3TooltipBlock"
                    TooltipText="{DynamicResource Roguelike.RequireStartingCoreChar}"
                    Visibility="{c:Binding 'RoguelikeCoreChar == &quot;&quot; or RoguelikeCoreChar2 == &quot;&quot; or RoguelikeCoreChar3 == &quot;&quot;'}" />
            </StackPanel>
            <CheckBox
                Margin="0,5"
                IsChecked="{Binding RoguelikeEnableNonfriendSupport}"
                IsEnabled="{c:Binding 'RoguelikeCoreChar != &quot;&quot; or RoguelikeCoreChar2 != &quot;&quot; or RoguelikeCoreChar3 != &quot;&quot;'}"
                Visibility="{c:Binding 'RoguelikeUseSupportUnit or (RoguelikeEnableAdditionalCoreChars and (RoguelikeCoreChar2UseSupport or RoguelikeCoreChar3UseSupport))'}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.UseNonFriendSupport}"
                    TextWrapping="Wrap" />
            </CheckBox>

            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeStopAtFinalBoss}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Exp and RoguelikeTheme != task:RoguelikeTheme.Phantom',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.StopAtFinalBoss}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeMonthlySquadAutoIterate}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Squad',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.MonthlySquad.AutoIterate}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel
                Margin="0,5"
                d:Visibility="Visible"
                Orientation="Horizontal"
                Visibility="{c:Binding 'RoguelikeMonthlySquadAutoIterate and RoguelikeMode == task:RoguelikeMode.Squad',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <CheckBox IsChecked="{Binding RoguelikeMonthlySquadCheckComms}">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.MonthlySquad.CheckComms}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.MonthlySquad.CheckComms.Tip}" />
            </StackPanel>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeDeepExplorationAutoIterate}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Exploration',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.DeepExploration.AutoIterate}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,5"
                d:Visibility="Visible"
                IsChecked="{Binding RoguelikeStopAtMaxLevel}"
                Visibility="{c:Binding 'RoguelikeMode == task:RoguelikeMode.Exp',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.StopAtMaxLevel}"
                    TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox
                Margin="0,5"
                IsChecked="{Binding RoguelikeStartWithSeed}"
                Visibility="{c:Binding 'RoguelikeTheme == task:RoguelikeTheme.JieGarden',
                                       Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Block.TextAlignment="Left"
                        Text="{DynamicResource Roguelike.StartWithSeed}"
                        TextWrapping="Wrap" />
                    <controls:TooltipBlock Margin="4,0,0,0" TooltipText="{DynamicResource Roguelike.StartWithSeed.Tip}" />
                </StackPanel>
            </CheckBox>
            <hc:TextBox
                x:Name="RoguelikeSeedTextBox"
                Margin="0,2,0,10"
                Visibility="{c:Binding RoguelikeStartWithSeed}">
                <hc:TextBox.Text>
                    <Binding Path="RoguelikeSeed" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <hc:RegexRule Pattern="^[\da-zA-Z]+,rogue_\d+,\d+$" />
                        </Binding.ValidationRules>
                    </Binding>
                </hc:TextBox.Text>
            </hc:TextBox>
            <StackPanel d:Visibility="Visible" Visibility="{c:Binding 'RoguelikeTheme == task:RoguelikeTheme.BlackFlow and RoguelikeMode == task:RoguelikeMode.Exp', Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding RoguelikeBlackFlowFastFlight}">
                        <TextBlock
                            Block.TextAlignment="Left"
                            Text="{DynamicResource Roguelike.BlackFlow.FastFlight}"
                            TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.Flight.Tip}" />
                    <controls:TextBlock
                        Margin="4,0,0,0"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{DynamicResource Roguelike.BlackFlow.FlightRequirement}" />
                </StackPanel>
                <StackPanel Margin="0,5">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.BlackFlow.Ending}" />
                        <controls:TooltipBlock
                            d:Visibility="Visible"
                            TooltipText="{DynamicResource Roguelike.BlackFlow.EndingFlight.Tip}"
                            Visibility="{c:Binding RoguelikeBlackFlowFastFlight}" />
                    </StackPanel>
                    <hc:ComboBox
                        DisplayMemberPath="Display"
                        IsEnabled="{c:Binding '!RoguelikeBlackFlowFastFlight'}"
                        IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                        ItemsSource="{Binding RoguelikeBlackFlowEndingList}"
                        SelectedValue="{Binding RoguelikeBlackFlowEnding}"
                        SelectedValuePath="Value" />
                </StackPanel>
            </StackPanel>
            <StackPanel d:Visibility="Visible" Visibility="{c:Binding 'RoguelikeTheme == task:RoguelikeTheme.BlackFlow and RoguelikeMode == task:RoguelikeMode.BlackFlowStartRun', Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                <hc:ComboBox
                    Margin="0,5"
                    hc:InfoElement.Title="{DynamicResource Roguelike.BlackFlow.StartAnimal1}"
                    DisplayMemberPath="Display"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding RoguelikeBlackFlowStartAnimal1List}"
                    SelectedValue="{Binding RoguelikeBlackFlowStartAnimal1}"
                    SelectedValuePath="Value">
                    <hc:ComboBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        </Style>
                    </hc:ComboBox.ItemContainerStyle>
                </hc:ComboBox>
                <hc:ComboBox
                    Margin="0,5"
                    hc:InfoElement.Title="{DynamicResource Roguelike.BlackFlow.StartAnimal2}"
                    DisplayMemberPath="Display"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                    ItemsSource="{Binding RoguelikeBlackFlowStartAnimal2List}"
                    SelectedValue="{Binding RoguelikeBlackFlowStartAnimal2}"
                    SelectedValuePath="Value">
                    <hc:ComboBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        </Style>
                    </hc:ComboBox.ItemContainerStyle>
                </hc:ComboBox>
                <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                    <controls:TextBlock Margin="8,0,0,0" Text="{DynamicResource Roguelike.BlackFlow.StartRewards}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.StartRewards.Tip}" />
                    <controls:TextBlock
                        Margin="4,0,0,0"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{DynamicResource Roguelike.BlackFlow.StartRewards.AnyHit}" />
                </StackPanel>
                <hc:CheckComboBox
                    Margin="0,0,0,5"
                    hc:ListBoxAttach.SelectedItems="{Binding RoguelikeBlackFlowStartRewardSelectList}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding RoguelikeBlackFlowStartRewardList}"
                    SelectedValuePath="Value">
                    <hc:CheckComboBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource CheckComboBoxItemBaseStyle}" TargetType="hc:CheckComboBoxItem">
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        </Style>
                    </hc:CheckComboBox.ItemContainerStyle>
                </hc:CheckComboBox>
                <hc:CheckComboBox
                    Margin="0,5"
                    hc:ListBoxAttach.SelectedItems="{Binding RoguelikeBlackFlowSerpentRewardSelectList}"
                    hc:TitleElement.Title="{DynamicResource Roguelike.BlackFlow.SerpentRewards}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding RoguelikeBlackFlowSerpentRewardList}"
                    SelectedValuePath="Value"
                    Visibility="{c:Binding RoguelikeBlackFlowHasSerpent}">
                    <hc:CheckComboBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource CheckComboBoxItemBaseStyle}" TargetType="hc:CheckComboBoxItem">
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                        </Style>
                    </hc:CheckComboBox.ItemContainerStyle>
                </hc:CheckComboBox>
                <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                    <CheckBox
                        MaxWidth="{c:Binding '220 - ActualWidth',
                                             ElementName=RoguelikeBlackFlowStartUtopiaTooltipBlock}"
                        IsChecked="{Binding RoguelikeBlackFlowStartUtopia}"
                        IsEnabled="{Binding RoguelikeBlackFlowStartUtopiaAvailable}">
                        <TextBlock
                            Block.TextAlignment="Left"
                            Text="{DynamicResource Roguelike.BlackFlow.StartUtopia}"
                            TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock x:Name="RoguelikeBlackFlowStartUtopiaTooltipBlock" TooltipText="{DynamicResource Roguelike.BlackFlow.StartUtopia.Tip}" />
                </StackPanel>
                <StackPanel
                    Margin="0,5"
                    d:Visibility="Visible"
                    Visibility="{c:Binding 'RoguelikeBlackFlowStartUtopia and RoguelikeBlackFlowStartUtopiaAvailable',
                                           Source={x:Static taskQueue_vms:RoguelikeTaskUserControlModel.Instance}}">
                    <StackPanel Margin="8,0,0,5" Orientation="Horizontal">
                        <controls:TextBlock Text="{DynamicResource Roguelike.BlackFlow.StartRewardPriority}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource Roguelike.BlackFlow.StartRewardPriority.Tip}" />
                    </StackPanel>
                    <ListBox
                        Height="180"
                        Padding="0"
                        d:ItemsSource="{d:SampleData ItemCount=12}"
                        dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        BorderThickness="1"
                        ItemsSource="{Binding RoguelikeBlackFlowStartRewardPriorityItems}"
                        PreviewMouseWheel="{s:Action RouteMouseWheelToParentExceptScrollable,
                                                     Target={x:Type helper:MouseWheelHelper}}"
                        Style="{StaticResource NoSelectedHighlightListBoxStyle}"
                        VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}" TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding Reward.Tip}" />
                                <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{c:Binding 'Index + 1'}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="4,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Reward.Display}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <hc:ComboBox
                    Margin="0,5"
                    hc:InfoElement.Title="{DynamicResource Roguelike.CollectibleMode.Squad}"
                    DisplayMemberPath="Display"
                    IsEnabled="{c:Binding '!RoguelikeBlackFlowStartRunFastFlight'}"
                    ItemsSource="{Binding RoguelikeSquadList}"
                    MaxDropDownHeight="800"
                    SelectedValue="{Binding RoguelikeBlackFlowPrepSquadView}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <controls:TextBlock
                Margin="0,5"
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Text="{DynamicResource TaskQueue.MultiTasksShare.Tip}"
                TextAlignment="Left"
                TextWrapping="Wrap" />
            <CheckBox Margin="0,5" IsChecked="{Binding RoguelikeDelayAbortUntilCombatComplete}">
                <TextBlock
                    Block.TextAlignment="Left"
                    Text="{DynamicResource Roguelike.DelayAbortUntilCombatComplete}"
                    TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
    </StackPanel>
</UserControl>
