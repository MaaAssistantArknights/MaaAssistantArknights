<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.AutoRaiseSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    MaxWidth="360"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:AutoRaiseSettingsUserControlModel}}"
    d:DesignWidth="360"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <!--  常规设置  -->
        <StackPanel Visibility="{c:Binding '!EnableAdvancedSettings', Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <!--  在线编辑计划链接  -->
            <controls:TextBlock Margin="0,0,0,8">
                <Hyperlink
                    Cursor="Hand"
                    NavigateUri="{Binding Source={x:Static constants:MaaUrls.ArknightsToolbox}}"
                    TextDecorations="None">
                    <TextBlock
                        Style="{StaticResource HyperlinkTextBlockStyle}"
                        Text="{DynamicResource AutoRaiseOnlineEditor}" />
                </Hyperlink>
            </controls:TextBlock>

            <!--  粘贴并解析协议  -->
            <TextBox
                MinWidth="210"
                Height="64"
                AcceptsReturn="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                Text="{Binding PlanJson, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{s:Action ParsePlan}"
                Content="{DynamicResource AutoRaiseParsePlan}" />

            <!--  干员选择与添加培养目标  -->
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <controls:TextBlock VerticalAlignment="Center" Text="{DynamicResource AutoRaiseSelectOperator}" />
                <hc:ComboBox
                    Width="110"
                    Margin="6,0,0,0"
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding OperatorNames}"
                    Loaded="{s:Action MakeComboBoxSearchable,
                                      Target={x:Type ui_vms:SettingsViewModel}}">
                    <hc:ComboBox.Text>
                        <Binding Path="SelectedOperator" UpdateSourceTrigger="PropertyChanged" />
                    </hc:ComboBox.Text>
                </hc:ComboBox>
                <Button
                    x:Name="AddTargetButton"
                    MinWidth="60"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    Command="{s:Action OpenTargetPopup}"
                    Content="{DynamicResource AutoRaiseAddTarget}"
                    IsEnabled="{Binding CanAddOperator}"
                    ToolTip="{DynamicResource AutoRaiseOperatorLimit}"
                    ToolTipService.ShowOnDisabled="True" />
            </StackPanel>

            <controls:TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource TraceLogBrush}"
                Text="{Binding ValidationMessage}"
                TextWrapping="Wrap" />
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PlanPreviewItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Margin="0,2"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="{DynamicResource AutoRaiseEdit}">
                            <Grid.InputBindings>
                                <MouseBinding
                                    Command="{s:Action EditOperator}"
                                    CommandParameter="{Binding}"
                                    Gesture="LeftClick" />
                            </Grid.InputBindings>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Index}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="4,0"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Target}" />
                            <Button
                                Grid.Column="3"
                                Width="18"
                                Height="18"
                                MinWidth="18"
                                Margin="6,0,0,0"
                                Padding="0"
                                hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                                BorderThickness="0"
                                Command="{s:Action RemoveOperator}"
                                CommandParameter="{Binding}"
                                ToolTip="{DynamicResource Delete}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  高级设置  -->
        <StackPanel Visibility="{c:Binding 'EnableAdvancedSettings', Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <CheckBox
                    Content="{DynamicResource AutoRaiseDeleteCompletedEntries}"
                    IsChecked="{Binding DeleteCompletedEntries}" />
                <controls:TooltipBlock TooltipText="{DynamicResource AutoRaiseDeleteCompletedEntriesTip}" />
            </StackPanel>
        </StackPanel>

        <!--  培养目标选择弹窗  -->
        <Popup
            IsOpen="{Binding IsTargetPopupOpen}"
            Placement="Center"
            PlacementTarget="{Binding ElementName=AddTargetButton}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                MinWidth="300"
                Padding="12"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock FontSize="14" Text="{Binding PopupTitle}" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox
                            MinWidth="80"
                            Content="{DynamicResource AutoRaiseElite}"
                            IsChecked="{Binding PopupSelectElite}" />
                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="→" />
                        <ComboBox
                            MinWidth="64"
                            ItemsSource="{Binding EliteOptions}"
                            SelectedValue="{Binding PopupEliteTarget}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox
                            MinWidth="80"
                            Content="{DynamicResource AutoRaiseSkillUpgrade}"
                            IsChecked="{Binding PopupSelectSkill}" />
                        <TextBlock Margin="6,0" VerticalAlignment="Center" Text="→" />
                        <ComboBox
                            MinWidth="64"
                            ItemsSource="{Binding SkillLevelOptions}"
                            SelectedValue="{Binding PopupSkillTarget}" />
                    </StackPanel>
                    <controls:TextBlock Margin="0,10,0,0" Text="{DynamicResource AutoRaiseMastery}" />
                    <ItemsControl ItemsSource="{Binding MasteryRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <CheckBox
                                        MinWidth="80"
                                        Content="{Binding Label}"
                                        IsChecked="{Binding IsSelected}" />
                                    <TextBlock Margin="6,0" VerticalAlignment="Center" Text="→" />
                                    <ComboBox
                                        MinWidth="64"
                                        ItemsSource="{Binding DataContext.MasteryTargetOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        SelectedValue="{Binding Target}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="60"
                            Command="{s:Action CancelTargetPopup}"
                            Content="{DynamicResource Cancel}" />
                        <Button
                            MinWidth="60"
                            Margin="6,0,0,0"
                            Command="{s:Action ConfirmTargetPopup}"
                            Content="{Binding PopupConfirmText}"
                            IsEnabled="{Binding PopupHasSelection}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
