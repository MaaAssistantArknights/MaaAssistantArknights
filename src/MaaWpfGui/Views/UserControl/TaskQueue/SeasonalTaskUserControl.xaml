<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.SeasonalTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:SeasonalTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel
            d:Visibility="Visible"
            IsEnabled="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
            Visibility="{c:Binding !EnableAdvancedSettings,
                                   Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <StackPanel Margin="0,3" Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource TaskQueue.Task.SeasonalTask.Rounds}" />
                <controls:TooltipBlock
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    TooltipText="{DynamicResource TaskQueue.Task.SeasonalTask.Rounds.Tip}" />
            </StackPanel>
            <hc:NumericUpDown
                Margin="0,3"
                Maximum="999"
                Minimum="0"
                Value="{Binding Rounds}" />
        </StackPanel>

        <StackPanel
            d:Visibility="Visible"
            IsEnabled="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
            Visibility="{c:Binding EnableAdvancedSettings,
                                   Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <StackPanel Margin="0,3" Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource TaskQueue.Task.SeasonalTask.CoreBond.Major}" />
                <controls:TooltipBlock
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    TooltipText="{DynamicResource TaskQueue.Task.SeasonalTask.CoreBond.Tip}" />
            </StackPanel>
            <hc:ComboBox
                Margin="0,3"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                ItemsSource="{Binding MajorBondList}"
                SelectedValue="{Binding CoreMajorBond}"
                SelectedValuePath="Value" />
            <StackPanel Margin="0,3" Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource TaskQueue.Task.SeasonalTask.CoreBond.Minor}" />
                <controls:TooltipBlock
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    TooltipText="{DynamicResource TaskQueue.Task.SeasonalTask.CoreBond.Minor.Tip}" />
            </StackPanel>
            <hc:ComboBox
                Margin="0,3"
                DisplayMemberPath="Display"
                IsHitTestVisible="{Binding Run.Idle, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingDataContext}}"
                ItemsSource="{Binding MinorBondList}"
                SelectedValue="{Binding CoreMinorBond}"
                SelectedValuePath="Value" />
            <StackPanel Margin="0,3" Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource TaskQueue.Task.SeasonalTask.UpgradePlan}" />
                <controls:TooltipBlock
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    TooltipText="{DynamicResource TaskQueue.Task.SeasonalTask.UpgradePlan.Tip}" />
            </StackPanel>
            <ItemsControl Margin="0,3" ItemsSource="{Binding UpgradeRounds}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2,6,2" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="{Binding Display}" />
                            <hc:NumericUpDown
                                Width="60"
                                Height="26"
                                Margin="4,0,0,0"
                                HorizontalContentAlignment="Center"
                                Maximum="6"
                                Minimum="0"
                                Value="{Binding Target}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
