<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.MiniGameTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:MiniGameTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <!--  常规设置：牛杂条目与执行计划  -->
        <StackPanel Visibility="{c:Binding !EnableAdvancedSettings, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <ComboBox
                Margin="0,5"
                hc:InfoElement.Title="{DynamicResource MiniGameName}"
                DisplayMemberPath="Display"
                ItemsSource="{Binding MiniGameEntryList}"
                SelectedValue="{Binding MiniGameName}"
                SelectedValuePath="Value" />
            <controls:TextBlock
                Margin="0,6,0,0"
                Opacity="0.85"
                Text="{Binding MiniGameTip}"
                TextWrapping="Wrap" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ComboBox
                    MinWidth="120"
                    hc:InfoElement.Title="{DynamicResource MiniGameSchedule}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding ScheduleModeList}"
                    SelectedValue="{Binding ScheduleMode}"
                    SelectedValuePath="Value" />
                <controls:TooltipBlock
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    TooltipText="{DynamicResource MiniGameScheduleTip}" />
            </StackPanel>
            <ListBox
                Margin="6,5"
                HorizontalContentAlignment="Stretch"
                d:ItemsSource="{d:SampleData ItemCount=7}"
                ItemsSource="{Binding Path=WeeklyScheduleSource}"
                PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                             Target={x:Type helper:MouseWheelHelper}}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                Visibility="{c:Binding ShowWeeklySchedule}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{Binding Display}"
                            IsChecked="{Binding Value}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox
                MaxHeight="150"
                Margin="6,5"
                HorizontalContentAlignment="Stretch"
                d:ItemsSource="{d:SampleData ItemCount=31}"
                ItemsSource="{Binding Path=MonthlyScheduleSource}"
                PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                             Target={x:Type helper:MouseWheelHelper}}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                Visibility="{c:Binding ShowMonthlySchedule}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            Width="34"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{Binding Display}"
                            IsChecked="{Binding Value}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!--  高级设置：仅当前牛杂用到的附加参数  -->
        <StackPanel d:Visibility="Collapsed" Visibility="{c:Binding EnableAdvancedSettings, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <StackPanel Visibility="{c:Binding IsSecretFront}">
                <ComboBox
                    Margin="0,5"
                    hc:InfoElement.Title="{DynamicResource MiniGame@SecretFront@Ending}"
                    ItemsSource="{Binding SecretFrontEndingList}"
                    SelectedValue="{Binding SecretFrontEnding}" />
                <ComboBox
                    Margin="0,10"
                    hc:InfoElement.Title="{DynamicResource MiniGame@SecretFront@Event}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding SecretFrontEventList}"
                    SelectedValue="{Binding SecretFrontEvent}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <CheckBox
                Margin="0,10,0,0"
                Content="{DynamicResource MiniGame@AutoRaisePotential@UseNormalToken}"
                IsChecked="{Binding UseNormalToken}"
                Visibility="{c:Binding IsAutoRaisePotential}" />
        </StackPanel>
    </StackPanel>
</UserControl>
