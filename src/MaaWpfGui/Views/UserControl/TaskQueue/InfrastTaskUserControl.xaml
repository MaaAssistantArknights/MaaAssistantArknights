<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.InfrastTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:task="clr-namespace:MaaWpfGui.Configuration.Single.MaaTask"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:InfrastTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <!--  常规设置  -->
        <StackPanel Visibility="{c:Binding '!TaskSettingVisibilities.EnableAdvancedSettings'}">
            <StackPanel Margin="0,4">
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <controls:TextBlock
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{DynamicResource Infrast.Mode}" />
                    <controls:TooltipBlock
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        TooltipText="{DynamicResource Infrast.Mode.Rotation.Tip}"
                        Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Rotation',
                                               Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}" />
                </StackPanel>
                <ComboBox
                    VerticalContentAlignment="Center"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding InfrastModeList}"
                    SelectedValue="{Binding InfrastMode}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel d:Visibility="Visible" Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Custom', Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <StackPanel Margin="0,4">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <controls:TextBlock
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="{DynamicResource Infrast.Custom.Plan}" />
                        <controls:TooltipBlock
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            TooltipText="{DynamicResource Infrast.Custom.Plan.Tip}" />
                    </StackPanel>
                    <ComboBox
                        Margin="0,4"
                        VerticalContentAlignment="Center"
                        d:IsHitTestVisible="True"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding CustomPlanListDisplay}"
                        SelectedValue="{Binding CustomInfrastPlanSelect}"
                        SelectedValuePath="Value" />
                </StackPanel>
                <controls:TextBlock
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Hyperlink
                        d:NavigateUri="Null"
                        Cursor="Hand"
                        NavigateUri="{Binding Source={x:Static constants:MaaUrls.CustomInfrastGenerator}}"
                        TextDecorations="None">
                        <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Infrast.CustomInfrastGenerator}" />
                    </Hyperlink>
                </controls:TextBlock>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        hc:InfoElement.Title="{DynamicResource Infrast.DefaultInfrast}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding DefaultInfrastList}"
                        SelectedValue="{Binding DefaultInfrast}"
                        SelectedValuePath="Value" />
                    <Button
                        Grid.Column="1"
                        Margin="-1,0,0,0"
                        VerticalAlignment="Bottom"
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        BorderThickness="0,1,1,1"
                        Command="{s:Action SelectCustomInfrastFile}"
                        Content="{DynamicResource Common.Select}" />
                </Grid>
                <TextBox
                    Margin="0,5"
                    IsReadOnly="{Binding IsCustomInfrastFileReadOnly}"
                    Text="{Binding CustomInfrastFile}" />
            </StackPanel>
            <ComboBox
                Margin="0,5"
                d:IsEnabled="True"
                hc:InfoElement.Title="{DynamicResource Infrast.DroneUsage}"
                DisplayMemberPath="Display"
                IsEnabled="{c:Binding 'InfrastMode != taskQueue_vms:InfrastMode.Custom',
                                      Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}"
                ItemsSource="{Binding UsesOfDronesList}"
                SelectedValue="{Binding UsesOfDrones}"
                SelectedValuePath="Value" />
            <controls:TextBlock
                Width="220"
                Margin="0,4"
                d:Visibility="Visible"
                Text="{DynamicResource Infrast.Mode.Rotation.Requirement}"
                TextWrapping="Wrap"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Rotation',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}" />
            <StackPanel
                Margin="0"
                d:Visibility="Visible"
                Visibility="{c:Binding 'InfrastMode != taskQueue_vms:InfrastMode.Rotation',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <StackPanel
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:TextBlock
                        MaxWidth="150"
                        Text="{DynamicResource Infrast.DormThreshold}"
                        TextWrapping="Wrap" />
                    <controls:TextBlock Text=": " />
                    <controls:TextBlock d:Text="30" Text="{Binding DormThreshold}" />
                    <controls:TextBlock Text="%" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Infrast.DormThreshold.Tip}" />
                </StackPanel>
                <Slider
                    Margin="0,5"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding DormThreshold}" />
            </StackPanel>
            <StackPanel>
                <StackPanel
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                           Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                    <controls:TextBlock
                        Margin="8,0,0,0"
                        Text="{DynamicResource Infrast.FacilitySelection}"
                        TextWrapping="Wrap" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Infrast.FacilitySelection.Tip}" />
                </StackPanel>
                <ListBox
                    Margin="0,5,0,0"
                    d:ItemsSource="{d:SampleData ItemCount=3}"
                    hc:BorderElement.CornerRadius="4,4,0,0"
                    ItemsSource="{Binding Path=InfrastRoomModels}"
                    PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                                 Target={x:Type helper:MouseWheelHelper}}"
                    Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                    Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                           Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ListBox
                    Margin="0,5,0,0"
                    d:ItemsSource="{d:SampleData ItemCount=3}"
                    dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    hc:BorderElement.CornerRadius="4,4,0,0"
                    ItemsSource="{Binding Path=InfrastRoomModels}"
                    PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                                 Target={x:Type helper:MouseWheelHelper}}"
                    Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                    ToolTip="{DynamicResource Common.LabelSequence.Tip}"
                    Visibility="{c:Binding 'InfrastMode != taskQueue_vms:InfrastMode.Normal',
                                           Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,-1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Height="30"
                        Margin="0,0,-1,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        hc:BorderElement.CornerRadius="0,0,0,4"
                        BorderThickness="1,0,1,1"
                        Command="{s:Action InfrastItemSelectedAll}"
                        Content="{DynamicResource TaskQueue.SelectAll}" />
                    <Button
                        Grid.Column="1"
                        Height="30"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        hc:BorderElement.CornerRadius="0,0,4,0"
                        BorderThickness="1,0,1,1"
                        Command="{s:Action InfrastItemUnselectedAll}"
                        Content="{DynamicResource Common.Clear}" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!--  高级设置  -->
        <StackPanel d:Visibility="Visible" Visibility="{c:Binding EnableAdvancedSettings, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <StackPanel
                Margin="0,10"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Rotation',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox
                    MaxWidth="{c:Binding '220 - ActualWidth',
                                         ElementName=RotationDormTrustTipsTooltipBlock}"
                    AutomationProperties.AutomationId="RotationDormTrustEnabled"
                    IsChecked="{Binding RotationDormTrustEnabled}">
                    <controls:TextBlock Text="{DynamicResource Infrast.RotationDormTrustEnabled}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="RotationDormTrustTipsTooltipBlock" TooltipText="{DynamicResource Infrast.RotationDormTrustEnabled.Tip}" />
            </StackPanel>
            <CheckBox
                Margin="0,10"
                d:Visibility="Visible"
                Content="{DynamicResource Infrast.Dorm.TrustEnabled}"
                IsChecked="{Binding DormTrustEnabled}"
                Visibility="{c:Binding 'InfrastMode != taskQueue_vms:InfrastMode.Rotation',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}" />
            <StackPanel
                Margin="0,10"
                d:Visibility="Visible"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode != taskQueue_vms:InfrastMode.Rotation',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=DormFilterNotStationedTipsTooltipBlock}" IsChecked="{c:Binding DormFilterNotStationedEnabled}">
                    <controls:TextBlock Text="{DynamicResource Infrast.Dorm.FilterNotStationed}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="DormFilterNotStationedTipsTooltipBlock" TooltipText="{DynamicResource Infrast.Dorm.FilterNotStationed.Tip}" />
            </StackPanel>
            <CheckBox Margin="0,10" IsChecked="{Binding OriginiumShardAutoReplenishment}">
                <controls:TextBlock Text="{DynamicResource Infrast.OriginiumShardAutoReplenishment}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Margin="0,10" IsChecked="{Binding ReceptionMessageBoardReceive}">
                <controls:TextBlock Text="{DynamicResource Infrast.Reception.MessageBoardReceive}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Margin="0,10" Orientation="Horizontal">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=ReceptionClueExchangeTipsTooltipBlock}" IsChecked="{Binding ReceptionClueExchange}">
                    <controls:TextBlock Text="{DynamicResource Infrast.Reception.ClueExchange}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="ReceptionClueExchangeTipsTooltipBlock" TooltipText="{DynamicResource Infrast.Reception.ClueExchange.Tip}" />
            </StackPanel>
            <CheckBox Margin="0,10" IsChecked="{Binding ReceptionSendClue}">
                <controls:TextBlock Text="{DynamicResource Infrast.Reception.SendClue}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Margin="0,10" IsChecked="{Binding ContinueTraining}">
                <controls:TextBlock Text="{DynamicResource Infrast.ContinueTraining}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel HorizontalAlignment="Left" Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal', Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <StackPanel.Resources>
                    <DataTemplate x:Key="FiammettaTargetTemplate">
                        <TextBlock Text="{Binding Display}" ToolTip="{Binding Display}" />
                    </DataTemplate>
                </StackPanel.Resources>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <CheckBox
                        MaxWidth="{c:Binding '220 - ActualWidth',
                                             ElementName=InfrastFiammettaRecoveryTipsTooltipBlock}"
                        Margin="0,10"
                        IsChecked="{Binding FiammettaRecoveryEnabled}">
                        <controls:TextBlock Text="{DynamicResource Infrast.Fiammetta.Recovery}" TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock x:Name="InfrastFiammettaRecoveryTipsTooltipBlock" TooltipText="{DynamicResource Infrast.Fiammetta.Recovery.Tip}" />
                </StackPanel>
                <StackPanel
                    Margin="0,0,0,5"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Visibility="{c:Binding FiammettaRecoveryEnabled,
                                           Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                    <controls:TextBlock
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource Infrast.Fiammetta.Targets}"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Infrast.Fiammetta.Targets.Tip}" />
                </StackPanel>
                <Grid
                    Width="220"
                    HorizontalAlignment="Left"
                    Visibility="{c:Binding FiammettaRecoveryEnabled,
                                           Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        HorizontalContentAlignment="Stretch"
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        BorderThickness="1,1,0,1"
                        ItemTemplate="{StaticResource FiammettaTargetTemplate}"
                        ItemsSource="{Binding FiammettaTargetList}"
                        SelectedValue="{Binding FiammettaTarget1}"
                        SelectedValuePath="Value" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                        hc:BorderElement.CornerRadius="0"
                        BorderThickness="1,1,0,1"
                        ItemTemplate="{StaticResource FiammettaTargetTemplate}"
                        ItemsSource="{Binding OptionalFiammettaTargetList}"
                        SelectedValue="{Binding FiammettaTarget2}"
                        SelectedValuePath="Value" />
                    <ComboBox
                        Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        ItemTemplate="{StaticResource FiammettaTargetTemplate}"
                        ItemsSource="{Binding OptionalFiammettaTargetList}"
                        SelectedValue="{Binding FiammettaTarget3}"
                        SelectedValuePath="Value" />
                </Grid>
            </StackPanel>
            <StackPanel
                Margin="0,10"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=InfrastUsePinusSylvestrisTipsTooltipBlock}" IsChecked="{Binding UsePinusSylvestris}">
                    <controls:TextBlock Text="{DynamicResource Infrast.UsePinusSylvestris}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="InfrastUsePinusSylvestrisTipsTooltipBlock" TooltipText="{DynamicResource Infrast.UsePinusSylvestris.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="0,10"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=InfrastUsePerceptionInformationTipsTooltipBlock}" IsChecked="{Binding UsePerceptionInformation}">
                    <controls:TextBlock Text="{DynamicResource Infrast.UsePerceptionInformation}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="InfrastUsePerceptionInformationTipsTooltipBlock" TooltipText="{DynamicResource Infrast.UsePerceptionInformation.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="0,10"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=InfrastUseWorldlyPlightTipsTooltipBlock}" IsChecked="{Binding UseWorldlyPlight}">
                    <controls:TextBlock Text="{DynamicResource Infrast.UseWorldlyPlight}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="InfrastUseWorldlyPlightTipsTooltipBlock" TooltipText="{DynamicResource Infrast.UseWorldlyPlight.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="0,10"
                Orientation="Horizontal"
                Visibility="{c:Binding 'InfrastMode == taskQueue_vms:InfrastMode.Normal',
                                       Source={x:Static taskQueue_vms:InfrastTaskUserControlModel.Instance}}">
                <CheckBox MaxWidth="{c:Binding '220 - ActualWidth', ElementName=InfrastUseAbyssalHunterTipsTooltipBlock}" IsChecked="{Binding UseAbyssalHunter}">
                    <controls:TextBlock Text="{DynamicResource Infrast.UseAbyssalHunter}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock x:Name="InfrastUseAbyssalHunterTipsTooltipBlock" TooltipText="{DynamicResource Infrast.UseAbyssalHunter.Tip}" />
            </StackPanel>
            <StackPanel Margin="0,10" Orientation="Horizontal">
                <CheckBox Content="{DynamicResource TaskQueue.UseWeeklySchedule}" IsChecked="{Binding UseWeeklySchedule}" />
                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.UseWeeklySchedule.Tip}" />
            </StackPanel>
            <ListBox
                MaxHeight="300"
                Margin="6,5"
                HorizontalContentAlignment="Stretch"
                d:ItemsSource="{d:SampleData ItemCount=3}"
                ItemsSource="{Binding Path=WeeklyScheduleSource}"
                PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                             Target={x:Type helper:MouseWheelHelper}}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                Visibility="{c:Binding UseWeeklySchedule}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{Binding Display}"
                            IsChecked="{Binding Value}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </StackPanel>
</UserControl>
