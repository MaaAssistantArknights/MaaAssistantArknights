<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.CultivationSupplyTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:converters="clr-namespace:MaaWpfGui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:CultivationSupplyTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ItemImageConverter x:Key="ItemImageConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel Visibility="{c:Binding !EnableAdvancedSettings, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <controls:TextBlock
                Margin="0,0,0,8"
                Text="{DynamicResource CultivationSupplyManagedTip}"
                TextWrapping="Wrap" />
            <controls:TextBlock
                Margin="0,0,0,8"
                Foreground="{DynamicResource WarningBrush}"
                Text="{DynamicResource CultivationSupplyStale}"
                TextWrapping="Wrap"
                Visibility="{c:Binding IsStale}" />
            <controls:TextBlock
                Margin="0,8"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="{DynamicResource CultivationSupplyEmpty}"
                TextWrapping="Wrap"
                Visibility="{c:Binding !HasPlans}" />
            <ItemsControl ItemsSource="{Binding PlanItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,6"
                            Padding="8"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Top"
                                    Source="{Binding ItemId, Converter={StaticResource ItemImageConverter}}" />
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{Binding InventoryDisplay}"
                                        TextWrapping="Wrap"
                                        ToolTip="{DynamicResource CultivationSupplyTargetInventoryTip}" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{Binding Stage}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel IsEnabled="{Binding CanEdit}" Visibility="{c:Binding EnableAdvancedSettings, Source={x:Static ui_vms:TaskQueueViewModel.TaskSettingVisibilities}}">
            <hc:Divider Content="{DynamicResource DepotGroupStageAndBattle}" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <CheckBox Content="{DynamicResource DepotUseAutoSeries}" IsChecked="{Binding UseAutoSeries}" />
                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource DepotUseAutoSeriesTip}" />
            </StackPanel>
            <hc:Divider Margin="0,12,0,0" Content="{DynamicResource DepotGroupSanityRecovery}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource UseSanityPotion}" IsChecked="{Binding UseMedicine}" />
                    <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource CultivationSupplySharedMedicineTip}" />
                </StackPanel>
                <hc:NumericUpDown
                    Grid.Column="1"
                    Width="70"
                    Height="30"
                    Margin="6,0,0,0"
                    IsEnabled="{Binding UseMedicine}"
                    Maximum="999"
                    Minimum="0"
                    Value="{Binding MedicineCount, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding UseExpiringMedicine}">
                <TextBlock Text="{DynamicResource CultivationSupplyExpiringMedicine}" TextWrapping="Wrap" />
            </CheckBox>
            <controls:TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="{DynamicResource CultivationSupplyNoStoneTip}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
