<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.OperatorDevelopmentSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    MaxWidth="360"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:OperatorDevelopmentSettingsUserControlModel}}"
    d:DesignWidth="360"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <TextBox
            MinWidth="210"
            MinHeight="180"
            AcceptsReturn="True"
            FontFamily="Consolas"
            HorizontalScrollBarVisibility="Auto"
            Text="{Binding PlanJson, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" />
        <Button
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            Command="{s:Action ParsePlan}"
            Content="{DynamicResource OperatorDevelopmentParsePlan}" />
        <controls:TextBlock
            Margin="0,8,0,0"
            Foreground="{DynamicResource TraceLogBrush}"
            Text="{Binding ValidationMessage}"
            TextWrapping="Wrap" />
        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PlanPreviewItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Index}" />
                        <TextBlock Grid.Column="1" Margin="4,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Target}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
