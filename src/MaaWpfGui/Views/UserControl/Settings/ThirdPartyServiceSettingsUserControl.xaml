<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.ThirdPartyServiceSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:ThirdPartyServiceSettingsUserControlModel}}"
    d:DesignWidth="550"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Vertical">
        <hc:Divider Margin="0" Content="{DynamicResource ThirdPartyGroupPenguin}" />
        <CheckBox
            Margin="10"
            HorizontalAlignment="Center"
            Content="{DynamicResource EnablePenguin}"
            IsChecked="{Binding EnablePenguin}" />
        <StackPanel
            Margin="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{c:Binding EnablePenguin}">
            <controls:TextBlock Text="{DynamicResource PenguinId}" />
            <TextBox
                MinWidth="80"
                Margin="5,0,0,0"
                InputMethod.IsInputMethodEnabled="False"
                Text="{Binding PenguinId}" />
        </StackPanel>
        <hc:Divider Margin="0" Content="{DynamicResource ThirdPartyGroupYituliu}" />
        <CheckBox
            Margin="10"
            HorizontalAlignment="Center"
            Content="{DynamicResource EnableYituliu}"
            IsChecked="{Binding EnableYituliu}" />
        <StackPanel
            Margin="5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <controls:TextBlock Text="{DynamicResource YituliuOpenApiToken}" />
            <Grid Margin="5,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:PasswordBox
                    Width="220"
                    hc:BorderElement.CornerRadius="4,0,0,4"
                    IsSafeEnabled="False"
                    ShowEyeButton="True"
                    UnsafePassword="{Binding YituliuOpenApiToken}" />
                <Button
                    Grid.Column="1"
                    Height="30"
                    hc:BorderElement.CornerRadius="0,4,4,0"
                    BorderThickness="0,1,1,1"
                    Command="{s:Action VerifyYituliuToken}"
                    Content="{DynamicResource YituliuTokenVerify}"
                    IsEnabled="{Binding CanVerifyYituliuToken}" />
            </Grid>
        </StackPanel>
        <controls:TextBlock Margin="5" HorizontalAlignment="Center">
            <Hyperlink
                Cursor="Hand"
                NavigateUri="{Binding Source={x:Static constants:MaaUrls.YituliuAccountHome}}"
                TextDecorations="None">
                <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource YituliuTokenLink}" />
            </Hyperlink>
        </controls:TextBlock>
        <controls:TextBlock
            MaxWidth="400"
            Margin="0"
            HorizontalAlignment="Center"
            Text="{Binding YituliuTokenValidationText}"
            TextWrapping="Wrap"
            Visibility="{c:Binding 'YituliuTokenValidationText.Length > 0'}" />
        <StackPanel HorizontalAlignment="Center">
            <StackPanel
                Margin="10,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox Content="{DynamicResource EnableOperBoxYituliuApi}" IsChecked="{Binding EnableOperBoxYituliuApi}" />
                <controls:TooltipBlock TooltipText="{DynamicResource EnableOperBoxYituliuApiTip}" />
            </StackPanel>
            <StackPanel
                Margin="10,5"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <CheckBox
                    Content="{DynamicResource Copilot.UseOperBoxAssist}"
                    IsChecked="{Binding EnableOperBoxAssist}"
                    IsEnabled="{Binding CanUseOperBoxAssist}" />
                <controls:TooltipBlock TooltipText="{DynamicResource Copilot.UseOperBoxAssist.Tip}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
