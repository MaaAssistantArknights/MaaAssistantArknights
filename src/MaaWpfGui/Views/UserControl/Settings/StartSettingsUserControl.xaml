<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.StartSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:StartSettingsUserControlModel}}"
    d:DesignHeight="300"
    d:DesignWidth="500"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <controls:GlobalConfigTip />
            <StackPanel Margin="10" Orientation="Horizontal">
                <CheckBox
                    HorizontalAlignment="Left"
                    Block.TextAlignment="Center"
                    Content="{DynamicResource Settings.Startup.LaunchOnSystemStartup}"
                    IsChecked="{Binding StartSelf}" />
                <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.LaunchOnSystemStartup.Warning}" />
            </StackPanel>
            <CheckBox
                Margin="10"
                HorizontalAlignment="Left"
                Block.TextAlignment="Center"
                Content="{DynamicResource Settings.Startup.MinimizeAfterLaunch}"
                IsChecked="{Binding MinimizeDirectly}" />
            <hc:Divider />
            <CheckBox
                Margin="10"
                HorizontalAlignment="Left"
                Block.TextAlignment="Center"
                Content="{DynamicResource Settings.Startup.RunTaskAfterLaunch}"
                IsChecked="{Binding RunDirectly}" />
            <StackPanel
                Margin="10"
                Orientation="Horizontal"
                Visibility="{c:Binding '!IsPCConnectConfig',
                                       Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
                <CheckBox
                    HorizontalAlignment="Left"
                    Block.TextAlignment="Center"
                    Content="{DynamicResource Settings.Startup.OpenEmulatorAfterLaunch}"
                    IsChecked="{Binding OpenEmulatorAfterLaunch}" />
                <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.OpenEmulatorAfterLaunch.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="10"
                Orientation="Horizontal"
                Visibility="{c:Binding IsPCConnectConfig,
                                       Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
                <CheckBox
                    HorizontalAlignment="Left"
                    Block.TextAlignment="Center"
                    Content="{DynamicResource Settings.Startup.OpenPcClientAfterLaunch}"
                    IsChecked="{Binding OpenPcClientAfterLaunch}" />
                <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.OpenPcClientAfterLaunch.Tip}" />
            </StackPanel>
            <StackPanel Margin="10" Orientation="Horizontal">
                <CheckBox MaxWidth="210" IsChecked="{Binding SkipStartupAutoRunAfterUpdate}">
                    <controls:TextBlock Text="{DynamicResource Settings.Startup.SkipStartupAutoRunAfterUpdate}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock Grid.Column="1" TooltipText="{DynamicResource Settings.Startup.SkipStartupAutoRunAfterUpdate.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="10"
                Orientation="Horizontal"
                Visibility="{c:Binding '!IsPCConnectConfig',
                                       Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
                <CheckBox MaxWidth="210" IsChecked="{Binding RetryOnDisconnected, Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                    <controls:TextBlock Text="{DynamicResource Connection.RetryOnDisconnected}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock Grid.Column="1" TooltipText="{DynamicResource Connection.RetryOnDisconnected.Tip}" />
            </StackPanel>
            <StackPanel
                Margin="10"
                Orientation="Horizontal"
                Visibility="{c:Binding IsPCConnectConfig,
                                       Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
                <CheckBox MaxWidth="210" IsChecked="{Binding RetryPcClientOnDisconnected, Source={x:Static ui_vms:SettingsViewModel.ConnectSettings}}">
                    <controls:TextBlock Text="{DynamicResource Connection.RetryOnPcDisconnected}" TextWrapping="Wrap" />
                </CheckBox>
                <controls:TooltipBlock Grid.Column="1" TooltipText="{DynamicResource Connection.RetryOnPcDisconnected.Tip}" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Visibility="{c:Binding '!IsPCConnectConfig',
                                   Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
            <StackPanel Margin="10">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:TextBlock
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Block.TextAlignment="Center"
                        Text="{DynamicResource Settings.Startup.EmulatorPath}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.SelectShortcut.Tip}" />
                    <Button
                        Margin="10,0,0,0"
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        Command="{s:Action SelectEmulatorExec}"
                        Content="{DynamicResource Common.Select}" />
                    <Button
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        BorderThickness="0,1,1,1"
                        Command="{s:Action TestEmulatorExec}"
                        Content="{DynamicResource Settings.Startup.Test}" />
                </StackPanel>
                <TextBox Text="{Binding EmulatorPath}" />
            </StackPanel>
            <StackPanel Margin="10">
                <StackPanel
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:TextBlock Block.TextAlignment="Center" Text="{DynamicResource Settings.Startup.AdditionCommand}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.AdditionCommand.Tip}" />
                </StackPanel>
                <TextBox IsEnabled="{Binding EmulatorPath.Length}" Text="{Binding EmulatorAddCommand}" />
            </StackPanel>
            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <controls:TextBlock
                    Margin="3"
                    Block.TextAlignment="Center"
                    Text="{DynamicResource Settings.Startup.WaitForEmulator}" />
                <TextBox
                    Width="50"
                    Margin="3"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding EmulatorWaitSeconds}" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Visibility="{c:Binding IsPCConnectConfig,
                                   Source={x:Static settings_vms:ConnectSettingsUserControlModel.Instance}}">
            <StackPanel Margin="10">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:TextBlock
                        Margin="0,5"
                        VerticalAlignment="Center"
                        Block.TextAlignment="Center"
                        Text="{DynamicResource Settings.Startup.PcClientPath}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.SelectPcClient.Tip}" />
                    <Button
                        Margin="10,0,0,0"
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        Command="{s:Action SelectPcClientExec}"
                        Content="{DynamicResource Common.Select}" />
                    <Button
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        BorderThickness="0,1,1,1"
                        Command="{s:Action TestPcClientExec}"
                        Content="{DynamicResource Settings.Startup.Test}" />
                </StackPanel>
                <TextBox Text="{Binding PcClientPath}" />
            </StackPanel>
            <StackPanel Margin="10">
                <StackPanel
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <controls:TextBlock Block.TextAlignment="Center" Text="{DynamicResource Settings.Startup.AdditionCommand}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource Settings.Startup.PcClientAddCommand.Tip}" />
                </StackPanel>
                <TextBox IsEnabled="{Binding PcClientPath.Length}" Text="{Binding PcClientAddCommand}" />
            </StackPanel>
            <StackPanel
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <controls:TextBlock
                    Margin="3"
                    Block.TextAlignment="Center"
                    Text="{DynamicResource Settings.Startup.WaitForPcClient}" />
                <TextBox
                    Width="50"
                    Margin="3"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding PcClientWaitSeconds}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
