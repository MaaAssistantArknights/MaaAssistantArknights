<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.HotKeyEditorUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="UserControl"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <TextBox
        x:Name="HotKeyTextBox"
        Width="200"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        InputMethod.IsInputMethodEnabled="False"
        IsReadOnly="True"
        IsReadOnlyCaretVisible="False"
        IsUndoEnabled="False"
        PreviewKeyDown="HotKeyTextBox_PreviewKeyDown"
        Text="{Binding HotKey, ElementName=UserControl, Mode=OneWay}">
        <TextBox.Style>
            <!--  BasedOn 隐式样式保持常规外观；注册失败时标红边框提示  -->
            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRegistrationFailed, ElementName=UserControl}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBox.Style>
        <TextBox.ContextMenu>
            <ContextMenu Visibility="Collapsed" />
        </TextBox.ContextMenu>
    </TextBox>
</UserControl>
