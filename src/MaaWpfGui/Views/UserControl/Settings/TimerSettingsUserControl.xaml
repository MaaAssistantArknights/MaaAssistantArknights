<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.TimerSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:TimerSettingsUserControlModel}}"
    d:DesignHeight="450"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:GlobalConfigTip Grid.Row="0" />

        <Grid
            Grid.Row="1"
            Margin="5"
            HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel
                Margin="10,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox
                    VerticalContentAlignment="Center"
                    Content="{DynamicResource ScheduledWakeUp}"
                    IsChecked="{Binding ScheduledWakeUp}" />
                <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource ScheduledWakeUpTip}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <StackPanel Margin="10,5" Orientation="Horizontal">
                    <CheckBox
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource ForceScheduledStart}"
                        IsChecked="{Binding ForceScheduledStart}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource ForceScheduledStartTip}" />
                </StackPanel>

                <StackPanel Margin="10,5" Orientation="Horizontal">
                    <CheckBox
                        VerticalContentAlignment="Center"
                        Content="{DynamicResource ShowWindowBeforeForceScheduledStart}"
                        IsChecked="{Binding ShowWindowBeforeForceScheduledStart}"
                        Visibility="{c:Binding ForceScheduledStart}" />
                    <controls:TooltipBlock
                        VerticalAlignment="Center"
                        TooltipText="{DynamicResource ShowWindowBeforeForceScheduledStartTip}"
                        Visibility="{c:Binding ForceScheduledStart}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Margin="10,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox
                    VerticalContentAlignment="Center"
                    Content="{DynamicResource NotifyBeforeScheduledStart}"
                    IsChecked="{Binding NotifyBeforeScheduledStart}" />
                <controls:TooltipBlock VerticalAlignment="Center" TooltipText="{DynamicResource NotifyBeforeScheduledStartTip}" />
                <hc:NumericUpDown
                    Height="30"
                    Margin="10,-10"
                    hc:InfoElement.Title="{DynamicResource ScheduledStartNotificationMinutes}"
                    hc:TitleElement.TitlePlacement="Left"
                    InputMethod.IsInputMethodEnabled="False"
                    Maximum="1439"
                    Minimum="1"
                    Visibility="{c:Binding NotifyBeforeScheduledStart}"
                    Value="{Binding ScheduledStartNotificationMinutes}" />
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Margin="10,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <CheckBox
                    VerticalContentAlignment="Center"
                    Content="{DynamicResource TimerCustomConfig}"
                    IsChecked="{Binding CustomConfig}" />
                <controls:TooltipBlock TooltipText="{DynamicResource TimerCustomConfigTip}" />
            </StackPanel>

        </Grid>

        <!--  定时项区数据驱动：模板绑 TimerList 各项，不再逐个手写槽位  -->
        <ItemsControl
            Grid.Row="2"
            Width="500"
            Margin="0,5,0,0"
            d:ItemsSource="{d:SampleData ItemCount=8}"
            ItemsSource="{Binding TimerList}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <CheckBox
                                Margin="10,5"
                                IsChecked="{Binding IsEnabled}"
                                MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                              Target={x:Type helper:CheckBoxHelper}}"
                                ToolTip="{DynamicResource CheckBoxesNotSavedAsNull}">
                                <TextBlock><Run Text="{DynamicResource Timer}" /><Run xml:space="preserve" Text=" " /><Run Text="{c:Binding 'Id + 1'}" /></TextBlock>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal">
                                <hc:NumericUpDown
                                    Width="55"
                                    Margin="10,5"
                                    InputMethod.IsInputMethodEnabled="False"
                                    IsEnabled="{c:Binding 'IsEnabled ?? &quot;True&quot;'}"
                                    Maximum="23"
                                    Minimum="0"
                                    ValueFormat="00"
                                    Value="{Binding Hour}" />
                                <controls:TextBlock Text=":" />
                                <hc:NumericUpDown
                                    Width="55"
                                    Margin="10,5"
                                    InputMethod.IsInputMethodEnabled="False"
                                    IsEnabled="{c:Binding 'IsEnabled ?? &quot;True&quot;'}"
                                    Maximum="59"
                                    Minimum="0"
                                    ValueFormat="00"
                                    Value="{Binding Minute}" />
                            </StackPanel>
                        </StackPanel>
                        <ComboBox
                            Width="150"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsEnabled="{Binding Run.Idle, Source={x:Static helper:Instances.SettingsViewModel}}"
                            ItemsSource="{Binding ConfigurationList, Source={x:Static helper:Instances.SettingsViewModel}}"
                            SelectedValue="{Binding Config}"
                            SelectedValuePath="Value"
                            ToolTip="{Binding Config}"
                            Visibility="{c:Binding CustomConfig,
                                                   Source={x:Static settings_vms:TimerSettingsUserControlModel.Instance}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
