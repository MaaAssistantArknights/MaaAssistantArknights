<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.PerformanceUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:MaaWpfGui.Constants.Enums"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:PerformanceUserControlModel}}"
    d:DesignWidth="550"
    mc:Ignorable="d">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:GlobalConfigTip />
        <StackPanel Visibility="{c:Binding IsGpuSelectionVisible}">
            <StackPanel
                Margin="8,10,0,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource Settings.Performance.UseGpuForInference}" />
                <controls:TooltipBlock TooltipText="{DynamicResource Settings.Performance.UseGpuForInference.Tip}" />
            </StackPanel>
            <hc:ComboBox
                Width="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource RegionBrushOpacity25}"
                DisplayMemberPath="Display"
                ItemsSource="{Binding GpuOptions}"
                PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                             Target={x:Type helper:MouseWheelHelper}}"
                SelectedItem="{Binding ActiveGpuOption}">
                <hc:ComboBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="{x:Type ComboBoxItem}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDeprecated}" Value="True" />
                                    <Condition Binding="{Binding DataContext.AllowDeprecatedGpu, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </hc:ComboBox.ItemContainerStyle>
            </hc:ComboBox>
        </StackPanel>
        <StackPanel
            Margin="8,15,0,5"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <controls:TextBlock Text="{DynamicResource InferenceBackend}" />
            <controls:TooltipBlock TooltipText="{DynamicResource InferenceBackendTip}" />
        </StackPanel>
        <hc:ComboBox
            Width="250"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource RegionBrushOpacity25}"
            DisplayMemberPath="Display"
            ItemsSource="{Binding BackendFamilyOptions}"
            PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                         Target={x:Type helper:MouseWheelHelper}}"
            SelectedValue="{Binding ActiveBackendFamily}"
            SelectedValuePath="Value" />
        <StackPanel Visibility="{c:Binding IsOpenVinoDeviceVisible}">
            <StackPanel
                Margin="8,15,0,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <controls:TextBlock Text="{DynamicResource InferenceBackend.OpenVinoDevice}" />
            </StackPanel>
            <hc:ComboBox
                Width="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource RegionBrushOpacity25}"
                DisplayMemberPath="Display"
                ItemsSource="{Binding OpenVinoDeviceOptions}"
                PreviewMouseWheel="{s:Action DisableComboBoxScrollWhenClosed,
                                             Target={x:Type helper:MouseWheelHelper}}"
                SelectedValue="{Binding ActiveOpenVinoDevice}"
                SelectedValuePath="Value">
                <hc:ComboBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ComboBoxItemBaseStyle}" TargetType="{x:Type ComboBoxItem}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Value}" Value="{x:Static enums:OpenVinoDeviceChoice.CPU}" />
                                    <Condition Binding="{Binding DataContext.OpenVinoCpuAvailable, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Value}" Value="{x:Static enums:OpenVinoDeviceChoice.NPU}" />
                                    <Condition Binding="{Binding DataContext.OpenVinoNpuAvailable, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Value}" Value="{x:Static enums:OpenVinoDeviceChoice.Hybrid}" />
                                    <Condition Binding="{Binding DataContext.OpenVinoNpuAvailable, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Value}" Value="{x:Static enums:OpenVinoDeviceChoice.Hybrid}" />
                                    <Condition Binding="{Binding DataContext.OpenVinoCpuAvailable, RelativeSource={RelativeSource AncestorType=hc:ComboBox}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </hc:ComboBox.ItemContainerStyle>
            </hc:ComboBox>
        </StackPanel>
        <controls:TextBlock
            MaxWidth="440"
            Margin="8,8,8,0"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource WarningBrush}"
            Text="{DynamicResource InferenceBackend.OpenVinoNpu.Warning}"
            TextWrapping="Wrap"
            Visibility="{c:Binding IsOpenVinoNpuSelected}" />
        <controls:TextBlock
            MaxWidth="440"
            Margin="8,8,8,0"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource WarningBrush}"
            Text="{DynamicResource InferenceBackend.OpenVinoHybrid.Warning}"
            TextWrapping="Wrap"
            Visibility="{c:Binding IsOpenVinoHybridSelected}" />
        <StackPanel
            Margin="10"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <CheckBox MaxWidth="250" IsChecked="{Binding IgnoreBadModulesAndUseSoftwareRendering}">
                <controls:TextBlock Text="{DynamicResource Error.BadModules.UseSoftwareRendering}" TextWrapping="Wrap" />
            </CheckBox>
            <controls:TooltipBlock TooltipText="{DynamicResource Error.BadModules.UseSoftwareRendering.Tip}" />
        </StackPanel>
    </StackPanel>
</UserControl>
