<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.GuiSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:GuiSettingsUserControlModel}}"
    d:DesignWidth="550"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <!--  背景设置整块并入界面设置聚合展示，分区标题由各 Divider 提供  -->
    <StackPanel>
        <controls:GlobalConfigTip />
        <hc:Divider Margin="0" Content="{DynamicResource ThemeAndAnimationSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource UiTheme}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding DarkModeList}"
                    SelectedValue="{Binding DarkMode}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource TransitionSpeed}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding TransitionSpeedList}"
                    SelectedValue="{Binding TransitionSpeed}"
                    SelectedValuePath="Value" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource LanguageSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <ComboBox
                    x:Name="LanguageSelector"
                    Margin="8"
                    hc:InfoElement.Title="{Binding LanguageInfo}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding LanguageList}"
                    SelectedValue="{Binding Language}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource OperNameLanguage}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding OperNameLanguageModeList}"
                    SelectedValue="{Binding OperNameLanguage}"
                    SelectedValuePath="Value" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource TitleBarSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Margin="8" HorizontalAlignment="Left">
                    <controls:TextBlock
                        Margin="8,0,0,5"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource TitleBarDisplayContent}"
                        TextWrapping="Wrap" />
                    <hc:CheckComboBox
                        Width="180"
                        HorizontalAlignment="Stretch"
                        hc:ListBoxAttach.SelectedItems="{Binding WindowTitleSelectShowList}"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding WindowTitleAllShowDict}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <CheckBox Margin="8" IsChecked="{Binding WindowTitleScrollable}">
                    <controls:TextBlock Text="{DynamicResource WindowTitleScrollable}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox
                    Margin="8"
                    Content="{DynamicResource HideCloseButton}"
                    IsChecked="{Binding HideCloseButton}" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource TraySettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <CheckBox
                    Margin="8"
                    Content="{DynamicResource UseTray}"
                    IsChecked="{Binding UseTray}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <CheckBox
                    Margin="8"
                    IsChecked="{Binding MinimizeToTray}"
                    Visibility="{c:Binding UseTray,
                                           FalseToVisibility=Collapsed}">
                    <controls:TextBlock Text="{DynamicResource MinimizeToTray}" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource LogDisplaySettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <CheckBox
                    Margin="8"
                    Content="{DynamicResource UseCardLog}"
                    IsChecked="{Binding UseCardLog}" />
                <StackPanel
                    Margin="8"
                    HorizontalAlignment="Left"
                    Visibility="{c:Binding UseCardLog}">
                    <controls:TextBlock
                        MaxWidth="200"
                        Margin="8,0,0,5"
                        HorizontalAlignment="Left"
                        Text="{DynamicResource MaxNumberOfLogThumbnails}"
                        TextWrapping="Wrap" />
                    <hc:NumericUpDown
                        Width="180"
                        HorizontalAlignment="Left"
                        Maximum="1000"
                        Minimum="0"
                        Value="{Binding MaxNumberOfLogThumbnails}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ComboBox
                    Width="180"
                    Margin="8"
                    HorizontalAlignment="Left"
                    hc:InfoElement.Title="{DynamicResource LogItemDateFormatString}"
                    ItemsSource="{Binding LogItemDateFormatStringList}"
                    SelectedValue="{Binding LogItemDateFormatString}" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource OperationGuideSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <CheckBox MaxWidth="167" IsChecked="{Binding MainTasksInvertNullFunction}">
                        <controls:TextBlock Text="{DynamicResource MainTasksNullFunctionality}" TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock TooltipText="{DynamicResource MainTasksNullFunctionalityTip}" />
                </StackPanel>
                <StackPanel Margin="8" Orientation="Horizontal">
                    <CheckBox MaxWidth="167" IsChecked="{Binding HideHoverActionButtons}">
                        <controls:TextBlock Text="{DynamicResource HideHoverActionButtons}" TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock TooltipText="{DynamicResource HideHoverActionButtonsTip}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource MainViewButtonFeature}"
                    DisplayMemberPath="Display"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static helper:Instances.SettingsViewModel}}"
                    ItemsSource="{Binding InverseClearModeList}"
                    SelectedValue="{Binding InverseClearMode}"
                    SelectedValuePath="Value" />
            </StackPanel>

            <Button
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Width="180"
                Margin="8"
                HorizontalAlignment="Center"
                Command="{s:Action RestartGuide,
                                   Target={x:Static helper:Instances.SettingsViewModel}}"
                Content="{DynamicResource RestartGuide}"
                Style="{StaticResource ButtonPrimary}" />
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource BackgroundSettings}" />
        <settings:BackgroundSettingsUserControl Margin="0,20" DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.BackgroundSettings}}" />
    </StackPanel>
</UserControl>
