<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.GuiSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:GuiSettingsUserControlModel}}"
    d:DesignWidth="550"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel Width="420">
        <controls:GlobalConfigTip />
        <hc:Divider Margin="0" Content="{DynamicResource LanguageSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <ComboBox
                    x:Name="LanguageSelector"
                    Margin="8"
                    hc:InfoElement.Title="{Binding LanguageInfo}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding LanguageList}"
                    SelectedValue="{Binding Language}"
                    SelectedValuePath="Value" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource OperNameLanguage}"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding OperNameLanguageModeList}"
                    SelectedValue="{Binding OperNameLanguage}"
                    SelectedValuePath="Value" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource WindowAndNotificationSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <CheckBox
                    Margin="8"
                    Content="{DynamicResource UseTray}"
                    IsChecked="{Binding UseTray}" />
                <CheckBox
                    Margin="8"
                    IsChecked="{Binding MinimizeToTray}"
                    Visibility="{c:Binding UseTray,
                                           FalseToVisibility=Collapsed}">
                    <controls:TextBlock Text="{DynamicResource MinimizeToTray}" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource SystemNotification}" IsChecked="{Binding UseNotify}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource SystemNotificationInfo}" />
                </StackPanel>
                <CheckBox
                    Margin="8"
                    Content="{DynamicResource HideCloseButton}"
                    IsChecked="{Binding HideCloseButton}" />
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource OperationAndGuideSettings}" />
        <Grid
            Margin="10"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <ComboBox
                    Margin="8"
                    hc:InfoElement.Title="{DynamicResource MainViewButtonFeature}"
                    DisplayMemberPath="Display"
                    IsHitTestVisible="{Binding Run.Idle, Source={x:Static helper:Instances.SettingsViewModel}}"
                    ItemsSource="{Binding InverseClearModeList}"
                    SelectedValue="{Binding InverseClearMode}"
                    SelectedValuePath="Value" />
                <Button
                    Width="180"
                    Margin="8"
                    HorizontalAlignment="Left"
                    Command="{s:Action RestartGuide,
                                       Target={x:Static helper:Instances.SettingsViewModel}}"
                    Content="{DynamicResource RestartGuide}"
                    Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <StackPanel Margin="8" Orientation="Horizontal">
                    <CheckBox MaxWidth="167" IsChecked="{Binding MainTasksInvertNullFunction}">
                        <controls:TextBlock Text="{DynamicResource MainTasksNullFunctionality}" TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock TooltipText="{DynamicResource MainTasksNullFunctionalityTip}" />
                </StackPanel>
                <StackPanel Margin="8" Orientation="Horizontal">
                    <CheckBox MaxWidth="167" IsChecked="{Binding HideHoverActionButtons}">
                        <controls:TextBlock Text="{DynamicResource HideHoverActionButtons}" TextWrapping="Wrap" />
                    </CheckBox>
                    <controls:TooltipBlock TooltipText="{DynamicResource HideHoverActionButtonsTip}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <hc:Divider Margin="0" Content="{DynamicResource CompatibilitySettings}" />
        <StackPanel Margin="8" Orientation="Horizontal">
            <CheckBox MaxWidth="167" IsChecked="{Binding IgnoreBadModulesAndUseSoftwareRendering}">
                <controls:TextBlock Text="{DynamicResource BadModules.UseSoftwareRendering}" TextWrapping="Wrap" />
            </CheckBox>
            <controls:TooltipBlock TooltipText="{DynamicResource BadModules.UseSoftwareRenderingTip}" />
        </StackPanel>
    </StackPanel>
</UserControl>
