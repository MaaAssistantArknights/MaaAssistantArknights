<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.PersonalizationSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:PersonalizationSettingsUserControlModel}}"
    d:DesignWidth="550"
    mc:Ignorable="d">
    <StackPanel Width="420">
        <controls:GlobalConfigTip />
        <StackPanel DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.GuiSettings}}">
            <hc:Divider Margin="0" Content="{DynamicResource ThemeAndAnimationSettings}" />
            <Grid
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <ComboBox
                        Margin="8"
                        hc:InfoElement.Title="{DynamicResource UiTheme}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding DarkModeList}"
                        SelectedValue="{Binding DarkMode}"
                        SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox
                        Margin="8"
                        hc:InfoElement.Title="{DynamicResource TransitionSpeed}"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding TransitionSpeedList}"
                        SelectedValue="{Binding TransitionSpeed}"
                        SelectedValuePath="Value" />
                </StackPanel>
            </Grid>
            <hc:Divider Margin="0" Content="{DynamicResource TitleBarSettings}" />
            <Grid
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <StackPanel Margin="8" HorizontalAlignment="Left">
                        <controls:TextBlock
                            Margin="8,0,0,5"
                            HorizontalAlignment="Left"
                            Text="{DynamicResource TitleBarDisplayContent}"
                            TextWrapping="Wrap" />
                        <hc:CheckComboBox
                            Width="180"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding WindowTitleAllShowDict}"
                            SelectionMode="Multiple">
                            <hc:ListBoxAttach.SelectedItems>
                                <Binding Path="WindowTitleSelectShowList" />
                            </hc:ListBoxAttach.SelectedItems>
                        </hc:CheckComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <CheckBox
                        Margin="8"
                        Content="{DynamicResource WindowTitleScrollable}"
                        IsChecked="{Binding WindowTitleScrollable}" />
                </StackPanel>
            </Grid>
            <hc:Divider Margin="0" Content="{DynamicResource LogDisplaySettings}" />
            <Grid
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <CheckBox
                        Margin="8"
                        Content="{DynamicResource UseCardLog}"
                        IsChecked="{Binding UseCardLog}" />
                    <StackPanel
                        Margin="8"
                        HorizontalAlignment="Left"
                        Visibility="{c:Binding UseCardLog}">
                        <controls:TextBlock
                            MaxWidth="200"
                            Margin="8,0,0,5"
                            HorizontalAlignment="Left"
                            Text="{DynamicResource MaxNumberOfLogThumbnails}"
                            TextWrapping="Wrap" />
                        <hc:NumericUpDown
                            Width="180"
                            HorizontalAlignment="Left"
                            Maximum="1000"
                            Minimum="0"
                            Value="{Binding MaxNumberOfLogThumbnails}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <ComboBox
                        Width="180"
                        Margin="8"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Title="{DynamicResource LogItemDateFormatString}"
                        ItemsSource="{Binding LogItemDateFormatStringList}"
                        SelectedValue="{Binding LogItemDateFormatString}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <hc:Divider Margin="0" Content="{DynamicResource IconDisplaySettings}" />
        <StackPanel Margin="5" HorizontalAlignment="Center">
            <CheckBox
                Margin="8"
                Content="{DynamicResource ShowOperatorIcons}"
                IsChecked="{Binding ShowOperatorIcons}" />
            <CheckBox
                Margin="8"
                Content="{DynamicResource ShowMaterialIcons}"
                IsChecked="{Binding ShowMaterialIcons}" />
        </StackPanel>
        <hc:Divider Margin="0" Content="{DynamicResource BackgroundSettings}" />
        <settings:BackgroundSettingsUserControl DataContext="{Binding Source={x:Static ui_vms:SettingsViewModel.BackgroundSettings}}" />
    </StackPanel>
</UserControl>
