<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.ExternalNotificationSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:config="clr-namespace:MaaWpfGui.Models.ExternalNotification"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    xmlns:template="clr-namespace:MaaWpfGui.Services.ExternalNotification"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:ExternalNotificationSettingsUserControlModel}}"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <Grid
        Width="500"
        hc:InfoElement.HorizontalAlignment="Center"
        hc:InfoElement.TitlePlacement="Left"
        hc:InfoElement.TitleWidth="150">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CheckBox
            Grid.Row="0"
            HorizontalAlignment="Center"
            Content="{DynamicResource ExternalNotification.Enable}"
            IsChecked="{Binding DeliverySettings.Enable}" />
        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            Visibility="{c:Binding DeliverySettings.Enable}">
            <StackPanel
                Width="460"
                HorizontalAlignment="Center"
                DataContext="{Binding DeliverySettings}"
                Visibility="{c:Binding 'DataContext.ConfigCount > 0',
                                       RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <hc:Divider Margin="0" Content="{DynamicResource ExternalNotification.SendConditions}" />
                <WrapPanel HorizontalAlignment="Center">
                    <CheckBox
                        Margin="10"
                        Content="{DynamicResource ExternalNotification.WhenComplete}"
                        IsChecked="{Binding SendWhenComplete}" />
                    <CheckBox
                        Margin="10"
                        Content="{DynamicResource ExternalNotification.WhenError}"
                        IsChecked="{Binding SendWhenError}" />
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource ExternalNotification.WhenStalled}" IsChecked="{Binding SendWhenStalled}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.WhenStalled.Tip}" />
                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource ExternalNotification.SendBeforeScheduledStart}" IsChecked="{Binding SendBeforeScheduledStart}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.SendBeforeScheduledStart.Tip}" />
                    </StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="{DynamicResource ExternalNotification.NewLogCount}"
                            IsChecked="{Binding SendAfterLogCount}" />
                        <hc:NumericUpDown
                            Height="30"
                            Margin="5,-10,0,-10"
                            hc:InfoElement.TitleWidth="0"
                            Maximum="10000"
                            Minimum="1"
                            Visibility="{c:Binding SendAfterLogCount}"
                            Value="{Binding NewLogCount}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.NewLogCount.Tip}" />
                    </StackPanel>
                </WrapPanel>
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource ExternalNotification.ContentMatches}" IsChecked="{Binding SendWhenContentMatches}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.Whitelist.Tip}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,10" Visibility="{c:Binding SendWhenContentMatches}">
                    <controls:TextBlock
                        Margin="0,0,0,5"
                        HorizontalAlignment="Center"
                        Text="{DynamicResource ExternalNotification.Whitelist}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBox
                        Height="Auto"
                        Padding="12,8"
                        VerticalContentAlignment="Top"
                        hc:InfoElement.TitleWidth="0"
                        AcceptsReturn="True"
                        MinLines="1"
                        Text="{Binding Whitelist, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Disabled" />
                </StackPanel>
                <hc:Divider Margin="0" Content="{DynamicResource ExternalNotification.IncludePreviousLogs}" />
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <CheckBox Content="{DynamicResource ExternalNotification.IncludePreviousLogs}" IsChecked="{Binding IncludePreviousLogs}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.IncludePreviousLogs.Tip}" />
                </StackPanel>
                <StackPanel Visibility="{c:Binding IncludePreviousLogs}">
                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <controls:TextBlock VerticalAlignment="Center" Text="{DynamicResource ExternalNotification.PreviousLogCount}" />
                        <hc:NumericUpDown
                            Height="30"
                            Margin="5,-10,0,-10"
                            hc:InfoElement.TitleWidth="0"
                            Maximum="10000"
                            Minimum="0"
                            Value="{Binding MaxEntries}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.PreviousLogCount.Tip}" />
                        <controls:TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{DynamicResource ExternalNotification.LogTimeMinutes}" />
                        <hc:NumericUpDown
                            Height="30"
                            Margin="5,-10,0,-10"
                            hc:InfoElement.TitleWidth="0"
                            Maximum="10080"
                            Minimum="0"
                            Value="{Binding TimeMinutes}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.LogTimeMinutes.Tip}" />
                    </StackPanel>
                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource ExternalNotification.FilterPreviousLogs}" IsChecked="{Binding FilterPreviousLogs}" />
                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.FilterPreviousLogs.Tip}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Visibility="{c:Binding FilterPreviousLogs}">
                        <controls:TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            Text="{DynamicResource ExternalNotification.Blacklist}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBox
                            Height="Auto"
                            Padding="12,8"
                            VerticalContentAlignment="Top"
                            hc:InfoElement.TitleWidth="0"
                            AcceptsReturn="True"
                            MinLines="1"
                            Text="{Binding Blacklist, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Disabled" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <hc:Divider
                Width="460"
                Margin="0"
                Content="{DynamicResource ExternalNotification.Channels}" />
            <StackPanel Width="460" HorizontalAlignment="Center">
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <hc:SplitButton
                        Width="140"
                        Padding="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        hc:BorderElement.CornerRadius="4,0,0,4"
                        Background="{DynamicResource RegionBrushOpacity25}"
                        Content="{DynamicResource ExternalNotification.AddConfig}">
                        <hc:SplitButton.DropDownContent>
                            <Menu ItemsSource="{Binding ExternalNotificationProviderList, Source={x:Static settings_vms:ExternalNotificationSettingsUserControlModel.Instance}, Mode=OneWay}" MenuItem.Click="{s:Action AddConfig}">
                                <Menu.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </Menu.ItemsPanel>
                                <Menu.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource MenuItemBaseStyle}" TargetType="{x:Type MenuItem}">
                                        <Setter Property="Header" Value="{Binding Display}" />
                                    </Style>
                                </Menu.ItemContainerStyle>
                            </Menu>
                        </hc:SplitButton.DropDownContent>
                    </hc:SplitButton>
                    <Button
                        Width="Auto"
                        hc:BorderElement.CornerRadius="0,4,4,0"
                        BorderThickness="0,1,1,1"
                        Command="{s:Action ExternalNotificationSendTest,
                                           Target={x:Type settings_vms:ExternalNotificationSettingsUserControlModel}}"
                        Content="{DynamicResource ExternalNotification.SendTest}"
                        IsEnabled="{c:Binding 'ConfigCount > 0'}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Width="460"
                HorizontalAlignment="Center"
                Orientation="Vertical">
                <ListBox
                    dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    BorderThickness="0"
                    ItemsSource="{Binding ExternalNotificationConfigs}"
                    PreviewMouseWheel="{s:Action RouteMouseWheelToParentExceptScrollable,
                                                 Target={x:Type helper:MouseWheelHelper}}"
                    Style="{DynamicResource NoSelectedHighlightListBoxStyle}">

                    <d:ListBox.ItemsSource>
                        <x:Array Type="{x:Type config:BaseConfig}">
                            <config:ServerChanConfig />
                            <config:TelegramConfig />
                            <config:DiscordConfig />
                            <config:DingTalkConfig />
                            <config:SmtpConfig />
                            <config:BarkConfig />
                            <config:QmsgConfig />
                            <config:GotifyConfig />
                            <config:CustomWebhookConfig />
                        </x:Array>
                    </d:ListBox.ItemsSource>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type config:ServerChanConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch">
                                <StackPanel d:DataContext="{d:DesignInstance {x:Type config:ServerChanConfig}}" Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Server Chan" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.ServerChan.SendKey}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding SendKey}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:TelegramConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:TelegramConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Telegram" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Telegram.BotToken}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding BotToken}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Telegram.ChatId}"
                                        Text="{Binding ChatId}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Telegram.TopicId}"
                                        Text="{Binding TopicId}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:DiscordConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:DiscordConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Discord" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Discord.BotToken}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding BotToken}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Discord.UserId}"
                                        Text="{Binding UserId}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Discord.WebhookUrl}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding WebhookUrl}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:DingTalkConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:DingTalkConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="DingTalk" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.DingTalk.AccessToken}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding AccessToken}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.DingTalk.Secret}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding Secret}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:SmtpConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:SmtpConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="SMTP" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="10,5"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource ExternalNotification.Smtp.Ssl}"
                                            IsChecked="{Binding UseSsl}" />
                                        <CheckBox
                                            Margin="10,5"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource ExternalNotification.Smtp.Auth}"
                                            IsChecked="{Binding RequiresAuthentication}" />
                                    </StackPanel>
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.Server}"
                                        Text="{Binding Server}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.Port}"
                                        Text="{Binding Port}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        d:Visibility="Visible"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.User}"
                                        Text="{Binding Username}"
                                        Visibility="{c:Binding RequiresAuthentication}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        d:Visibility="Visible"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.Password}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding Password}"
                                        Visibility="{c:Binding RequiresAuthentication}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.From}"
                                        Text="{Binding From}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Smtp.To}"
                                        Text="{Binding To}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:BarkConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:BarkConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Bark" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Bark.Server}"
                                        Text="{Binding Server}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Bark.SendKey}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding SendKey}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:QmsgConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:QmsgConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Qmsg" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Qmsg.Server}"
                                        Text="{Binding Server}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Qmsg.Key}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding Key}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Qmsg.User}"
                                        Text="{Binding User}" />
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Qmsg.Bot}"
                                        Text="{Binding Bot}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:GotifyConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:GotifyConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="Gotify" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <hc:TextBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Gotify.Server}"
                                        Text="{Binding Server}" />
                                    <hc:PasswordBox
                                        Width="400"
                                        Height="30"
                                        Margin="10"
                                        hc:InfoElement.Title="{DynamicResource ExternalNotification.Gotify.Token}"
                                        IsSafeEnabled="False"
                                        ShowEyeButton="True"
                                        UnsafePassword="{Binding Token}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type config:CustomWebhookConfig}">
                            <Border
                                Margin="4"
                                Padding="8"
                                HorizontalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance {x:Type config:CustomWebhookConfig}}">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <hc:Divider
                                            Grid.Column="0"
                                            Margin="0,5,16,0"
                                            Content="{DynamicResource ExternalNotification.CustomWebhook}" />
                                        <Button
                                            Grid.Column="1"
                                            Width="25"
                                            Height="25"
                                            Margin="0,0,10,0"
                                            Padding="0"
                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                            hc:IconElement.Height="15"
                                            hc:IconElement.Width="15"
                                            Command="{s:Action RemoveConfig}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{DynamicResource Common.Delete}" />
                                    </Grid>
                                    <StackPanel Margin="10,10,0,10" Orientation="Horizontal">
                                        <hc:ComboBox
                                            Width="400"
                                            hc:InfoElement.Title="{DynamicResource ExternalNotification.CustomWebhook.Presets}"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding Source={x:Static template:WebhookPresetTemplate.BuiltInTemplates}}"
                                            SelectedValue="{Binding SelectedPresetTemplateId}"
                                            SelectedValuePath="Id" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.CustomWebhook.PresetsPlaceholders}" />
                                    </StackPanel>
                                    <StackPanel Margin="10" Orientation="Horizontal">
                                        <hc:TextBox
                                            Width="400"
                                            Height="30"
                                            hc:InfoElement.Title="{DynamicResource ExternalNotification.CustomWebhook.Url}"
                                            Text="{Binding Url}" />
                                        <!--  隐藏占位，与 Headers 行的 TooltipBlock 对齐  -->
                                        <controls:TooltipBlock TooltipText=" " Visibility="Hidden" />
                                    </StackPanel>
                                    <StackPanel Margin="10" Orientation="Horizontal">
                                        <hc:TextBox
                                            Width="400"
                                            MinHeight="60"
                                            VerticalContentAlignment="Top"
                                            hc:InfoElement.Placeholder="{DynamicResource ExternalNotification.CustomWebhook.HeadersPlaceholders}"
                                            hc:InfoElement.Title="{DynamicResource ExternalNotification.CustomWebhook.Headers}"
                                            AcceptsReturn="True"
                                            Text="{Binding Headers}"
                                            TextWrapping="Wrap" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource ExternalNotification.CustomWebhook.Headers.Tip}" />
                                    </StackPanel>
                                    <StackPanel Margin="10" Orientation="Horizontal">
                                        <hc:TextBox
                                            Width="400"
                                            MinHeight="60"
                                            Padding="6,3"
                                            VerticalContentAlignment="Top"
                                            hc:InfoElement.Placeholder="{DynamicResource ExternalNotification.CustomWebhook.Placeholders}"
                                            hc:InfoElement.Title="{DynamicResource ExternalNotification.CustomWebhook.Body}"
                                            AcceptsReturn="True"
                                            Text="{Binding Body}"
                                            TextWrapping="Wrap" />
                                        <!--  隐藏占位，与 Headers 行的 TooltipBlock 对齐  -->
                                        <controls:TooltipBlock TooltipText=" " Visibility="Hidden" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                    </ListBox.Resources>
                </ListBox>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
