<UserControl
    x:Class="MaaWpfGui.Views.UserControl.Settings.NotificationSettingsUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.Settings"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type settings_vms:NotificationSettingsUserControlModel}}"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <Grid MinWidth="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  日志输出停滞检测  -->
        <StackPanel Grid.Row="0" Orientation="Vertical">
            <CheckBox
                Margin="5"
                HorizontalAlignment="Center"
                Content="{DynamicResource StallTimeoutEnabled}"
                IsChecked="{Binding StallTimeoutEnabled}" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{c:Binding StallTimeoutEnabled}">
                <hc:NumericUpDown
                    Margin="5"
                    hc:InfoElement.Title="{DynamicResource StallTimeoutMinutes}"
                    hc:TitleElement.TitlePlacement="Left"
                    InputMethod.IsInputMethodEnabled="False"
                    Maximum="11451"
                    Minimum="1"
                    Value="{Binding StallTimeoutMinutes}" />
                <hc:NumericUpDown
                    Margin="5"
                    hc:InfoElement.Title="{DynamicResource ReminderIntervalMinutes}"
                    hc:TitleElement.TitlePlacement="Left"
                    InputMethod.IsInputMethodEnabled="False"
                    Minimum="1"
                    Value="{Binding ReminderIntervalMinutes}" />
            </StackPanel>
        </StackPanel>

        <!--  日志悬浮窗  -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <hc:Divider Content="{DynamicResource NotificationSettingsOverlay}" />
            <CheckBox
                Margin="5"
                HorizontalAlignment="Center"
                Content="{DynamicResource NotificationSettingsUseIndependent}"
                IsChecked="{Binding Overlay.UseIndependent}" />
            <StackPanel Visibility="{c:Binding 'Overlay.UseIndependent', FalseToVisibility=Collapsed}">
                <CheckBox
                    Margin="5"
                    HorizontalAlignment="Center"
                    Content="{DynamicResource NotificationSettingsEnableNotification}"
                    IsChecked="{Binding Overlay.Enable}" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <CheckBox
                        Width="150"
                        Margin="5"
                        Content="{DynamicResource NotificationSettingsEnableBlacklist}"
                        IsChecked="{Binding Overlay.EnableBlacklist}" />
                    <CheckBox
                        Margin="5"
                        Content="{DynamicResource NotificationSettingsEnableWhitelist}"
                        IsChecked="{Binding Overlay.EnableWhitelist}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Visibility="{c:Binding 'Overlay.UseIndependent &amp;&amp; Overlay.ShowFilterList'}">
                    <controls:TextBlock
                        Margin="0,10,0,5"
                        Text="{DynamicResource NotificationSettingsFilterList}" />
                    <TextBox
                        Width="400"
                        MinHeight="80"
                        Margin="0,0,0,10"
                        AcceptsReturn="True"
                        Text="{Binding Overlay.FilterList}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{c:Binding Overlay.ShowLimitFields}">
                    <Label
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource NotificationSettingsMaxEntries}" />
                    <hc:NumericUpDown
                        Width="100"
                        hc:InfoElement.TitleWidth="0"
                        Maximum="10000"
                        Minimum="0"
                        Value="{Binding Overlay.MaxEntries}" />
                    <Label
                        Padding="0"
                        BorderThickness="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource NotificationSettingsTimeMinutes}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource NotificationSettingsTimeMinutesTooltip}" />
                    <hc:NumericUpDown
                        Width="100"
                        hc:InfoElement.TitleWidth="0"
                        Maximum="10080"
                        Minimum="0"
                        Value="{Binding Overlay.TimeMinutes}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--  Windows系统通知  -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <hc:Divider
                Margin="0,20,0,10"
                Content="{DynamicResource NotificationSettingsSystemNotification}" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <CheckBox Content="{DynamicResource SystemNotification}" IsChecked="{Binding UseNotify}" />
                <controls:TooltipBlock TooltipText="{DynamicResource SystemNotificationInfo}" />
            </StackPanel>
        </StackPanel>

        <!--  外部通知  -->
        <StackPanel Grid.Row="3" Orientation="Vertical">
            <hc:Divider
                Margin="0,20,0,10"
                Content="{DynamicResource NotificationSettingsExternal}" />
            <CheckBox
                Margin="5"
                HorizontalAlignment="Center"
                Content="{DynamicResource NotificationSettingsUseIndependent}"
                IsChecked="{Binding External.UseIndependent}" />
            <StackPanel Visibility="{c:Binding 'External.UseIndependent', FalseToVisibility=Collapsed}">
                <CheckBox
                    Margin="5"
                    HorizontalAlignment="Center"
                    Content="{DynamicResource NotificationSettingsEnableNotification}"
                    IsChecked="{Binding External.Enable}" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <CheckBox
                        Width="150"
                        Margin="5"
                        Content="{DynamicResource NotificationSettingsEnableBlacklist}"
                        IsChecked="{Binding External.EnableBlacklist}" />
                    <CheckBox
                        Margin="5"
                        Content="{DynamicResource NotificationSettingsEnableWhitelist}"
                        IsChecked="{Binding External.EnableWhitelist}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Visibility="{c:Binding 'External.UseIndependent &amp;&amp; External.ShowFilterList'}">
                    <controls:TextBlock
                        Margin="0,10,0,5"
                        Text="{DynamicResource NotificationSettingsFilterList}" />
                    <TextBox
                        Width="400"
                        MinHeight="80"
                        Margin="0,0,0,10"
                        AcceptsReturn="True"
                        Text="{Binding External.FilterList}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{c:Binding External.ShowLimitFields}">
                    <Label
                        Padding="0"
                        BorderThickness="0"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource NotificationSettingsMaxEntries}" />
                    <hc:NumericUpDown
                        Width="100"
                        hc:InfoElement.TitleWidth="0"
                        Maximum="10000"
                        Minimum="0"
                        Value="{Binding External.MaxEntries}" />
                    <Label
                        Padding="0"
                        BorderThickness="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="{DynamicResource NotificationSettingsTimeMinutes}" />
                    <controls:TooltipBlock TooltipText="{DynamicResource NotificationSettingsTimeMinutesTooltip}" />
                    <hc:NumericUpDown
                        Width="100"
                        hc:InfoElement.TitleWidth="0"
                        Maximum="10080"
                        Minimum="0"
                        Value="{Binding External.TimeMinutes}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
