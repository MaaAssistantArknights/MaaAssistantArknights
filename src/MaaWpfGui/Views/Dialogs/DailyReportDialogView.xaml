<hc:Window
    x:Class="MaaWpfGui.Views.Dialogs.DailyReportDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    Title="{DynamicResource TaskQueue.DailyReport.Title}"
    Width="760"
    Height="560"
    MinWidth="460"
    MinHeight="360"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type ui_vms:DailyReportDialogViewModel}}"
    s:View.ActionTarget="{Binding}"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <hc:ButtonGroup DockPanel.Dock="Left">
                <RadioButton
                    MinWidth="44"
                    Content="{DynamicResource TaskQueue.DailyReport.Dimension.Day}"
                    IsChecked="{Binding IsDayDimension}" />
                <RadioButton
                    MinWidth="44"
                    Content="{DynamicResource TaskQueue.DailyReport.Dimension.Week}"
                    IsChecked="{Binding IsWeekDimension}" />
                <RadioButton
                    MinWidth="44"
                    Content="{DynamicResource TaskQueue.DailyReport.Dimension.Month}"
                    IsChecked="{Binding IsMonthDimension}" />
                <RadioButton
                    MinWidth="44"
                    Content="{DynamicResource TaskQueue.DailyReport.Dimension.Year}"
                    IsChecked="{Binding IsYearDimension}" />
            </hc:ButtonGroup>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <controls:TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="{DynamicResource TaskQueue.DailyReport.Retention}" />
                <ComboBox
                    MinWidth="110"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding RetentionOptions}"
                    SelectedValue="{Binding SelectedRetention}"
                    SelectedValuePath="Value" />
                <controls:TooltipBlock Margin="4,0,0,0" TooltipText="{DynamicResource TaskQueue.DailyReport.Retention.Tip}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                hc:IconElement.Geometry="{StaticResource LeftGeometry}"
                hc:IconElement.Height="12"
                hc:IconElement.Width="12"
                Command="{s:Action GoPrevious}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Style="{StaticResource ButtonIcon}" />
            <controls:TextBlock
                Grid.Column="2"
                MinWidth="140"
                Margin="8,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="Bold"
                Text="{Binding PeriodLabel}"
                TextAlignment="Center" />
            <Button
                Grid.Column="3"
                Width="32"
                Height="32"
                hc:IconElement.Geometry="{StaticResource RightGeometry}"
                hc:IconElement.Height="12"
                hc:IconElement.Width="12"
                Command="{s:Action GoNext}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                IsEnabled="{Binding CanGoNext}"
                Style="{StaticResource ButtonIcon}" />
        </Grid>

        <ItemsControl
            Grid.Row="2"
            Margin="-3,12,-3,10"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="3,0"
                        Padding="10,8"
                        Background="{DynamicResource RegionBrushOpacity25}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <controls:TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding Label}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Label}" />
                            <controls:TextBlock
                                Margin="0,2,0,0"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="{Binding Value}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ListBox
            Grid.Row="3"
            Padding="0"
            HorizontalContentAlignment="Stretch"
            d:ItemsSource="{d:SampleData ItemCount=3}"
            hc:ScrollViewer.IsInertiaEnabled="True"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Rows}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
            VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,8,10,4">
                        <DockPanel>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                Text="{Binding TimeText}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding Stage}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,2,0,6"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{Binding MetaText}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Drops}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Width="68"
                                        Margin="0,0,4,4"
                                        ToolTip="{Binding Name}">
                                        <Image
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Center"
                                            Source="{Binding Image}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding Count}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <controls:TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{DynamicResource TaskQueue.DailyReport.NoData}">
            <controls:TextBlock.Style>
                <Style TargetType="controls:TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:TextBlock.Style>
        </controls:TextBlock>
    </Grid>
</hc:Window>
