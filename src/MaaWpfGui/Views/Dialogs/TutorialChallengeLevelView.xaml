<hc:Window
    x:Class="MaaWpfGui.Views.Dialogs.TutorialChallengeLevelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs_vms="clr-namespace:MaaWpfGui.ViewModels.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:tutorialChallenge="clr-namespace:MaaWpfGui.Views.UserControl.TutorialChallenge"
    Title="{Binding WindowTitle}"
    Width="800"
    Height="560"
    MinWidth="800"
    MinHeight="560"
    d:DataContext="{d:DesignInstance {x:Type dialogs_vms:TutorialChallengeLevelViewModel}}"
    s:View.ActionTarget="{Binding}"
    AllowDrop="True"
    Background="{DynamicResource RegionBrush}"
    PreviewDragOver="{s:Action SandboxPackagePreviewDragOver}"
    PreviewDrop="{s:Action SandboxPackageDrop}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  目标区：关卡目标描述与达成状态  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <controls:TextBlock
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="{Binding Title}" />
                <controls:TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding Goal}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="4"
                    Visibility="{c:Binding IsCompleted,
                                           FalseToVisibility=Hidden}">
                    <controls:TextBlock Foreground="{DynamicResource TextIconBrush}" Text="{DynamicResource TutorialChallenge.Completed}" />
                </Border>
                <Button
                    Margin="8,0,0,0"
                    Command="{s:Action Reset}"
                    Content="{DynamicResource TutorialChallenge.Reset}" />
            </StackPanel>
        </Grid>

        <!--  双页签布局对齐真实主窗口（TabControlInLine）：页签集合由 VM 按关卡场景动态生成（单页关卡只建自己的页签，不占隐藏页签位），任务队列页为既有操作场，设置页为沙盒设置骨架；两页皆无时整控隐藏（如拖拽更新关只留投放区）  -->
        <TabControl
            Grid.Row="1"
            Background="{DynamicResource RegionBrushOpacity25}"
            BorderThickness="0,1,0,0"
            ItemsSource="{Binding SandboxPages}"
            SelectedIndex="{Binding SelectedTab}"
            Style="{StaticResource TabControlInLine}"
            Visibility="{c:Binding 'ShowTaskQueuePanel or ShowSettingsPanel'}">
            <TabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource TabItemInLine}" TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
                </Style>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengeSandboxPage}">
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengeSandboxPage}">
                    <!--  页签条目只是页描述对象，内容显式绑回窗口 VM；按 Kind 用 DataTrigger 换内容模板（Setter.Value 直接赋 DataTemplate，不经 CalcBinding）  -->
                    <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=hc:Window}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <tutorialChallenge:TutorialChallengeTaskQueueUserControl />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs_vms:TutorialChallengeSandboxPageKind.Settings}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <tutorialChallenge:TutorialChallengeSettingsUserControl />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!--  更新包投放区：仅 ｢拖拽更新｣ 关卡显示，整窗任意位置均可拖入；独立于 TabControl（该关无任务/设置页），描边框仅作状态清单展示，下方三项识别状态  -->
        <Border
            Grid.Row="1"
            Margin="8,8,8,0"
            Padding="10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{c:Binding ShowDropZonePanel}">
            <StackPanel>
                <controls:TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.Tip}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <!--  三项识别状态清单：识别成功后勾选，未识别为灰色未勾态；只读展示，不可交互  -->
                <StackPanel Margin="0,8,0,0">
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding FullPackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.FullPackage}" />
                    </CheckBox>
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding OtaPackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.OtaPackage}" />
                    </CheckBox>
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding ResourcePackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.ResourcePackage}" />
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,0,0,5" hc:Growl.Token="TutorialChallenge" />
        </ScrollViewer>
    </Grid>
</hc:Window>
