<hc:Window
    x:Class="MaaWpfGui.Views.Dialogs.TutorialChallengeLevelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:constants="clr-namespace:MaaWpfGui.Constants"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:converters="clr-namespace:MaaWpfGui.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:dialogs_vms="clr-namespace:MaaWpfGui.ViewModels.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:MaaWpfGui.Helper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:MaaWpfGui.Styles.Properties"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue="clr-namespace:MaaWpfGui.Configuration.Single.MaaTask"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    Title="{Binding WindowTitle}"
    Width="640"
    Height="560"
    MinWidth="640"
    MinHeight="560"
    d:DataContext="{d:DesignInstance {x:Type dialogs_vms:TutorialChallengeLevelViewModel}}"
    s:View.ActionTarget="{Binding}"
    AllowDrop="True"
    Background="{DynamicResource RegionBrush}"
    PreviewDragOver="{s:Action SandboxPackagePreviewDragOver}"
    PreviewDrop="{s:Action SandboxPackageDrop}"
    mc:Ignorable="d">
    <hc:Window.Resources>
        <converters:ItemImageConverter x:Key="ItemImageConverter" />
        <converters:SubtractConverter x:Key="SubtractConverter" />
        <CollectionViewSource x:Key="SandboxSettingsNavigation" Source="{Binding SandboxSettingSections}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="IsAdvanced" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <ItemsPanelTemplate x:Key="VerticalStackItemsPanel">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <Style
            x:Key="StageComboBoxItemStyle"
            BasedOn="{StaticResource ComboBoxItemBaseStyle}"
            TargetType="ComboBoxItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="StageComboBoxItemTemplate">
            <TextBlock Text="{Binding Display}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                <Setter Property="Foreground" Value="{DynamicResource ErrorLogBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <!--  沙盒设置页分区模板：分区容器（Grid.Row/Visibility）由 code-behind 动态生成并显式套用本模板，对齐真实设置页「分区是内容 Grid 的直接子元素」的结构  -->
        <DataTemplate x:Key="SandboxSettingSectionTemplate" DataType="{x:Type dialogs_vms:TutorialChallengeSettingSection}">
            <Expander
                Background="Transparent"
                Header="{Binding Display}"
                IsExpanded="True">
                <Border
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4">
                    <Grid>
                        <!--  定时执行分区：简化照抄真实 TimerSettingsUserControl，单定时项 + 强制定时启动；DataContext 只能挂在内层，外层要读分区 Kind 判显隐  -->
                        <StackPanel Margin="0,20" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs_vms:TutorialChallengeSettingSectionKind.Schedule}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel
                                HorizontalAlignment="Center"
                                DataContext="{Binding DataContext.SandboxSchedule, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                Orientation="Horizontal">
                                <StackPanel Margin="10,5" Orientation="Horizontal">
                                    <CheckBox
                                        VerticalContentAlignment="Center"
                                        Content="{DynamicResource TaskQueue.Schedule.ForceScheduledStart}"
                                        IsChecked="{Binding ForceScheduledStart}" />
                                    <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.Schedule.ForceScheduledStart.Tip}" />
                                </StackPanel>
                                <StackPanel Margin="10,5" Orientation="Horizontal">
                                    <CheckBox
                                        VerticalContentAlignment="Center"
                                        Content="{DynamicResource TaskQueue.Schedule.ShowWindowBeforeForceScheduledStart}"
                                        IsChecked="{Binding ShowWindowBeforeForceScheduledStart}"
                                        Visibility="{c:Binding ForceScheduledStart}" />
                                    <controls:TooltipBlock
                                        VerticalAlignment="Center"
                                        TooltipText="{DynamicResource TaskQueue.Schedule.ShowWindowBeforeForceScheduledStart.Tip}"
                                        Visibility="{c:Binding ForceScheduledStart}" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl DataContext="{Binding DataContext.SandboxSchedule, RelativeSource={RelativeSource AncestorType=hc:Window}}" ItemsSource="{Binding TimerList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <CheckBox
                                                Margin="10,5"
                                                IsChecked="{Binding IsEnabled}"
                                                MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                              Target={x:Type helper:CheckBoxHelper}}"
                                                ToolTip="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNull}">
                                                <TextBlock><Run Text="{DynamicResource TaskQueue.Schedule.Timer}" /><Run xml:space="preserve" Text=" " /><Run Text="{c:Binding 'Id + 1', Mode=OneWay}" /></TextBlock>
                                            </CheckBox>
                                            <StackPanel Orientation="Horizontal">
                                                <hc:NumericUpDown
                                                    Width="55"
                                                    Margin="10,5"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    IsEnabled="{c:Binding 'IsEnabled ?? &quot;True&quot;'}"
                                                    Maximum="23"
                                                    Minimum="0"
                                                    ValueFormat="00"
                                                    Value="{Binding Hour}" />
                                                <controls:TextBlock Text=":" />
                                                <hc:NumericUpDown
                                                    Width="55"
                                                    Margin="10,5"
                                                    InputMethod.IsInputMethodEnabled="False"
                                                    IsEnabled="{c:Binding 'IsEnabled ?? &quot;True&quot;'}"
                                                    Maximum="59"
                                                    Minimum="0"
                                                    ValueFormat="00"
                                                    Value="{Binding Minute}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  问题反馈分区：结构照抄真实 IssueReportUserControl（去掉更新提示态与 reports 按钮）；外层沿分区 DataContext 判 Kind，内层 Grid 挂回窗口 VM 读沙盒态。生成按钮保留沙盒 ExportLogs 动作与 ｢生成中…｣ 文案切换，Enable 用沙盒 CanExportLogs  -->
                        <StackPanel
                            MaxWidth="450"
                            Margin="0,20"
                            HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs_vms:TutorialChallengeSettingSectionKind.IssueReport}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <controls:TextBlock
                                MaxWidth="450"
                                Margin="5"
                                HorizontalAlignment="Center"
                                Block.TextAlignment="Center"
                                Text="{DynamicResource Error.CheckHelpBeforeReportingIssue}"
                                TextWrapping="Wrap" />
                            <Grid HorizontalAlignment="Stretch" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=hc:Window}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <controls:TextBlock Margin="5" HorizontalAlignment="Center">
                                        <Hyperlink
                                            Cursor="Hand"
                                            NavigateUri="{Binding Source={x:Static constants:MaaUrls.HelpUri}}"
                                            TextDecorations="None">
                                            <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Error.Help}" />
                                        </Hyperlink>
                                    </controls:TextBlock>
                                    <controls:TextBlock Margin="5" HorizontalAlignment="Center">
                                        <Hyperlink
                                            Command="{s:Action SetAcknowledgedNightlyWarning}"
                                            Cursor="Hand"
                                            NavigateUri="{Binding Source={x:Static constants:MaaUrls.GitHubIssues}}"
                                            TextDecorations="None">
                                            <TextBlock Style="{StaticResource HyperlinkTextBlockStyle}" Text="{DynamicResource Error.Issue}" />
                                        </Hyperlink>
                                    </controls:TextBlock>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Button
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        Command="{s:Action ExportLogs}"
                                        IsEnabled="{Binding CanExportLogs}">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Error.GenerateSupportPayload}" Visibility="{c:Binding !IsExportingLogs}" />
                                            <TextBlock Text="{DynamicResource TutorialChallenge.Level.ExportLogs.Generating}" Visibility="{c:Binding IsExportingLogs}" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Margin="5,2"
                                        HorizontalAlignment="Left"
                                        Command="{s:Action OpenDebugFolder}"
                                        Content="{DynamicResource Error.OpenDebugFolder}" />
                                    <StackPanel Margin="5,2" Orientation="Horizontal">
                                        <Button
                                            HorizontalAlignment="Left"
                                            Command="{s:Action ClearImageCache}"
                                            Content="{DynamicResource Error.ClearImageCache}"
                                            IsEnabled="{Binding CanClearImageCache}" />
                                        <controls:TooltipBlock TooltipText="{DynamicResource Error.ClearImageCache.Tip}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!--  ｢设置搜索｣ 关卡干扰分区：随机 CheckBox 群，CheckBox 的 IsChecked 直接写回项实例  -->
                        <StackPanel Margin="0,20" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs_vms:TutorialChallengeSettingSectionKind.Decoy}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengeDecoyItem}">
                                        <CheckBox
                                            Margin="10,5"
                                            Content="{Binding Text}"
                                            IsChecked="{Binding IsChecked}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="DropComboBoxItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Grid
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center">
                    <!--  ｢不选择｣ 空值项无图标，以描边圆环占位，保持与图标项的文字对齐  -->
                    <Ellipse
                        Stroke="{DynamicResource BorderBrush}"
                        StrokeThickness="1"
                        Visibility="{c:Binding 'Value.Length == 0'}" />
                    <Image Source="{Binding Value, Converter={StaticResource ItemImageConverter}}" />
                </Grid>
                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Display}" />
            </StackPanel>
        </DataTemplate>
    </hc:Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  目标区：关卡目标描述与达成状态  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <controls:TextBlock
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="{Binding Title}" />
                <controls:TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding Goal}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="4"
                    Visibility="{c:Binding IsCompleted}">
                    <controls:TextBlock Foreground="{DynamicResource TextIconBrush}" Text="{DynamicResource TutorialChallenge.Completed}" />
                </Border>
                <Button
                    Margin="8,0,0,0"
                    Command="{s:Action Reset}"
                    Content="{DynamicResource TutorialChallenge.Reset}" />
            </StackPanel>
        </Grid>

        <!--  双页签布局对齐真实主窗口（TabControlInLine）：任务队列页为既有操作场，设置页为沙盒设置骨架  -->
        <TabControl
            Grid.Row="1"
            Background="{DynamicResource RegionBrushOpacity25}"
            BorderThickness="0,1,0,0"
            SelectedIndex="{Binding SelectedTab}"
            Style="{StaticResource TabControlInLine}">
            <TabItem Header="{DynamicResource TaskQueue.Farming}" Style="{StaticResource TabItemInLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左列：沙盒任务队列；条目交互对齐真实任务队列（名称/齿轮选中/悬停按钮/右键菜单），数据仅沙盒内  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox
                            Grid.Row="0"
                            Margin="0,10,0,0"
                            HorizontalContentAlignment="Stretch"
                            dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.IsDropTarget="True"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding SandboxItems}"
                            Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                            ToolTip="{DynamicResource Common.LabelSequence.Tip}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengeSandboxItem}">
                                    <Border CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  齿轮整行铺底：点击空白处也能打开任务设置；悬浮操作按钮在其上层。不用 hc:ButtonGroup 包装（其 ItemsControl 容器把子项封成 DataItem，UIA 拿不到 RadioButton 原生 pattern），单裸 RadioButton 加 GroupName 即够  -->
                                            <RadioButton
                                                Grid.ColumnSpan="2"
                                                Margin="0,0,4,0"
                                                Padding="0"
                                                HorizontalContentAlignment="Right"
                                                hc:VisualElement.HighlightBackground="Transparent"
                                                hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                                AutomationProperties.Name="{DynamicResource TaskQueue.TaskSettings}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                GroupName="SandboxTaskSettings"
                                                IsChecked="{Binding EnableSetting}"
                                                Style="{DynamicResource RadioGroupItemSingle}">
                                                <Grid
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Right">
                                                    <Path
                                                        Data="{StaticResource ConfigGeometry}"
                                                        Stretch="Uniform"
                                                        Visibility="{c:Binding !EnableSetting}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <Path
                                                        Data="{StaticResource ConfigGeometry2}"
                                                        Fill="{DynamicResource PrimaryBrush}"
                                                        Stretch="Uniform"
                                                        Visibility="{c:Binding EnableSetting}" />
                                                </Grid>
                                                <RadioButton.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.LeftClick}" />
                                                            <TextBlock Text="{DynamicResource TaskQueue.TaskSettings}" />
                                                            <TextBlock FontWeight="SemiBold" Text="{DynamicResource TaskQueue.RightClick}" />
                                                            <TextBlock>
                                                                <Run Text="{DynamicResource TaskQueue.MoveUp}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.MoveDown}" /><Run Text="/" /><Run Text="{DynamicResource Common.Copy}" /><Run Text="/" /><Run Text="{DynamicResource TaskQueue.Rename}" /><Run Text="/" /><Run Text="{DynamicResource Common.Delete}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </RadioButton.ToolTip>
                                                <RadioButton.ContextMenu>
                                                    <ContextMenu Width="150">
                                                        <MenuItem
                                                            Command="{s:Action MoveTaskUp}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="{DynamicResource TaskQueue.MoveUp}"
                                                            IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem
                                                            Command="{s:Action MoveTaskDown}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="{DynamicResource TaskQueue.MoveDown}"
                                                            IsEnabled="{Binding PlacementTarget.DataContext.CanMoveDown, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem
                                                            Command="{s:Action CopyTask}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="{DynamicResource Common.Copy}"
                                                            IsEnabled="{Binding PlacementTarget.DataContext.CanCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem
                                                            Command="{s:Action RenameTask}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="{DynamicResource TaskQueue.Rename}" />
                                                        <MenuItem
                                                            Command="{s:Action RemoveTask}"
                                                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                            Header="{DynamicResource Common.Delete}" />
                                                    </ContextMenu>
                                                </RadioButton.ContextMenu>
                                            </RadioButton>

                                            <CheckBox
                                                Grid.Column="0"
                                                MaxWidth="140"
                                                Margin="4.5,0,0,0"
                                                HorizontalAlignment="Left"
                                                IsChecked="{Binding Task.IsEnable}"
                                                MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                              Target={x:Type helper:CheckBoxHelper}}">
                                                <controls:TextBlock Text="{Binding DisplayName}" Visibility="Hidden" />
                                                <CheckBox.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock HorizontalAlignment="Left">
                                                                <TextBlock.Style>
                                                                    <Style BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNull}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Source={x:Static ui_vms:SettingsViewModel.GuiSettings}, Path=MainTasksInvertNullFunction}" Value="True">
                                                                                <Setter Property="Text" Value="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNullInvert}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock HorizontalAlignment="Left" Text="{DynamicResource TaskQueue.MainTasksNullFunctionality.Switch}" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </CheckBox.ToolTip>
                                            </CheckBox>
                                            <controls:TextBlock
                                                Grid.Column="0"
                                                Margin="26,0,4,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                IsHitTestVisible="False"
                                                Text="{Binding DisplayName}">
                                                <controls:TextBlock.Style>
                                                    <Style BasedOn="{StaticResource MaaTextBlockDefaultStyle}" TargetType="{x:Type controls:TextBlock}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Source={x:Static ui_vms:SettingsViewModel.GuiSettings}, Path=MainTasksInvertNullFunction}" Value="True" />
                                                                    <Condition Binding="{Binding Task.IsEnable}" Value="{x:Null}" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="{DynamicResource TraceLogBrush}" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:TextBlock.Style>
                                            </controls:TextBlock>

                                            <!--  悬浮操作按钮：复制/重命名/删除，同真实任务项  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="0,0,26,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}, AncestorLevel=1}}" Value="True" />
                                                                    <Condition Binding="{Binding Source={x:Static ui_vms:SettingsViewModel.GuiSettings}, Path=HideHoverActionButtons}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource CopyTaskGeometry}"
                                                    Command="{s:Action CopyTask}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{c:Binding CanCopy}"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="{DynamicResource Common.Copy}" />
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource RenameTaskGeometry}"
                                                    Command="{s:Action RenameTask}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="{DynamicResource TaskQueue.Rename}" />
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                    Command="{s:Action RemoveTask}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TaskActionButtonStyle}"
                                                    ToolTip="{DynamicResource Common.Delete}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="24.5" />
                                    <Setter Property="Height" Value="Auto" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Grid.Column="0"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <controls:MenuButton
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    hc:BorderElement.CornerRadius="4,0,0,4"
                                    hc:IconElement.Geometry="{StaticResource TaskQueueAddTaskIcon}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Style="{StaticResource MaaButtonDefaultStyle}"
                                    ToolTip="{DynamicResource TaskQueue.AddTask}">
                                    <controls:MenuButton.PopupContent>
                                        <Border
                                            Width="190"
                                            Margin="8"
                                            Padding="2,2,2,0"
                                            Background="{DynamicResource RegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Effect="{DynamicResource EffectShadow2}">
                                            <!--  本版 HandyControls 的 Menu 顶级项模板默认无最小高度，需在容器样式显式补 MinHeight  -->
                                            <Menu
                                                Padding="0"
                                                ItemsPanel="{StaticResource VerticalStackItemsPanel}"
                                                ItemsSource="{Binding TaskTypeList}">
                                                <Menu.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource MaaMenuItemDefaultStyle}" TargetType="MenuItem">
                                                        <Setter Property="MinHeight" Value="{StaticResource DefaultControlHeight}" />
                                                        <Setter Property="Command" Value="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                                        <Setter Property="CommandParameter" Value="{Binding Value}" />
                                                        <Setter Property="Header" Value="{Binding}" />
                                                        <Setter Property="HeaderTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Display}" />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <!--  开始唤醒至多一个，已有则禁用  -->
                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Type taskQueue:StartUpTask}">
                                                                <Setter Property="IsEnabled" Value="{c:Binding 'DataContext.StartUpTaskCount less 1', RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Menu.ItemContainerStyle>
                                            </Menu>
                                        </Border>
                                    </controls:MenuButton.PopupContent>
                                </controls:MenuButton>
                            </Grid>
                            <Button
                                Grid.Column="1"
                                Height="30"
                                Margin="-1,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                hc:BorderElement.CornerRadius="0"
                                Command="{s:Action SelectedAll}"
                                Content="{DynamicResource TaskQueue.SelectAll}" />
                            <Button
                                Grid.Column="2"
                                Height="30"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                hc:BorderElement.CornerRadius="0,4,4,0"
                                Command="{s:Action ClearAll}"
                                Content="{DynamicResource Common.Clear}" />
                        </Grid>
                    </Grid>

                    <!--  右列：随齿轮选中任务切换的沙盒设置面板  -->
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Background="{DynamicResource RegionBrushOpacity25}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  更新包投放区：仅 ｢拖拽更新｣ 关卡显示，整窗任意位置均可拖入；描边框仅作状态清单展示，下方三项识别状态  -->
                            <Border
                                Grid.Row="0"
                                Margin="8,8,8,0"
                                Padding="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{c:Binding ShowDropZonePanel}">
                                <StackPanel>
                                    <controls:TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.Hint}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <!--  三项识别状态清单：识别成功后勾选，未识别为灰色未勾态；只读展示，不可交互  -->
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox
                                            Margin="0,2"
                                            Focusable="False"
                                            IsChecked="{Binding FullPackageIdentified, Mode=OneWay}"
                                            IsHitTestVisible="False">
                                            <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.FullPackage}" />
                                        </CheckBox>
                                        <CheckBox
                                            Margin="0,2"
                                            Focusable="False"
                                            IsChecked="{Binding OtaPackageIdentified, Mode=OneWay}"
                                            IsHitTestVisible="False">
                                            <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.OtaPackage}" />
                                        </CheckBox>
                                        <CheckBox
                                            Margin="0,2"
                                            Focusable="False"
                                            IsChecked="{Binding ResourcePackageIdentified, Mode=OneWay}"
                                            IsHitTestVisible="False">
                                            <controls:TextBlock Text="{DynamicResource TutorialChallenge.Level.DragDropUpdate.DropZone.ResourcePackage}" />
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <hc:ScrollViewer
                                Grid.Row="1"
                                Margin="8,8,8,0"
                                IsInertiaEnabled="True"
                                PanningMode="Both">
                                <Grid>
                                    <!--  未选中任务提示  -->
                                    <controls:TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{DynamicResource TutorialChallenge.SelectTaskHint}"
                                        Visibility="{c:Binding 'SelectedTask == null'}" />

                                    <!--  已选中但无对应模拟面板（开始唤醒等未模拟类型）  -->
                                    <controls:TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="{DynamicResource TutorialChallenge.NoSimulatedPanel}"
                                        Visibility="{c:Binding 'SelectedTask != null and !ShowFightPanel and !ShowDepotMaintainPanel and !ShowRecruitPanel'}" />

                                    <!--  理智作战沙盒面板：结构照抄真实 FightTaskUserControl 普通区+高级区，仅数据源换到沙盒任务；改真实面板时须同步此处  -->
                                    <StackPanel Visibility="{c:Binding ShowFightPanel}">
                                        <Grid Visibility="{c:Binding !EnableAdvancedSettings}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical">
                                                    <CheckBox
                                                        Height="30"
                                                        Margin="6"
                                                        VerticalContentAlignment="Center"
                                                        Content="{DynamicResource TaskQueue.Fight.UseSanityPotion}"
                                                        IsChecked="{Binding SelectedFightTask.UseMedicine}"
                                                        IsEnabled="{c:Binding !SandboxUseStoneDisplay}"
                                                        MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                                      Target={x:Type helper:CheckBoxHelper}}"
                                                        ToolTip="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNull}" />
                                                    <CheckBox
                                                        Height="30"
                                                        Margin="6"
                                                        VerticalContentAlignment="Center"
                                                        IsChecked="{Binding SelectedFightTask.UseStone}"
                                                        MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                                      Target={x:Type helper:CheckBoxHelper}}"
                                                        ToolTip="{DynamicResource TaskQueue.CheckBoxesNotSaved}">
                                                        <TextBlock>
                                                            <Run Text="{DynamicResource TaskQueue.Fight.UseOriginitePrime}" /><Run Text="{c:Binding '(SelectedFightTask.UseStoneAllowSave ? &quot;&quot; : &quot;*&quot;)'}" />
                                                        </TextBlock>
                                                    </CheckBox>
                                                    <CheckBox
                                                        Height="30"
                                                        Margin="6"
                                                        VerticalContentAlignment="Center"
                                                        Content="{DynamicResource TaskQueue.Fight.PerformBattles}"
                                                        IsChecked="{Binding SelectedFightTask.EnableTimesLimit}"
                                                        MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                                      Target={x:Type helper:CheckBoxHelper}}"
                                                        ToolTip="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNull}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                                    <hc:NumericUpDown
                                                        Width="70"
                                                        Height="30"
                                                        Margin="6"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        IsEnabled="{c:Binding !SandboxUseStoneDisplay}"
                                                        Maximum="999"
                                                        Minimum="0"
                                                        Value="{Binding SelectedFightTask.MedicineCount, UpdateSourceTrigger=PropertyChanged}" />
                                                    <hc:NumericUpDown
                                                        Width="70"
                                                        Height="30"
                                                        Margin="6"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Maximum="999"
                                                        Minimum="0"
                                                        Value="{Binding SelectedFightTask.StoneCount, UpdateSourceTrigger=PropertyChanged}" />
                                                    <hc:NumericUpDown
                                                        Width="70"
                                                        Height="30"
                                                        Margin="6"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Maximum="999"
                                                        Minimum="0"
                                                        Value="{Binding SelectedFightTask.TimesLimit, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid Margin="6">
                                                    <CheckBox
                                                        Height="30"
                                                        VerticalContentAlignment="Center"
                                                        Content="{DynamicResource TaskQueue.Fight.AssignedMaterial}"
                                                        IsChecked="{Binding SandboxEnableTargetDrop}"
                                                        MouseRightButtonUp="{s:Action ToggleCheckBoxNullOnRightClick,
                                                                                      Target={x:Type helper:CheckBoxHelper}}"
                                                        ToolTip="{DynamicResource TaskQueue.CheckBoxesNotSavedAsNull}" />
                                                    <controls:TooltipBlock
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        NormalOpacity="0.25"
                                                        TooltipText="{DynamicResource TaskQueue.Fight.SpecifiedDrops.Tip}" />
                                                </Grid>
                                                <hc:ButtonGroup
                                                    Grid.Row="1"
                                                    MaxWidth="88"
                                                    Margin="6,6,6,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical"
                                                    Visibility="{c:Binding SandboxEnableTargetDrop}">
                                                    <RadioButton
                                                        hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                                        Background="{DynamicResource RegionBrushOpacity25}"
                                                        Content="{DynamicResource TaskQueue.Fight.Quantity}"
                                                        IsChecked="{Binding UseDropQuantityMode}" />
                                                    <RadioButton
                                                        hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                                        Background="{DynamicResource RegionBrushOpacity25}"
                                                        Content="{DynamicResource TaskQueue.Fight.TargetInventory}"
                                                        IsChecked="{Binding UseTargetInventoryMode}" />
                                                </hc:ButtonGroup>
                                                <Grid Grid.Column="1">
                                                    <ComboBox
                                                        Height="30"
                                                        Margin="6"
                                                        Padding="28,5,10,5"
                                                        VerticalContentAlignment="Center"
                                                        DropDownClosed="{s:Action DropsListDropDownClosed}"
                                                        IsEditable="True"
                                                        IsTextSearchEnabled="False"
                                                        ItemTemplate="{StaticResource DropComboBoxItemTemplate}"
                                                        ItemsSource="{Binding DropsList}"
                                                        Loaded="{s:Action MakeComboBoxSearchable,
                                                                          Target={x:Type ui_vms:SettingsViewModel}}"
                                                        SelectedValue="{Binding SelectedFightTask.DropId}"
                                                        SelectedValuePath="Value"
                                                        Text="{Binding DropsItemName}" />
                                                    <!--  选中材料缩略图：IsEditable ComboBox 收起态显示区是纯文本 TextBox 无法内嵌图片，以不命中浮层贴在框内左侧，ComboBox 用 Padding 为其让出文本起点；｢不选择｣ 无图标，同位以描边圆环占位  -->
                                                    <Ellipse
                                                        Width="16"
                                                        Height="16"
                                                        Margin="13,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Stroke="{DynamicResource BorderBrush}"
                                                        StrokeThickness="1"
                                                        Visibility="{c:Binding 'SelectedFightTask.DropId.Length == 0'}" />
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Margin="12,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Source="{Binding SelectedFightTask.DropId, Converter={StaticResource ItemImageConverter}}" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">
                                                    <hc:NumericUpDown
                                                        Height="30"
                                                        MinWidth="60"
                                                        Margin="6"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Maximum="1145141919"
                                                        Minimum="1"
                                                        Visibility="{c:Binding SandboxEnableTargetDrop}"
                                                        Value="{Binding SelectedFightTask.DropCount, UpdateSourceTrigger=PropertyChanged}" />
                                                    <StackPanel Margin="6,2,6,0" Visibility="{c:Binding SandboxIsInventoryTarget}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:TextBlock Text="{DynamicResource TaskQueue.Stage.Label.Inventory}" />
                                                            <controls:TextBlock Margin="4,0,0,0" Text=":" />
                                                            <controls:TextBlock Margin="4,0,0,0" Text="{Binding CurrentDropsInventoryText}" />
                                                            <controls:TooltipBlock Margin="4,0,0,0" TooltipText="{DynamicResource TaskQueue.Fight.InventoryUpdate.Tip}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                            <controls:TextBlock Text="{DynamicResource TaskQueue.Fight.Quantity}" />
                                                            <controls:TextBlock Margin="4,0,0,0" Text=":" />
                                                            <controls:TextBlock Margin="4,0,0,0" Text="{Binding EffectiveDropsQuantityText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2" Visibility="{c:Binding !SelectedFightTask.HideSeries}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Vertical">
                                                    <Grid Height="42">
                                                        <controls:TextBlock
                                                            Margin="0,6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Text="{DynamicResource TaskQueue.Fight.Series}"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                        <controls:TooltipBlock
                                                            Margin="0,5,6,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            NormalOpacity="0.25"
                                                            TooltipText="{DynamicResource TaskQueue.Fight.Series.Tip}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                                    <ComboBox
                                                        Height="30"
                                                        Margin="6"
                                                        VerticalContentAlignment="Center"
                                                        DisplayMemberPath="Display"
                                                        ItemsSource="{Binding SeriesList}"
                                                        SelectedValue="{Binding SelectedFightTask.Series}"
                                                        SelectedValuePath="Value" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <controls:TextBlock
                                                        Margin="6,11"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Text="{DynamicResource TaskQueue.Fight.StageSelect}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Visibility="{c:Binding !SandboxUseOptionalStage}" />
                                                    <controls:TextBlock
                                                        Margin="6,11"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Text="{DynamicResource TaskQueue.Fight.CandidateStages}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"
                                                        Visibility="{c:Binding SandboxUseOptionalStage}" />
                                                    <controls:TooltipBlock
                                                        Margin="0,5,6,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        MouseEnter="{s:Action StagePlanTipRefresh}"
                                                        NormalOpacity="0.25"
                                                        TooltipText="{Binding StagePlanTip}" />
                                                    <Button
                                                        Grid.Row="1"
                                                        Margin="6"
                                                        VerticalAlignment="Bottom"
                                                        Command="{s:Action AddStageToPlan}"
                                                        Content="{DynamicResource TaskQueue.Fight.AddCandidateStage}"
                                                        Visibility="{c:Binding SandboxUseOptionalStage}" />
                                                </Grid>
                                                <ListBox
                                                    Grid.Column="1"
                                                    MinHeight="{c:Binding 'SandboxUseOptionalStage ? 75 : 0'}"
                                                    Margin="6,6"
                                                    Padding="-1"
                                                    VerticalAlignment="Top"
                                                    HorizontalContentAlignment="Stretch"
                                                    dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                                                    dd:DragDrop.IsDragSource="{c:Binding SandboxUseOptionalStage}"
                                                    dd:DragDrop.IsDropTarget="{c:Binding SandboxUseOptionalStage}"
                                                    BorderThickness="{c:Binding 'SandboxUseOptionalStage ? 1 : 0'}"
                                                    ClipToBounds="False"
                                                    ItemsSource="{Binding StagePlanRows}"
                                                    PreviewMouseWheel="{s:Action RouteMouseWheelToParentExceptScrollable,
                                                                                 Target={x:Type helper:MouseWheelHelper}}"
                                                    Style="{DynamicResource NoSelectedHighlightListBoxStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengeStagePlanRow}">
                                                            <Grid x:Name="StageItemGrid" Margin="0,0,0,-2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Height="30"
                                                                    Margin="-10,0,0,0">
                                                                    <!--  当 IsStageManually 为 false 时显示 ComboBox  -->
                                                                    <ComboBox
                                                                        IsEnabled="{c:Binding '!DataContext.IsStageItemDragging',
                                                                                              RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                        ItemContainerStyle="{StaticResource StageComboBoxItemStyle}"
                                                                        ItemTemplate="{StaticResource StageComboBoxItemTemplate}"
                                                                        ItemsSource="{Binding DataContext.StageListSource, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                        ScrollViewer.CanContentScroll="False"
                                                                        SelectedValue="{Binding Stage}"
                                                                        SelectedValuePath="Value"
                                                                        Visibility="{c:Binding '!DataContext.SelectedFightTask.IsStageManually',
                                                                                               RelativeSource={RelativeSource AncestorType=hc:Window}}" />

                                                                    <!--  当 IsStageManually 为 true 时显示 TextBox  -->
                                                                    <TextBox
                                                                        Height="30"
                                                                        hc:InfoElement.Placeholder="{DynamicResource TaskQueue.Stage.Label.Default}"
                                                                        IsEnabled="{c:Binding '!DataContext.IsStageItemDragging',
                                                                                              RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                        Opacity="{c:Binding 'IsOpen ? 1 : 0.5'}"
                                                                        Text="{Binding Stage, UpdateSourceTrigger=PropertyChanged}"
                                                                        ToolTip="{DynamicResource TaskQueue.CustomStageCode.Tip}"
                                                                        Visibility="{c:Binding 'DataContext.SelectedFightTask.IsStageManually',
                                                                                               RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                                                </Grid>

                                                                <Border Grid.Column="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=StageItemGrid}" Value="True" />
                                                                                        <Condition Binding="{c:Binding 'DataContext.SandboxUseOptionalStage', RelativeSource={RelativeSource AncestorType=hc:Window}}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <!--  拖动手柄  -->
                                                                        <Button
                                                                            Margin="0"
                                                                            Padding="2"
                                                                            VerticalAlignment="Stretch"
                                                                            hc:IconElement.Geometry="{StaticResource AlignHStretchGeometry}"
                                                                            hc:IconElement.Height="10"
                                                                            hc:IconElement.Width="10"
                                                                            hc:VisualElement.HighlightBackground="Transparent"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown" />
                                                                        <!--  删除按钮  -->
                                                                        <Button
                                                                            Grid.Column="1"
                                                                            Padding="2"
                                                                            VerticalAlignment="Stretch"
                                                                            hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                                            hc:IconElement.Height="10"
                                                                            hc:IconElement.Width="10"
                                                                            hc:VisualElement.HighlightBackground="Transparent"
                                                                            hc:VisualElement.HighlightForeground="{DynamicResource PrimaryBrush}"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Command="{s:Action RemoveStageFromPlan}"
                                                                            CommandParameter="{c:Binding DataContext,
                                                                                                         RelativeSource={RelativeSource Self}}"
                                                                            Visibility="{c:Binding 'DataContext.StagePlanRows.Count > 1',
                                                                                                   RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </Grid>

                                        <!--  高级设置区  -->
                                        <StackPanel Visibility="{c:Binding EnableAdvancedSettings}">
                                            <StackPanel>
                                                <CheckBox
                                                    Margin="0,10"
                                                    Content="{DynamicResource TaskQueue.Annihilation.UseCustom}"
                                                    IsChecked="{Binding SelectedFightTask.UseCustomAnnihilation}" />
                                                <ComboBox
                                                    Height="30"
                                                    DisplayMemberPath="Display"
                                                    ItemsSource="{Binding AnnihilationModeList}"
                                                    SelectedValue="{Binding SelectedFightTask.AnnihilationStage}"
                                                    SelectedValuePath="Value"
                                                    Visibility="{c:Binding SelectedFightTask.UseCustomAnnihilation}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,10" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.Fight.DrGrandet}" IsChecked="{Binding SelectedFightTask.IsDrGrandet}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.Fight.DrGrandet.Tip}" />
                                            </StackPanel>
                                            <CheckBox Margin="0,10" IsChecked="{Binding SelectedFightTask.UseExpiringMedicine}">
                                                <TextBlock
                                                    Block.TextAlignment="Left"
                                                    Text="{DynamicResource TaskQueue.Fight.InfiniteExpiringMedicine}"
                                                    TextWrapping="Wrap" />
                                            </CheckBox>
                                            <StackPanel
                                                Margin="0,0,10,0"
                                                Orientation="Horizontal"
                                                Visibility="{c:Binding SelectedFightTask.UseExpiringMedicine}">
                                                <controls:TextBlock Margin="4,0,7.5,0" Text="└" />
                                                <hc:NumericUpDown
                                                    Width="60"
                                                    Height="30"
                                                    HorizontalAlignment="Left"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Maximum="30"
                                                    Minimum="1"
                                                    Value="{Binding SelectedFightTask.MedicineExpireDays, UpdateSourceTrigger=PropertyChanged}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.Fight.MedicineExpireDays.Tip}" />
                                            </StackPanel>
                                            <CheckBox
                                                Margin="0,10"
                                                Content="{DynamicResource TaskQueue.Fight.UseExpireMedicineForActivity}"
                                                IsChecked="{Binding SelectedFightTask.UseExpireMedicineForActivity}" />
                                            <CheckBox
                                                Margin="0,10"
                                                Content="{DynamicResource TaskQueue.Fight.HideSeries}"
                                                IsChecked="{Binding SelectedFightTask.HideSeries}" />
                                            <StackPanel Margin="0,10" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.Fight.AllowUseStoneSave}" IsChecked="{Binding SelectedFightTask.UseStoneAllowSave}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.Fight.AllowUseStoneSave.Tip}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,10" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.CustomStageCode}" IsChecked="{Binding SelectedFightTask.IsStageManually}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.CustomStageCode.Tip}" />
                                            </StackPanel>
                                            <ComboBox
                                                hc:InfoElement.Title="{DynamicResource TaskQueue.Fight.StageResetMode}"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding StageResetModeList}"
                                                SelectedValue="{Binding SelectedFightTask.StageResetMode}"
                                                SelectedValuePath="Value" />
                                            <CheckBox
                                                Margin="0,10"
                                                Content="{DynamicResource TaskQueue.Fight.UseAlternateStage}"
                                                IsChecked="{Binding SandboxUseOptionalStage}" />
                                            <CheckBox
                                                Margin="0,10"
                                                Content="{DynamicResource TaskQueue.Fight.HideUnavailableStage}"
                                                IsChecked="{Binding SelectedFightTask.HideUnavailableStage}"
                                                IsEnabled="{c:Binding !SelectedFightTask.UseWeeklySchedule}" />
                                            <StackPanel Margin="0,10" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.UseWeeklySchedule}" IsChecked="{Binding SelectedFightTask.UseWeeklySchedule}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.UseWeeklySchedule.Tip}" />
                                            </StackPanel>
                                            <ListBox
                                                MaxHeight="300"
                                                Margin="6,5"
                                                HorizontalContentAlignment="Stretch"
                                                ItemsSource="{Binding WeeklyScheduleSource}"
                                                PreviewMouseWheel="{s:Action RouteMouseWheelToParent,
                                                                             Target={x:Type helper:MouseWheelHelper}}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                Style="{DynamicResource NoSelectedHighlightListBoxStyle}"
                                                Visibility="{c:Binding SelectedFightTask.UseWeeklySchedule}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Content="{Binding Display}"
                                                            IsChecked="{Binding Value}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  库存保持沙盒面板：结构照抄真实 DepotMaintainTaskUserControl，仅数据源换到沙盒任务；改真实面板时须同步此处  -->
                                    <StackPanel Visibility="{c:Binding ShowDepotMaintainPanel}">
                                        <StackPanel Visibility="{c:Binding !EnableAdvancedSettings}">
                                            <Viewbox
                                                Margin="0,0,0,5"
                                                HorizontalAlignment="Left"
                                                Stretch="Uniform"
                                                StretchDirection="DownOnly"
                                                Visibility="{c:Binding 'PlanInfo != &quot;&quot;'}">
                                                <controls:TextBlock d:Text="1: 当前/上次 - 不选择 x0" Text="{Binding PlanInfo}" />
                                            </Viewbox>
                                            <!--  固定区：仅操作按钮行；计划摘要随外层面板滚动  -->
                                            <StackPanel x:Name="FixedHeaderPanel">
                                                <WrapPanel Margin="0,6,0,6" HorizontalAlignment="Center">
                                                    <Button
                                                        MinWidth="50"
                                                        Margin="0,0,-1,0"
                                                        hc:BorderElement.CornerRadius="4,0,0,4"
                                                        Command="{s:Action CollapseAll}"
                                                        Content="{DynamicResource Common.CollapseAll}" />
                                                    <Button
                                                        MinWidth="50"
                                                        Margin="0,0,-1,0"
                                                        hc:BorderElement.CornerRadius="0"
                                                        Command="{s:Action ClearPlans}"
                                                        Content="{DynamicResource TaskQueue.DepotMaintain.ClearPlans}" />
                                                    <Button
                                                        MinWidth="50"
                                                        Margin="0,0,-1,0"
                                                        hc:BorderElement.CornerRadius="0"
                                                        Command="{s:Action AddPlan}"
                                                        Content="{DynamicResource TaskQueue.DepotMaintain.AddPlan}" />
                                                    <hc:SplitButton
                                                        hc:BorderElement.CornerRadius="0,4,4,0"
                                                        Click="PresetSplitButton_Click"
                                                        Content="{DynamicResource TaskQueue.DepotMaintain.Preset}">
                                                        <hc:SplitButton.DropDownContent>
                                                            <StackPanel IsVisibleChanged="{s:Action PresetDropDownVisibilityChanged}">
                                                                <StackPanel.Resources>
                                                                    <Style
                                                                        x:Key="PresetMenuItemStyle"
                                                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                        TargetType="MenuItem">
                                                                        <Setter Property="Command" Value="{Binding DataContext.ImportPresetCommand, RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                                                        <Setter Property="CommandParameter" Value="{Binding Value}" />
                                                                        <Setter Property="Header" Value="{Binding Display}" />
                                                                    </Style>
                                                                </StackPanel.Resources>
                                                                <controls:TextBlock
                                                                    Margin="10,4,0,2"
                                                                    HorizontalAlignment="Left"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                                                    Text="{DynamicResource TaskQueue.DepotMaintain.PresetPermanent}"
                                                                    Visibility="{c:Binding 'ActivityPresetList.Count > 0',
                                                                                           Source={x:Static taskQueue_vms:DepotMaintainTaskUserControlModel.Instance}}" />
                                                                <Menu
                                                                    ItemContainerStyle="{StaticResource PresetMenuItemStyle}"
                                                                    ItemsPanel="{StaticResource VerticalStackItemsPanel}"
                                                                    ItemsSource="{Binding PresetList, Source={x:Static taskQueue_vms:DepotMaintainTaskUserControlModel.Instance}}" />
                                                                <StackPanel Visibility="{c:Binding 'ActivityPresetList.Count > 0', Source={x:Static taskQueue_vms:DepotMaintainTaskUserControlModel.Instance}}">
                                                                    <controls:TextBlock
                                                                        Margin="10,4,0,2"
                                                                        HorizontalAlignment="Left"
                                                                        FontWeight="Bold"
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        Text="{DynamicResource TaskQueue.DepotMaintain.PresetCurrentActivity}" />
                                                                    <Menu
                                                                        ItemContainerStyle="{StaticResource PresetMenuItemStyle}"
                                                                        ItemsPanel="{StaticResource VerticalStackItemsPanel}"
                                                                        ItemsSource="{Binding ActivityPresetList, Source={x:Static taskQueue_vms:DepotMaintainTaskUserControlModel.Instance}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </hc:SplitButton.DropDownContent>
                                                    </hc:SplitButton>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!--
                                                外层设置面板的 ScrollViewer 给列表的高度约束无限，
                                                MaxHeight 绑 ｢视口 - 固定区实际高度｣ 建立有界视口，虚拟化方能生效；
                                                固定区随语言换行增高时列表自动收缩，固定区超出视口时列表归零、由外层面板滚动兜底
                                            -->
                                            <ListBox
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                dd:DragDrop.DragDropContext="{Binding RelativeSource={RelativeSource Self}}"
                                                dd:DragDrop.IsDragSource="True"
                                                dd:DragDrop.IsDropTarget="True"
                                                hc:ScrollViewer.IsInertiaEnabled="True"
                                                BorderThickness="0"
                                                ClipToBounds="False"
                                                ItemsSource="{Binding PlanRows}"
                                                PreviewMouseWheel="{s:Action RouteMouseWheelToParentExceptScrollable,
                                                                             Target={x:Type helper:MouseWheelHelper}}"
                                                VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.ScrollUnit="Pixel"
                                                VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.MaxHeight>
                                                    <MultiBinding Converter="{StaticResource SubtractConverter}">
                                                        <Binding Path="ViewportHeight" RelativeSource="{RelativeSource AncestorType=ScrollViewer}" />
                                                        <Binding ElementName="FixedHeaderPanel" Path="ActualHeight" />
                                                    </MultiBinding>
                                                </ListBox.MaxHeight>
                                                <ListBox.ItemContainerStyle>
                                                    <Style BasedOn="{StaticResource NoSelectedHighlightListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="1" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type dialogs_vms:TutorialChallengePlanRow}">
                                                        <Expander HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpanded}">
                                                            <Expander.Header>
                                                                <Grid HorizontalAlignment="Stretch" Background="Transparent">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:TextBlock
                                                                        HorizontalAlignment="Left"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <Button
                                                                        Grid.Column="1"
                                                                        Width="25"
                                                                        Height="25"
                                                                        Margin="0,0,-5,0"
                                                                        Padding="0"
                                                                        hc:IconElement.Geometry="{StaticResource DeleteTaskGeometry}"
                                                                        hc:IconElement.Height="15"
                                                                        hc:IconElement.Width="15"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="0"
                                                                        Command="{s:Action RemovePlan}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{DynamicResource Common.Delete}">
                                                                        <Button.Style>
                                                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                    </Button>
                                                                </Grid>
                                                            </Expander.Header>
                                                            <Border
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1,0,1,1"
                                                                CornerRadius="0,0,4,4">
                                                                <StackPanel Margin="6">
                                                                    <!--  关卡选择  -->
                                                                    <Grid Height="30">
                                                                        <!--  当 IsStageManually 为 false 时显示 ComboBox  -->
                                                                        <ComboBox
                                                                            ItemContainerStyle="{StaticResource StageComboBoxItemStyle}"
                                                                            ItemTemplate="{StaticResource StageComboBoxItemTemplate}"
                                                                            ItemsSource="{Binding DataContext.StageListSource, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                            ScrollViewer.CanContentScroll="False"
                                                                            SelectedValue="{Binding Stage}"
                                                                            SelectedValuePath="Value"
                                                                            Visibility="{c:Binding '!DataContext.SelectedDepotMaintainTask.IsStageManually',
                                                                                                   RelativeSource={RelativeSource AncestorType=hc:Window}}" />

                                                                        <!--  当 IsStageManually 为 true 时显示 TextBox  -->
                                                                        <TextBox
                                                                            Height="30"
                                                                            hc:InfoElement.Placeholder="{DynamicResource TaskQueue.Stage.Label.Default}"
                                                                            IsEnabled="{c:Binding '!DataContext.IsStageItemDragging',
                                                                                                  RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                            Text="{Binding Stage, UpdateSourceTrigger=PropertyChanged}"
                                                                            ToolTip="{DynamicResource TaskQueue.CustomStageCode.Tip}"
                                                                            Visibility="{c:Binding 'DataContext.SelectedDepotMaintainTask.IsStageManually',
                                                                                                   RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                                                    </Grid>

                                                                    <!--  指定材料 + 目标库存（同一行，独立 Grid）  -->
                                                                    <Grid Margin="0,6,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Grid.Column="0">
                                                                            <ComboBox
                                                                                Height="30"
                                                                                Margin="0,0,6,0"
                                                                                Padding="28,5,10,5"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                VerticalContentAlignment="Center"
                                                                                s:View.ActionTarget="{Binding}"
                                                                                DropDownClosed="{s:Action DropsListDropDownClosed}"
                                                                                IsEditable="True"
                                                                                IsTextSearchEnabled="False"
                                                                                ItemTemplate="{StaticResource DropComboBoxItemTemplate}"
                                                                                ItemsSource="{Binding DataContext.DropsList, RelativeSource={RelativeSource AncestorType=hc:Window}}"
                                                                                Loaded="{s:Action MakeComboBoxSearchable,
                                                                                                  Target={x:Type ui_vms:SettingsViewModel}}"
                                                                                SelectedValue="{Binding DropId}"
                                                                                SelectedValuePath="Value"
                                                                                Text="{Binding DropName}" />
                                                                            <!--  选中材料缩略图：IsEditable ComboBox 收起态显示区是纯文本 TextBox 无法内嵌图片，以不命中浮层贴在框内左侧，ComboBox 用 Padding 为其让出文本起点；｢不选择｣ 无图标，同位以描边圆环占位  -->
                                                                            <Ellipse
                                                                                Width="16"
                                                                                Height="16"
                                                                                Margin="7,0,0,0"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                IsHitTestVisible="False"
                                                                                Stroke="{DynamicResource BorderBrush}"
                                                                                StrokeThickness="1"
                                                                                Visibility="{c:Binding 'DropId.Length == 0'}" />
                                                                            <Image
                                                                                Width="16"
                                                                                Height="16"
                                                                                Margin="6,0,0,0"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                IsHitTestVisible="False"
                                                                                Source="{Binding DropId, Converter={StaticResource ItemImageConverter}}" />
                                                                        </Grid>
                                                                        <hc:NumericUpDown
                                                                            Grid.Column="1"
                                                                            Height="30"
                                                                            MinWidth="70"
                                                                            MaxWidth="110"
                                                                            Maximum="1145141919"
                                                                            Minimum="0"
                                                                            Value="{Binding DropCount, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>

                                                                    <!--  使用药剂  -->
                                                                    <Grid Margin="0,6,0,0" Visibility="{c:Binding 'DataContext.SelectedDepotMaintainTask.UseMedicine', RelativeSource={RelativeSource AncestorType=hc:Window}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <CheckBox
                                                                                MaxWidth="110"
                                                                                VerticalAlignment="Center"
                                                                                IsChecked="{Binding UseMedicine}">
                                                                                <TextBlock Text="{DynamicResource TaskQueue.Fight.UseSanityPotion}" TextWrapping="Wrap" />
                                                                            </CheckBox>
                                                                            <controls:TooltipBlock
                                                                                Margin="3,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                TooltipText="{DynamicResource TaskQueue.DepotMaintain.PlanBudget.Tip}" />
                                                                        </StackPanel>
                                                                        <hc:NumericUpDown
                                                                            Grid.Column="1"
                                                                            Width="70"
                                                                            Height="30"
                                                                            Margin="6,0,0,0"
                                                                            Maximum="999"
                                                                            Minimum="0"
                                                                            Value="{Binding MedicineCount, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>

                                                                    <!--  使用源石  -->
                                                                    <Grid Margin="0,6,0,0" Visibility="{c:Binding 'DataContext.SelectedDepotMaintainTask.UseStone', RelativeSource={RelativeSource AncestorType=hc:Window}}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                            <CheckBox
                                                                                MaxWidth="110"
                                                                                VerticalAlignment="Center"
                                                                                IsChecked="{Binding UseStone}">
                                                                                <TextBlock Text="{DynamicResource TaskQueue.Fight.UseOriginitePrime}" TextWrapping="Wrap" />
                                                                            </CheckBox>
                                                                            <controls:TooltipBlock
                                                                                Margin="3,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                TooltipText="{DynamicResource TaskQueue.DepotMaintain.PlanBudget.Tip}" />
                                                                        </StackPanel>
                                                                        <hc:NumericUpDown
                                                                            Grid.Column="1"
                                                                            Width="70"
                                                                            Height="30"
                                                                            Margin="6,0,0,0"
                                                                            Maximum="999"
                                                                            Minimum="0"
                                                                            Value="{Binding StoneCount, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <!--  高级设置区  -->
                                        <StackPanel Visibility="{c:Binding EnableAdvancedSettings}">
                                            <hc:Divider Content="{DynamicResource TaskQueue.DepotMaintain.GroupTaskBehavior}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.UpdateBeforeStart}" IsChecked="{Binding SelectedDepotMaintainTask.UpdateDepot}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.UpdateBeforeStart.Tip}" />
                                            </StackPanel>
                                            <CheckBox
                                                Margin="0,6,0,0"
                                                Content="{DynamicResource TaskQueue.DepotMaintain.SkipDuringActivity}"
                                                IsChecked="{Binding SelectedDepotMaintainTask.SkipDuringActivity}" />
                                            <CheckBox
                                                Margin="0,6,0,0"
                                                Content="{DynamicResource TaskQueue.DepotMaintain.SkipDuringResourceCollection}"
                                                IsChecked="{Binding SelectedDepotMaintainTask.SkipDuringResourceCollection}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.OnlyFirstInsufficientPlan}" IsChecked="{Binding SelectedDepotMaintainTask.OnlyFirstInsufficientPlan}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.OnlyFirstInsufficientPlan.Tip}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.SortByProgress}" IsChecked="{Binding SelectedDepotMaintainTask.SortByProgress}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.SortByProgress.Tip}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.CountDualChipAsChipPack}" IsChecked="{Binding SelectedDepotMaintainTask.CountDualChipAsChipPack}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.CountDualChipAsChipPack.Tip}" />
                                            </StackPanel>

                                            <hc:Divider Margin="0,12,0,0" Content="{DynamicResource TaskQueue.DepotMaintain.GroupStageAndBattle}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.CustomStageCode}" IsChecked="{Binding SelectedDepotMaintainTask.IsStageManually}" />
                                                <controls:TooltipBlock TooltipText="{DynamicResource TaskQueue.CustomStageCode.Tip}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.UseAutoSeries}" IsChecked="{Binding SelectedDepotMaintainTask.UseAutoSeries}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.UseAutoSeries.Tip}" />
                                            </StackPanel>

                                            <hc:Divider Margin="0,12,0,0" Content="{DynamicResource TaskQueue.DepotMaintain.GroupSanityRecovery}" />
                                            <CheckBox
                                                Margin="0,6,0,0"
                                                Content="{DynamicResource TaskQueue.DepotMaintain.EnableUseMedicine}"
                                                IsChecked="{Binding SelectedDepotMaintainTask.UseMedicine}" />
                                            <CheckBox
                                                Margin="0,6,0,0"
                                                Content="{DynamicResource TaskQueue.DepotMaintain.EnableUseStone}"
                                                IsChecked="{Binding SelectedDepotMaintainTask.UseStone}" />
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource TaskQueue.DepotMaintain.UseExpiringMedicine}" IsChecked="{Binding SelectedDepotMaintainTask.UseExpiringMedicine}" />
                                                <controls:TooltipBlock Margin="3,0,0,0" TooltipText="{DynamicResource TaskQueue.DepotMaintain.UseExpiringMedicine.Tip}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  公招沙盒面板：仅保留 ｢保留指定词条｣ 簇，结构取自真实 RecruitTaskUserControl 高级区；改真实面板时须同步此处  -->
                                    <StackPanel Visibility="{c:Binding ShowRecruitPanel}">
                                        <StackPanel Margin="0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="{DynamicResource Recruit.PreserveTags}" IsChecked="{Binding SandboxPreserveTagEnabled}" />
                                                <controls:TooltipBlock
                                                    Margin="0,0,5,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    TooltipText="{DynamicResource Recruit.PreserveTags.Tip}" />
                                            </StackPanel>
                                            <hc:CheckComboBox
                                                Margin="0,10,0,0"
                                                hc:ListBoxAttach.SelectedItems="{Binding AutoRecruitPreserveTagList}"
                                                DisplayMemberPath="Display"
                                                ItemsSource="{Binding AutoRecruitSkipTagShowList}"
                                                SelectionMode="Multiple"
                                                Visibility="{c:Binding SandboxPreserveTagEnabled}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </hc:ScrollViewer>
                            <hc:ButtonGroup
                                Grid.Row="2"
                                Margin="8,0,8,8"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <RadioButton
                                    hc:BorderElement.CornerRadius="4,0,0,4"
                                    hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                    AutomationProperties.Name="{DynamicResource TaskQueue.GeneralSettings}"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    Content="{DynamicResource TaskQueue.GeneralSettings}"
                                    GroupName="TutorialChallengeSettingsTab"
                                    IsChecked="{c:Binding !EnableAdvancedSettings}" />
                                <RadioButton
                                    hc:VisualElement.HighlightBackground="{DynamicResource RegionBrushOpacity25}"
                                    AutomationProperties.Name="{DynamicResource TaskQueue.AdvancedSettings}"
                                    Background="{DynamicResource RegionBrushOpacity25}"
                                    Content="{DynamicResource TaskQueue.AdvancedSettings}"
                                    GroupName="TutorialChallengeSettingsTab"
                                    IsChecked="{Binding EnableAdvancedSettings}" />
                            </hc:ButtonGroup>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!--  设置页：结构对齐真实 SettingsView（搜索框 + 分区导航 + 分区内容），数据仅沙盒内；仅声明了 Settings 场景的关卡显示本页签  -->
            <TabItem
                Header="{DynamicResource Settings.Title}"
                Style="{StaticResource TabItemInLine}"
                Visibility="{c:Binding ShowSettingsPanel}">
                <Grid Margin="8,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左侧导航栏（搜索 + 分区列表 + 高级开关），骨架对齐真实设置页  -->
                    <Grid Grid.Column="0" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <hc:SearchBar
                            Grid.Row="0"
                            hc:BorderElement.CornerRadius="4,4,0,0"
                            Text="{Binding SettingsSearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <ListBox
                            Grid.Row="1"
                            hc:BorderElement.CornerRadius="0"
                            BorderThickness="1,0,1,1"
                            DisplayMemberPath="Display"
                            IsSynchronizedWithCurrentItem="true"
                            ItemsSource="{Binding Source={StaticResource SandboxSettingsNavigation}}"
                            ScrollViewer.CanContentScroll="False"
                            SelectedIndex="{Binding SelectedIndex}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel>
                                                            <ContentPresenter x:Name="PART_Header" />
                                                            <ItemsPresenter x:Name="ItemsPresenter" Margin="0" />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Visibility="{c:Binding Name}">
                                                <hc:Divider Content="{DynamicResource Settings.Advanced.Title}" Visibility="{c:Binding DataContext.HasVisibleAdvancedSettings, RelativeSource={RelativeSource AncestorType=hc:Window}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style BasedOn="{StaticResource TransparentListBoxItemStyle}" TargetType="ListBoxItem">
                                    <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            hc:BorderElement.CornerRadius="0,0,4,4"
                            BorderThickness="1,0,1,1"
                            Command="{s:Action ToggleAdvancedSettings}">
                            <Grid>
                                <TextBlock
                                    Text="{DynamicResource Settings.Advanced.Show}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{c:Binding !ShowAdvancedSettings}" />
                                <TextBlock
                                    Text="{DynamicResource Settings.Advanced.Hide}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{c:Binding ShowAdvancedSettings}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!--
                        右侧分区内容：结构对齐真实设置页——分区容器是内容 Grid 的直接子元素（由 code-behind 按 SandboxSettingSections 动态生成），
                        顶部预留高级分隔条行；未命中搜索或未展开高级分区整体折叠
                    -->
                    <hc:ScrollViewer
                        x:Name="SandboxSettingsScrollViewer"
                        Grid.Column="1"
                        Margin="20,0,5,5"
                        HorizontalAlignment="Stretch"
                        properties:ScrollViewerBinding.DividerVerticalOffsetList="{Binding DividerVerticalOffsetList}"
                        properties:ScrollViewerBinding.ExtentHeight="{Binding ScrollExtentHeight}"
                        properties:ScrollViewerBinding.SmoothScrollTo="{Binding ScrollAnimationTarget}"
                        properties:ScrollViewerBinding.VerticalOffset="{Binding ScrollOffset}"
                        properties:ScrollViewerBinding.ViewportHeight="{Binding ScrollViewportHeight}"
                        properties:SearchHighlightBehavior.SearchText="{Binding SettingsSearchText}"
                        properties:SearchHighlightBehavior.SectionFilter="{Binding SandboxSettingSections}"
                        IsInertiaEnabled="True"
                        PanningMode="Both">
                        <Grid x:Name="SandboxSettingsContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <hc:Divider
                                x:Name="SandboxAdvancedDivider"
                                Grid.Row="{Binding AdvancedSettingsDividerRow}"
                                Margin="0,15,0,10"
                                Content="{DynamicResource Settings.Advanced.Title}"
                                Visibility="{c:Binding HasVisibleAdvancedSettings}" />
                        </Grid>
                    </hc:ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,0,0,5" hc:Growl.Token="TutorialChallenge" />
        </ScrollViewer>
    </Grid>
</hc:Window>
