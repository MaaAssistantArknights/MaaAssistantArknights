<hc:Window
    x:Class="MaaWpfGui.Views.Dialogs.TutorialChallengeLevelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs_vms="clr-namespace:MaaWpfGui.ViewModels.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    Title="{Binding WindowTitle}"
    Width="800"
    Height="560"
    MinWidth="800"
    MinHeight="560"
    d:DataContext="{d:DesignInstance {x:Type dialogs_vms:TutorialChallengeLevelViewModel}}"
    s:View.ActionTarget="{Binding}"
    AllowDrop="True"
    Background="{DynamicResource RegionBrush}"
    PreviewDragOver="{s:Action SandboxPackagePreviewDragOver}"
    PreviewDrop="{s:Action SandboxPackageDrop}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  目标区：关卡目标描述与达成状态  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <controls:TextBlock
                    HorizontalAlignment="Left"
                    FontSize="16"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="{Binding Title}" />
                <controls:TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Text="{Binding Goal}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Padding="8,3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="4"
                    Visibility="{c:Binding IsCompleted,
                                           FalseToVisibility=Hidden}">
                    <controls:TextBlock Foreground="{DynamicResource TextIconBrush}" Text="{DynamicResource Toolbox.TutorialChallenge.Completed}" />
                </Border>
                <Button
                    Margin="8,0,0,0"
                    Command="{s:Action Reset}"
                    Content="{DynamicResource Toolbox.TutorialChallenge.Reset}" />
            </StackPanel>
        </Grid>

        <TabControl
            x:Name="SandboxTabs"
            Grid.Row="1"
            Background="{DynamicResource RegionBrushOpacity25}"
            BorderThickness="0,1,0,0"
            SelectedIndex="{Binding SelectedTab}"
            Style="{StaticResource TabControlInLine}"
            Visibility="{c:Binding HasItems,
                                   RelativeSource={RelativeSource Self}}">
            <TabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource TabItemInLine}" TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource RegionBrushOpacity25}" />
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>

        <!--  更新包投放区：仅 ｢拖拽更新｣ 关卡显示，整窗任意位置均可拖入；独立于 TabControl（该关无任务/设置页），描边框仅作状态清单展示，下方三项识别状态  -->
        <Border
            Grid.Row="1"
            Margin="8,8,8,0"
            Padding="10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="{c:Binding ShowDropZonePanel}">
            <StackPanel>
                <controls:TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{DynamicResource Toolbox.TutorialChallenge.Level.DragDropUpdate.DropZone.Tip}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <!--  三项识别状态清单：识别成功后勾选，未识别为灰色未勾态；只读展示，不可交互  -->
                <StackPanel Margin="0,8,0,0">
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding FullPackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource Toolbox.TutorialChallenge.Level.DragDropUpdate.DropZone.FullPackage}" />
                    </CheckBox>
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding OtaPackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource Toolbox.TutorialChallenge.Level.DragDropUpdate.DropZone.OtaPackage}" />
                    </CheckBox>
                    <CheckBox
                        Margin="0,2"
                        Focusable="False"
                        IsChecked="{Binding ResourcePackageIdentified, Mode=OneWay}"
                        IsHitTestVisible="False">
                        <controls:TextBlock Text="{DynamicResource Toolbox.TutorialChallenge.Level.DragDropUpdate.DropZone.ResourcePackage}" />
                    </CheckBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <hc:ScrollViewer
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsInertiaEnabled="True"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel
                x:Name="TutorialGrowlPanel"
                Margin="0,0,0,5"
                hc:Growl.Token="TutorialChallenge" />
        </hc:ScrollViewer>
    </Grid>
</hc:Window>
