<hc:Window
    x:Class="MaaWpfGui.Views.Dialogs.WeComBotAccountEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:vms="clr-namespace:MaaWpfGui.ViewModels.Dialogs"
    Title="{Binding DisplayName}"
    Width="500"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance {x:Type vms:WeComBotAccountEditorViewModel}}"
    mc:Ignorable="d">
    <StackPanel Margin="16">
        <controls:TextBlock
            Margin="0,0,0,8"
            FontSize="12"
            Text="{DynamicResource WeComBotAccountEditorTip}"
            TextWrapping="Wrap" />
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:TextBlock
                Grid.Row="0"
                VerticalAlignment="Center"
                Text="{DynamicResource AccountSwitch}" />
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,2"
                Orientation="Horizontal">
                <TextBox Width="120" Text="{Binding AccountSwitchName, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource WeComBotAccountSwitchEnabled}"
                    IsChecked="{Binding AccountSwitchEnabled}" />
            </StackPanel>
            <controls:TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Text="{DynamicResource CustomStageCode}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,2"
                Text="{Binding Stage, UpdateSourceTrigger=PropertyChanged}" />
            <controls:TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Text="{DynamicResource WeComBotUseMedicine}" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal">
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding UseMedicine}" />
                <controls:TextBlock
                    Margin="16,0,6,0"
                    VerticalAlignment="Center"
                    Text="{DynamicResource WeComBotMedicineCount}" />
                <TextBox Width="80" Text="{Binding MedicineCount, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <controls:TextBlock
            Margin="0,10,0,4"
            FontWeight="Bold"
            Text="{DynamicResource WeComBotEditAccount}" />
        <WrapPanel Margin="0,0,0,8">
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Fight}" IsChecked="{Binding FightEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Infrast}" IsChecked="{Binding InfrastEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Recruit}" IsChecked="{Binding RecruitEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Mall}" IsChecked="{Binding MallEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Award}" IsChecked="{Binding AwardEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource UserDataUpdate}" IsChecked="{Binding UserDataUpdateEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Roguelike}" IsChecked="{Binding RoguelikeEnabled}" />
            <CheckBox Margin="0,4,16,4" Content="{DynamicResource Reclamation}" IsChecked="{Binding ReclamationEnabled}" />
        </WrapPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                MinWidth="90"
                Margin="0,0,10,0"
                Command="{s:Action OpenFullSettings}"
                Content="{DynamicResource WeComBotOpenFullSettings}" />
            <Button
                MinWidth="80"
                Margin="0,0,10,0"
                Command="{s:Action Save}"
                Content="{DynamicResource Confirm}" />
            <Button MinWidth="80" Command="{s:Action Cancel}" Content="{DynamicResource Cancel}" />
        </StackPanel>
    </StackPanel>
</hc:Window>
