<UserControl
    x:Class="MaaWpfGui.Views.UI.NotifyIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <hc:NotifyIcon
        Name="notifyIcon"
        Text="MaaAssistantArknights"
        Token="Maa.Icon"
        Visibility="Visible">
        <hc:NotifyIcon.ContextMenu>
            <!--  Header 经 MaaMenuItemDefaultStyle 的 HeaderTemplate 统一渲染为左对齐 TextBlock  -->
            <ContextMenu ItemContainerStyle="{StaticResource MaaMenuItemDefaultStyle}">
                <MenuItem Name="startMenu" Header="{DynamicResource TaskQueue.Farming}" />
                <MenuItem Name="stopMenu" Header="{DynamicResource Common.Stop}" />
                <MenuItem Name="switchLangMenu" Header="{DynamicResource Tray.SwitchLanguage}" />
                <MenuItem Name="forceShowMenu" Header="{DynamicResource Tray.ForceShow}" />
                <MenuItem Name="hideTrayMenu" Header="{DynamicResource Tray.Hide}" />
                <MenuItem Name="toggleOverlayMenu" Header="{DynamicResource Logging.Overlay.Toggle}" />
                <MenuItem Name="restartMenu" Header="{DynamicResource Tray.Restart}" />
                <MenuItem Name="exitMenu" Header="{DynamicResource Tray.Exit}" />
            </ContextMenu>
        </hc:NotifyIcon.ContextMenu>
    </hc:NotifyIcon>
</UserControl>
