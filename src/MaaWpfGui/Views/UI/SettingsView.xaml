<UserControl
    x:Class="MaaWpfGui.Views.UI.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:MaaWpfGui.Styles.Properties"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:settings="clr-namespace:MaaWpfGui.Views.UserControl.Settings"
    xmlns:ui_vms="clr-namespace:MaaWpfGui.ViewModels.UI"
    d:Background="White"
    d:DataContext="{d:DesignInstance {x:Type ui_vms:SettingsViewModel}}"
    d:DesignHeight="5000"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource x:Key="SettingsNavigation" Source="{Binding Settings}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="IsAdvanced" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="20,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧导航栏（搜索 + 分区列表）  -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <hc:SearchBar
                x:Name="SettingsSearchBar"
                Grid.Row="0"
                hc:BorderElement.CornerRadius="4,4,0,0"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <controls:NailongMascot
                Width="108"
                Height="104"
                Margin="0,8,0,0"
                DockPanel.Dock="Bottom"
                ShowCaptions="False"
                Visibility="{DynamicResource Skin.DecorationVisibility}" />

            <ListBox
                x:Name="MasterListBox"
                Grid.Row="1"
                dd:DragDrop.DropHandler="{Binding SettingsDropHandler}"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                hc:BorderElement.CornerRadius="0"
                BorderThickness="1,0,1,1"
                DisplayMemberPath="Display"
                IsSynchronizedWithCurrentItem="true"
                ItemsSource="{Binding Source={StaticResource SettingsNavigation}}"
                ScrollViewer.CanContentScroll="False"
                SelectedIndex="{Binding SelectedIndex}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel>
                                                <ContentPresenter x:Name="PART_Header" />
                                                <ItemsPresenter x:Name="ItemsPresenter" Margin="0" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Visibility="{c:Binding Name}">
                                    <hc:Divider Content="{DynamicResource Settings.Advanced.Title}" Visibility="{c:Binding DataContext.HasVisibleAdvancedSettings, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource TransparentListBoxItemStyle}" TargetType="ListBoxItem">
                        <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                hc:BorderElement.CornerRadius="0,0,4,4"
                BorderThickness="1,0,1,1"
                Command="{s:Action ToggleAdvancedSettings}">
                <Grid>
                    <TextBlock
                        Text="{DynamicResource Settings.Advanced.Show}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{c:Binding !ShowAdvancedSettings}" />
                    <TextBlock
                        Text="{DynamicResource Settings.Advanced.Hide}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{c:Binding ShowAdvancedSettings}" />
                </Grid>
            </Button>
        </Grid>

        <hc:ScrollViewer
            x:Name="SettingsScrollViewer"
            Grid.Column="1"
            Margin="20,0,20,5"
            HorizontalAlignment="Stretch"
            properties:ScrollViewerBinding.DividerVerticalOffsetList="{Binding DividerVerticalOffsetList}"
            properties:ScrollViewerBinding.ExtentHeight="{Binding ScrollExtentHeight}"
            properties:ScrollViewerBinding.SmoothScrollTo="{Binding ScrollAnimationTarget}"
            properties:ScrollViewerBinding.VerticalOffset="{Binding ScrollOffset}"
            properties:ScrollViewerBinding.ViewportHeight="{Binding ScrollViewportHeight}"
            properties:SearchHighlightBehavior.SearchText="{Binding SearchText}"
            properties:SearchHighlightBehavior.SectionFilter="{Binding Settings}"
            IsInertiaEnabled="True"
            PanningMode="Both">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <hc:Divider
                    Grid.Row="{Binding AdvancedSettingsDividerRow}"
                    Margin="0,15,0,10"
                    Content="{DynamicResource Settings.Advanced.Title}"
                    Visibility="{c:Binding HasVisibleAdvancedSettings}" />

                <Grid
                    Grid.Row="{Binding SwitchConfigurationSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="0"
                    Visibility="{c:Binding SwitchConfigurationSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding SwitchConfigurationSetting.Display}"
                        IsExpanded="{Binding IsSwitchConfigurationExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:ConfigurationMgrUserControl Margin="0,20" HorizontalAlignment="Center" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding ScheduleSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="1"
                    Visibility="{c:Binding ScheduleSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding ScheduleSettingsSetting.Display}"
                        IsExpanded="{Binding IsScheduleSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:TimerSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding TimerSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding PerformanceSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="2"
                    Visibility="{c:Binding PerformanceSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding PerformanceSettingsSetting.Display}"
                        IsExpanded="{Binding IsPerformanceSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:PerformanceUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding PerformanceSettings}"
                                IsEnabled="{Binding DataContext.Run.Idle, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding GameSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="3"
                    Visibility="{c:Binding GameSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding GameSettingsSetting.Display}"
                        IsExpanded="{Binding IsGameSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:GameSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding GameSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding ConnectionSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="4"
                    Visibility="{c:Binding ConnectionSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding ConnectionSettingsSetting.Display}"
                        IsExpanded="{Binding IsConnectionSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:ConnectSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding ConnectSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding StartupSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="5"
                    Visibility="{c:Binding StartupSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding StartupSettingsSetting.Display}"
                        IsExpanded="{Binding IsStartupSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:StartSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding StartSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding RemoteControlSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="6"
                    Visibility="{c:Binding RemoteControlSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding RemoteControlSettingsSetting.Display}"
                        IsExpanded="{Binding IsRemoteControlSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:RemoteControlUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding RemoteControlSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding UiSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="7"
                    Visibility="{c:Binding UiSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding UiSettingsSetting.Display}"
                        IsExpanded="{Binding IsUiSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:GuiSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding GuiSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding NotificationSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="8"
                    Visibility="{c:Binding NotificationSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding NotificationSettingsSetting.Display}"
                        IsExpanded="{Binding IsNotificationSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <!--  外部通知渠道并入通知设置聚合展示  -->
                            <StackPanel HorizontalAlignment="Center">
                                <settings:NotificationSettingsUserControl
                                    Margin="0,10"
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding NotificationSettings}" />
                                <hc:Divider Margin="10,0" Content="{DynamicResource ExternalNotification.Title}" />
                                <settings:ExternalNotificationSettingsUserControl
                                    Margin="0,10"
                                    HorizontalAlignment="Center"
                                    DataContext="{Binding ExternalNotificationSettings}" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding ThirdPartyServiceSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="9"
                    Visibility="{c:Binding ThirdPartyServiceSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding ThirdPartyServiceSettingsSetting.Display}"
                        IsExpanded="{Binding IsThirdPartyServiceSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:ThirdPartyServiceSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding ThirdPartyServiceSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding HotKeySettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="10"
                    Visibility="{c:Binding HotKeySettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding HotKeySettingsSetting.Display}"
                        IsExpanded="{Binding IsHotKeySettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:HotKeySettingsUserControl Margin="0,20" HorizontalAlignment="Center" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding AchievementSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="11"
                    Visibility="{c:Binding AchievementSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding AchievementSettingsSetting.Display}"
                        IsExpanded="{Binding IsAchievementSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:AchievementSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding AchievementSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding UpdateSettingsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="12"
                    Visibility="{c:Binding UpdateSettingsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding UpdateSettingsSetting.Display}"
                        IsExpanded="{Binding IsUpdateSettingsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:VersionUpdateSettingsUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding VersionUpdateSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding IssueReportSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="13"
                    Visibility="{c:Binding IssueReportSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding IssueReportSetting.Display}"
                        IsExpanded="{Binding IsIssueReportExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:IssueReportUserControl
                                Margin="0,20"
                                HorizontalAlignment="Center"
                                DataContext="{Binding IssueReportSettings}" />
                        </Border>
                    </Expander>
                </Grid>

                <Grid
                    Grid.Row="{Binding AboutUsSetting.GridRow}"
                    Margin="0,5,0,0"
                    d:Grid.Row="14"
                    Visibility="{c:Binding AboutUsSetting.IsVisible}">
                    <Expander
                        d:IsExpanded="True"
                        Background="Transparent"
                        Header="{Binding AboutUsSetting.Display}"
                        IsExpanded="{Binding IsAboutUsExpanded}">
                        <Border
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,1,1"
                            CornerRadius="0,0,4,4">
                            <settings:AboutUserControl Margin="0,20" HorizontalAlignment="Center" />
                        </Border>
                    </Expander>
                </Grid>
                <!--<Rectangle HorizontalAlignment="Stretch" Fill="{DynamicResource BorderBrush}" Height="1" />-->
            </Grid>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
