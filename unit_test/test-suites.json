{
  "runAllOnChanges": [
    "unit_test/CMakeLists.txt",
    "unit_test/test-suites.json",
    ".github/workflows/unit-tests.yml"
  ],
  "suites": [
    {
      "id": "maa-algorithm-test",
      "name": "Algorithm",
      "buildTarget": "maa-algorithm-test",
      "ctestRegex": "^algorithm::",
      "paths": [
        "src/MaaCore/Utils/Algorithm.hpp",
        "unit_test/MaaCore/AlgorithmTest.cpp"
      ]
    },
    {
      "id": "maa-operator-development-test",
      "name": "Operator Development Plan",
      "buildTarget": "maa-operator-development-test",
      "ctestRegex": "^operator-development::",
      "paths": [
        "src/MaaCore/Task/OperatorDevelopment/OperatorDevelopmentPlan.h",
        "src/MaaCore/Task/OperatorDevelopment/OperatorDevelopmentPlanParser.h",
        "unit_test/MaaCore/OperatorDevelopmentPlanTest.cpp"
      ]
    }
  ]
}
